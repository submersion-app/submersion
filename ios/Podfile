# Minimum iOS version for the app.
#
# Must match IPHONEOS_DEPLOYMENT_TARGET in Runner.xcodeproj: that is the value
# stamped into the shipped binary and the one App Store validation reads.
#
# Local plugin podspecs only need to stay compatible, not identical. A podspec
# may declare a LOWER floor -- submersion_ocr and submersion_transcoder sit at
# 13.0 deliberately, and flutter_additional_ios_build_settings raises every pod
# target to the app floor at build time. None may declare a HIGHER floor than
# the app, or pod install fails outright.
#
# 15.0: App Store Connect rejects uploads with a MinimumOSVersion below 15.0
#   starting Spring 2027 (ITMS-90068).
# Never below 14.0: CNAuthorizationStatusLimited (contacts permission) needs it.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Move .xcprivacy files from Compile Sources to Copy Bundle Resources.
    # Some podspecs place these in source_files, which puts them in the compile
    # phase where Xcode has no processing rule for text.xml files.
    if target.respond_to?(:source_build_phase)
      target.source_build_phase.files.to_a.each do |build_file|
        if build_file.file_ref&.path&.end_with?('.xcprivacy')
          target.source_build_phase.remove_build_file(build_file)
          target.resources_build_phase.add_file_reference(build_file.file_ref)
        end
      end
    end

    # Enable permission_handler permissions for iOS
    # See: https://pub.dev/packages/permission_handler#setup
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        # Bluetooth permissions (required for dive computer connectivity)
        'PERMISSION_BLUETOOTH=1',
        # Location permissions (for dive site GPS)
        'PERMISSION_LOCATION=1',
        'PERMISSION_LOCATION_WHENINUSE=1',
        'PERMISSION_LOCATION_ALWAYS=1',
        # Camera permission (for dive photos)
        'PERMISSION_CAMERA=1',
        # Photo library permissions (for dive photos)
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=1',
        # Contacts permission (for dive buddies)
        'PERMISSION_CONTACTS=1',
      ]
    end
  end
end
