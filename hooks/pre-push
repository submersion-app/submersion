#!/bin/bash

# Pre-push hook for Submersion
# Runs dart format check, flutter analyze, a generated-l10n staleness check, and
# a SCOPED test run before pushing.
#
# Why scoped tests: the full suite is over 6,000 test files (1,900 when this
# was measured). Measured on the full suite, 79% of local test wall-clock is `loading <file>` (isolate spawn +
# Flutter binding + kernel load) rather than executing tests: 4824s of load
# against 1300s of actual test cases, averaging 2.55s of overhead per file to
# run ~0.7s of work. Selecting fewer FILES is therefore the only lever that
# matters locally. CI already runs the ENTIRE suite across 8 parallel shards on
# every push (see .github/workflows/ci.yaml), so the local gate does not need to
# duplicate that; it exists to catch obvious breakage fast.
#
# Selection tiers, highest signal first. The first two are never trimmed (they
# peaked at 29 and 32 files across the last 25 merged PRs):
#   1. changed *_test.dart files, and tests importing a changed test helper
#   2. the mirrored test for each changed lib file (lib/x/y.dart ->
#      test/x/y_test.dart)
#   3. tests importing a changed lib file FROM THE SAME FEATURE AREA, compared
#      on the first 3 path segments (lib/features/a/b/c.dart matches
#      test/features/a/b/**)
#   4. tests importing TWO OR MORE changed lib files, wherever they live. This
#      signal is orthogonal to proximity and rescues cross-feature dependents
#      that tier 3 would drop.
#   5. repo-wide guards: tests that read a whole source tree from disk rather
#      than importing it, so no import tier can see that a new file breaks
#      one. Left to CI, they turned main red after green pushes (issue
#      #2611). A guard declares the path prefixes it reads with a comment
#      line, one or more prefixes separated by spaces:
#        // pre-push: scans lib/            any change under lib/
#        // pre-push: scans lib/l10n/arb/   only an ARB change
#      and runs when the push changes a file under one of them. Everything
#      in test/architecture/ is implicitly "scans lib/". So an ARB-only edit
#      runs the ARB checks, and a test-only edit runs only the guards that
#      read test/. Measured on an 18-core Mac at -j 16: the 21
#      architecture files take 38s warm on their own. Bundled into one
#      isolate they took longer (1m56s, run serially), so they run as
#      separate files.
# Distant single-hit importers are left to CI. Measured against the last 25
# merged PRs this cuts nothing off already-cheap pushes (0-29% on selections
# under 60 files) and 74-100% off the expensive ones.
#
# The hub exception: a changed file imported by more than HUB_THRESHOLD test
# files (default 100) is a hub, and the tiers above assume it is not. In
# October 2026 database.dart had 952 test importers, settings_providers.dart
# 874 and test/helpers/mock_providers.dart 740. A push changing a table, a
# settings provider and the mocks kept every helper importer (tier 1), all of
# test/core/database/ (tier 3, since a table change counts as database.dart)
# and every test that imported two of the hubs (tier 4): 1,192 of 4,598 files
# (issue #3129). So a hub's importers neither qualify through tiers 1, 3 and 4
# nor count as a hit there. They go into one shared pool, sampled (HUB_SAMPLE,
# default 40) the same seeded way as the l10n importers below, drawing the
# importers in the same feature area as the change first. Tests that also
# import ordinary changed files are still ranked on those.
#
# The l10n exception: lib/l10n/arb/app_localizations*.dart is GENERATED by
# `flutter gen-l10n` and imported by 378 test files, which is what made half of
# all pushes run 380+ files for what is usually a string edit. A removed or
# renamed key is a compile error `flutter analyze` already catches in ~23s, but
# a changed string VALUE can still break a `find.text(...)` assertion, so its
# importers are sampled (L10N_SAMPLE, default 40) rather than dropped. The
# sample is seeded on the pushed sha: stable for a given commit so a failure
# reproduces, but rotating across commits so coverage accumulates.
#
# A selection of 100 files or more runs BUNDLED (issue #4117): the hook writes
# it to a list file and runs scripts/run_all_tests.sh with TEST_FILES_FROM,
# which packs the files into generated entrypoints, at least one per worker, so
# the isolate start-up and kernel load is paid per bundle rather than per file.
# Smaller selections stay separate files, because bundling gains nothing there
# and a bundle shares its isolate. The gain depends on what is selected, since
# database and migration tests stay slow however they load. Measured at -j 16 on
# an 18-core Mac with other sessions running:
#   86 files, a push          56-69s separate, 62-67s as 19 bundles
#   424 files, a real push    293s separate, 268s as 31 bundles (load 28)
#                             821s separate, 604s as 31 bundles (load 55)
#   522 files, an even sample 334-393s separate, 110-138s as 33 bundles
# A bundled run gets a 5-minute test limit (BUNDLED_TEST_TIMEOUT below). A branch
# whose run_all_tests.sh predates TEST_FILES_FROM keeps separate files.
#
# The time budget (issue #4117): the selection has no natural ceiling. After a
# merge from main, or a change to a hub file, it has run for over an hour, and
# the only remedy was SKIP_TESTS=1 on a hunch. The hook now estimates the
# bundled run as files x TEST_FILE_SECONDS / concurrency and, when that is
# over TEST_BUDGET seconds, drops whole tiers from the lowest signal up: the
# hub sample, the l10n sample, tier 4, then tier 3, until the estimate fits,
# saying what it dropped. Tiers 1, 2 and 5 always run, over budget or not.
# When the selection is at least half of the suite and the whole suite fits
# the budget, the whole suite runs instead: bundled, it costs about the same
# and covers everything. RUN_ALL_AFFECTED=1 and TEST_BUDGET=0 turn the budget
# off. The default per-file cost is derived from the measured bundled runs of
# the whole suite (see TEST_FILE_COST below).
#
# Escape hatches:
#   RUN_ALL_TESTS=1    git push   run the entire suite locally, as bundles, via
#                                 scripts/run_all_tests.sh (also runnable alone)
#   RUN_ALL_AFFECTED=1 git push   skip ranking and the budget; run every importer
#   SKIP_TESTS=1       git push   skip the local test run entirely
#   DRY_RUN=1          git push   print the resolved test list and the budget
#                                 decision, then exit (no run)
#   TEST_BUDGET=N      git push   cap the local run at about N seconds
#                                 (default 600; 0 turns the cap off)
#   TEST_FILE_SECONDS=X git push  the bundled cost of one test file in
#                                 CPU-seconds that the estimate uses
#   TEST_BUNDLE_MIN=N  git push   bundle a selection of at least N files
#                                 (default 100)
#   TEST_CONCURRENCY=N git push   override the parallel test-isolate count
#   L10N_SAMPLE=N      git push   override the generated-l10n importer sample
#   HUB_SAMPLE=N       git push   override the hub importer sample
#   HUB_THRESHOLD=N    git push   override the importer count that makes a hub
# Note: scoped mapping is by DIRECT import; transitive dependents can be missed.
# CI is the authority for full coverage.

set -e

# Git sets GIT_DIR/GIT_WORK_TREE for hooks, which breaks Flutter's
# git-based version detection (it mistakes the project repo for the SDK).
unset GIT_DIR
unset GIT_WORK_TREE

echo "🔍 Running pre-push checks..."
echo ""

# Get the project root: the working tree actually being pushed.
#
# Resolve it from git, NOT from this script's location. core.hooksPath is an
# absolute path into the main checkout, so "$0" is the same path no matter
# which worktree is being pushed. Deriving the root from it made all three
# checks run against the main checkout: they reported that tree's unrelated
# problems (its build_runner output goes stale independently, since *.g.dart
# and *.mocks.dart are gitignored and generated per tree) while saying nothing
# about the change actually under push.
#
# GIT_DIR is unset above, so this resolves from the hook's working directory,
# which git sets to the top of the worktree being pushed.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$PROJECT_ROOT" ]; then
    # No work tree resolvable (unusual for a pre-push): keep the old behavior.
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
fi

cd "$PROJECT_ROOT"

# --- Resolve the push range -------------------------------------------------
#
# This runs FIRST because both the format check and the test selection need the
# changed-file list.

# Resolve a main ref, used to bound the range when pushing a brand-new branch
# (its remote sha is all-zeros, so there is no remote base to diff against).
# upstream/main first: a fork's own "origin/main" is not kept in sync by
# working from feature branches alone and can sit arbitrarily far behind the
# canonical repo, which would widen this range to everything that changed
# upstream since the fork last synced -- pulling in unrelated changed/test
# files (and their failures) that have nothing to do with the actual push.
# Falls back to origin/main, then local main, for a checkout with no
# "upstream" remote configured (e.g. working directly in the canonical repo).
MAIN_REF=""
for ref in upstream/main origin/main main; do
    if git rev-parse --verify --quiet "$ref" >/dev/null; then
        MAIN_REF="$ref"
        break
    fi
done

# Collect the files changed by the push. Git feeds pre-push a line per ref on
# stdin: "<local ref> <local sha> <remote ref> <remote sha>". We diff the range
# actually being pushed so re-pushes only re-test their new commits.
#
# range_resolved distinguishes "nothing changed" from "could not work out what
# changed". The former means there is nothing to format; the latter must fall
# back to formatting the whole project rather than silently checking nothing.
#
# It is therefore set ONLY from a diff that actually succeeded. Setting it
# up-front, or after a diff whose failure `|| true` had swallowed, would let a
# force-pushed-away remote sha or a partial clone produce an empty file list
# that the hook then reported as a clean format check having inspected nothing.
# range_failed makes one bad ref poison the whole push rather than silently
# scoping the checks to the refs that did resolve.
#
# push_sha seeds the generated-l10n sample.
changed_files=""
push_sha=""
range_ok=0
range_failed=0
if [ -t 0 ]; then
    # Run manually from a terminal (no ref list piped): fall back to the diff
    # of the current branch against its merge-base with main.
    push_sha=$(git rev-parse HEAD 2>/dev/null || true)
    if [ -n "$MAIN_REF" ]; then
        base=$(git merge-base HEAD "$MAIN_REF" 2>/dev/null || true)
        if [ -n "$base" ]; then
            if changed_files=$(git diff --name-only --diff-filter=d "$base" HEAD 2>/dev/null); then
                range_ok=1
            else
                changed_files=""
                range_failed=1
            fi
        fi
    fi
else
    while read -r local_ref local_sha remote_ref remote_sha; do
        # Skip branch deletions (local sha is empty or all zeros).
        case "$local_sha" in
            *[!0]*) : ;;
            *) continue ;;
        esac
        [ -n "$push_sha" ] || push_sha="$local_sha"
        # New branch on remote (remote sha all zeros) has no remote base;
        # bound it by the merge-base with main. Otherwise diff from the
        # remote sha to the local sha (exactly the commits being pushed).
        case "$remote_sha" in
            *[!0]*) base="$remote_sha" ;;
            *) base=$(git merge-base "$local_sha" "${MAIN_REF:-$local_sha}" 2>/dev/null || true) ;;
        esac
        if [ -n "$base" ]; then
            diff_from="$base"
        else
            diff_from="${local_sha}~1"
        fi
        if files=$(git diff --name-only --diff-filter=d "$diff_from" "$local_sha" 2>/dev/null); then
            range_ok=1
        else
            files=""
            range_failed=1
        fi
        changed_files="${changed_files}
${files}"
    done
fi

if [ "$range_ok" = "1" ] && [ "$range_failed" = "0" ]; then
    range_resolved=1
else
    range_resolved=0
fi

# --- Generated-l10n staleness ----------------------------------------------
#
# lib/l10n/arb/app_localizations*.dart is produced by `flutter gen-l10n` and is
# CHECKED IN. It is the only generated output in the repo that can go stale:
# *.g.dart, *.freezed.dart and *.mocks.dart are gitignored and rebuilt per tree.
# Nothing regenerates the l10n on the way to a build either -- `flutter test`
# does not, despite `generate: true` in pubspec.yaml -- so what is committed is
# exactly what ships. An ARB edit that skipped gen-l10n, or a generated file
# hand-resolved during a merge (they conflict often, since every locale changes
# together), otherwise reaches main with the stale string intact. CI asserts the
# same thing in Analyze & Format; this hook is the cheaper second check that
# catches it before the push rather than after.
#
# Only runs when the push touches lib/l10n/. gen-l10n rewrites all 12 files
# unconditionally, even when the bytes are identical, and app_localizations.dart
# is imported by 378 test files -- the biggest hub in the repo -- so doing this
# on every push would bump those mtimes and force a pointless recompile.
#
# The verdict is HEAD-relative, like CI's, because HEAD is what gets pushed.
# Regenerate, then read `git status`, which tells these three states apart:
#
#   generated dirty, ARBs clean -> HEAD's committed ARBs do not produce HEAD's
#     committed output. Definitively stale: block. Covers both "forgot to run
#     gen-l10n" and "ran it but committed only the ARB".
#   generated dirty, ARBs dirty -> the output was regenerated from sources HEAD
#     does not have, so it says nothing about the commits being pushed. Warn and
#     let it through rather than block a developer mid-ARB-edit from pushing
#     unrelated commits; CI still checks the pushed tree.
#   nothing dirty -> HEAD is self-consistent.
#
# Runs BEFORE the parallel stage rather than inside it, because rewriting these
# files underneath a concurrent `flutter analyze` would let it read a
# half-written source.
l10n_touched=0
if [ "$range_resolved" = "0" ]; then
    # Push range unknown: check rather than guess. It costs about 3s.
    l10n_touched=1
else
    while IFS= read -r f; do
        case "$f" in
            lib/l10n/*) l10n_touched=1; break ;;
        esac
    done <<< "$changed_files"
fi

l10n_failed=0
if [ "$l10n_touched" = "1" ]; then
    echo "🌍 Verifying generated localizations match the ARB files..."
    # Snapshot with -p so the mtimes can be put back when nothing drifted:
    # gen-l10n rewrites all 12 files regardless, and letting that bump the
    # mtime of the repo's biggest import hub would throw away an already-warm
    # compile before this hook's own test stage runs.
    l10n_before=$(mktemp -d)
    l10n_log=$(mktemp)
    set +e
    cp -p lib/l10n/arb/app_localizations*.dart "$l10n_before/" 2>/dev/null
    flutter gen-l10n > "$l10n_log" 2>&1
    l10n_status=$?
    set -e
    if [ "$l10n_status" -ne 0 ]; then
        echo "❌ flutter gen-l10n failed!"
        cat "$l10n_log"
        l10n_failed=1
    else
        # --porcelain, not `git diff`: a brand-new locale whose generated file
        # was never added is untracked, which a diff cannot see at all.
        stale=$(git status --porcelain -- 'lib/l10n/arb/app_localizations*.dart')
        arbs_dirty=$(git status --porcelain -- 'lib/l10n/arb/*.arb')
        if [ -z "$stale" ]; then
            # Byte-identical to HEAD, so this only restores the mtimes.
            cp -p "$l10n_before"/*.dart lib/l10n/arb/ 2>/dev/null || true
            echo "✅ Generated localizations are up to date"
        elif [ -n "$arbs_dirty" ]; then
            echo "⚠️  Uncommitted ARB edits, so the pushed commits cannot be"
            echo "   verified here. Regenerating from the working tree changed:"
            printf '%s\n' "$stale" | sed 's/^/   /'
            echo "   Commit these alongside the ARBs. CI checks the pushed tree."
        else
            echo "❌ Generated localizations are stale!"
            printf '%s\n' "$stale" | sed 's/^/   /'
            echo "   The ARBs are committed, but the committed generated output"
            echo "   is not what they produce. gen-l10n has REGENERATED these in"
            echo "   place: review and commit them, then push again."
            l10n_failed=1
        fi
    fi
    rm -rf "$l10n_before"
    rm -f "$l10n_log"
    echo ""
fi

# --- Static checks ----------------------------------------------------------
#
# Format and analyze are independent, so run them concurrently and report both
# rather than stopping at the first failure. This stage is paid on EVERY push,
# including the roughly half that end up selecting few or no tests, so it is
# worth more than its size suggests. Measured: 15-18s serial (43s from cold)
# against 7.5-9.8s for the scoped parallel version.
#
# The format check is scoped to the changed files: `dart format .` walks the
# whole project for 10-20s, while the same check over a 20-file change takes
# 0.07s. CI still formats everything, so an unformatted file elsewhere in the
# tree is still caught before merge.

changed_dart=()
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
        *.dart)
            # Deleted paths are already filtered by --diff-filter=d, but a
            # rebase or a partial checkout can still leave one missing.
            if [ -f "$f" ]; then
                changed_dart+=("$f")
            fi
            ;;
    esac
done <<< "$changed_files"

format_check() {
    if [ "$range_resolved" = "0" ]; then
        echo "(push range unresolved; formatting the whole project)"
        dart format --set-exit-if-changed .
        return
    fi
    if [ "${#changed_dart[@]}" -eq 0 ]; then
        return 0
    fi
    # Piped through xargs in small, fixed-size batches (-n 20), not passed
    # directly as argv and not left to xargs' own auto-sized chunking: a push
    # spanning enough commits (a long-lived branch, a squash-worthy PR) can
    # list enough changed files that a single dart-format invocation's
    # command line exceeds the OS's length limit -- on Windows this fails
    # with "Die Befehlszeile ist zu lang" before dart format ever runs,
    # misreporting a real format pass as a failure. xargs' own default chunk
    # size is calculated from a reported ARG_MAX that does not hold in
    # practice once `dart` resolves through a wrapping .bat on Windows (each
    # layer of batch-file re-quoting eats into the same limit), so it still
    # overflowed at 178 files with no explicit -n; a small fixed batch avoids
    # depending on that estimate at all. -0 keeps it filename-safe (paths
    # with spaces).
    printf '%s\0' "${changed_dart[@]}" | xargs -0 -n 20 dart format --set-exit-if-changed
}

echo "📝 Checking formatting and 🔬 analyzing (in parallel)..."
fmt_log=$(mktemp)
ana_log=$(mktemp)

format_check > "$fmt_log" 2>&1 &
fmt_pid=$!
flutter analyze > "$ana_log" 2>&1 &
ana_pid=$!

# `wait` reports the job's exit status, which set -e would treat as fatal before
# we get the chance to print the log that explains it.
set +e
wait "$fmt_pid"; fmt_status=$?
wait "$ana_pid"; ana_status=$?
set -e

checks_failed=0
if [ "$fmt_status" -eq 0 ]; then
    if [ "$range_resolved" = "0" ]; then
        echo "✅ Format check passed (whole project; push range unresolved)"
    else
        echo "✅ Format check passed (${#changed_dart[@]} changed dart file(s))"
    fi
else
    echo "❌ Format check failed! These files need formatting:"
    cat "$fmt_log"
    echo "   Run 'dart format .' to fix."
    checks_failed=1
fi

if [ "$ana_status" -eq 0 ]; then
    echo "✅ Analysis passed"
else
    echo "❌ Analysis failed!"
    cat "$ana_log"
    checks_failed=1
fi

rm -f "$fmt_log" "$ana_log"
echo ""

# Reported above, before the parallel stage; gated here so format, analyze and
# l10n all get a verdict on one run rather than stopping at the first failure.
if [ "$l10n_failed" -ne 0 ]; then
    checks_failed=1
fi

if [ "$checks_failed" -ne 0 ]; then
    echo "Fix the issues above before pushing."
    exit 1
fi

# --- Test stage ------------------------------------------------------------

# Parallel test isolates: the core count, at most 16, or TEST_CONCURRENCY. The
# default and its measurement live in scripts/test_concurrency.sh, shared with
# scripts/run_all_tests.sh. The hook sources the copy beside itself, in the
# main checkout, so the two files always come from the same version.
HOOK_SCRIPTS="$(cd "$(dirname "$0")/.." && pwd)/scripts"
if [ -f "$HOOK_SCRIPTS/test_concurrency.sh" ]; then
    # shellcheck source=../scripts/test_concurrency.sh
    . "$HOOK_SCRIPTS/test_concurrency.sh"
    CONCURRENCY="$(resolve_test_concurrency)"
else
    echo "⚠️  $HOOK_SCRIPTS/test_concurrency.sh is missing; using 6 test isolates." >&2
    CONCURRENCY=6
fi

# L10N_SAMPLE is interpolated straight into `head -n`, so a typo used to fail
# that command and, under set -e, abort the push with an error that named
# neither the variable nor the value. Warn and fall back instead: a mistyped
# tuning knob must never block a push. The value is read as decimal (08 is 8),
# and zero in any spelling is refused.
#
# An oversized value is clamped to OVERRIDE_MAX, which is already more than
# any pool or importer count, so it keeps its meaning ("every importer", "no
# hubs"). Left alone, BSD head rejected most counts from 2^31 up (3000000000,
# for one; it truncates to 32 bits, so a few huge values slip through by luck),
# which killed the push silently under set -e, and past 2^63 bash arithmetic
# wrapped the value instead.
# The digits are compared as a string, before any arithmetic can wrap them.
OVERRIDE_MAX=999999
sanitized_override() {
    local name="$1" value="$2" fallback="$3" digits
    case "$value" in
        ''|*[!0-9]*) ;;
        *)
            digits="${value#"${value%%[!0]*}"}"
            if [ "${#digits}" -gt "${#OVERRIDE_MAX}" ]; then
                printf '%s' "$OVERRIDE_MAX"
                return
            fi
            if [ -n "$digits" ] && [ "$((10#$digits))" -gt 0 ]; then
                printf '%s' "$((10#$digits))"
                return
            fi
            ;;
    esac
    echo "⚠️  Ignoring invalid ${name}='${value}'; using ${fallback}." >&2
    printf '%s' "$fallback"
}

L10N_SAMPLE_SIZE=40
if [ -n "${L10N_SAMPLE:-}" ]; then
    L10N_SAMPLE_SIZE="$(sanitized_override L10N_SAMPLE "$L10N_SAMPLE" 40)"
fi
HUB_SAMPLE_SIZE=40
if [ -n "${HUB_SAMPLE:-}" ]; then
    HUB_SAMPLE_SIZE="$(sanitized_override HUB_SAMPLE "$HUB_SAMPLE" 40)"
fi
HUB_THRESHOLD_COUNT=100
if [ -n "${HUB_THRESHOLD:-}" ]; then
    HUB_THRESHOLD_COUNT="$(sanitized_override HUB_THRESHOLD "$HUB_THRESHOLD" 100)"
fi

TEST_BUNDLE_MIN_FILES=100
if [ -n "${TEST_BUNDLE_MIN:-}" ]; then
    TEST_BUNDLE_MIN_FILES="$(sanitized_override TEST_BUNDLE_MIN "$TEST_BUNDLE_MIN" 100)"
fi

# TEST_BUDGET is in seconds. Zero in any spelling means no cap, which
# sanitized_override would refuse, so it is settled first.
TEST_BUDGET_SECONDS=600
case "${TEST_BUDGET:-}" in
    '') ;;
    *[!0]*) TEST_BUDGET_SECONDS="$(sanitized_override TEST_BUDGET "$TEST_BUDGET" 600)" ;;
    *) TEST_BUDGET_SECONDS=0 ;;
esac

# The bundled cost of one test file, in CPU-seconds, so wall-clock is about
# files x cost / concurrency. Measured at -j 16 on an 18-core Mac with other
# sessions running: a real 424-file push took 268s at load 28, which is 5.1; an
# even sample of 522 files is 3.8, and the whole suite of 6,270 is 2.9. Pushes
# select the heavy database and hub-adjacent tests, so the real push sets the
# value, and it reads high for the even mix of a whole suite. It is a rough
# guide: the same push took 604s at load 55. Concurrency does not scale
# linearly either (the suite took 939s at -j 8 and 1,151s at -j 16, at different
# loads), so a lower TEST_CONCURRENCY overstates the time.
# TEST_FILE_SECONDS overrides it, as a positive decimal.
TEST_FILE_COST=5.0
if [ -n "${TEST_FILE_SECONDS:-}" ]; then
    if printf '%s' "$TEST_FILE_SECONDS" | grep -Eq '^[0-9]+(\.[0-9]+)?$' \
        && awk -v x="$TEST_FILE_SECONDS" 'BEGIN { exit !(x > 0) }'; then
        TEST_FILE_COST="$TEST_FILE_SECONDS"
    else
        echo "⚠️  Ignoring invalid TEST_FILE_SECONDS='${TEST_FILE_SECONDS}'; using ${TEST_FILE_COST}." >&2
    fi
fi

# Shared test runner: "$@" is an explicit file list; empty means whole suite.
run_tests() {
    flutter test --exclude-tags performance --concurrency="$CONCURRENCY" "$@"
}

# Runs an explicit file list through run_tests in fixed-size batches, rather
# than as one invocation: a selection large enough (a long-lived branch, a
# squash-worthy PR) makes flutter test's own command line exceed the OS's
# length limit -- on Windows this fails with "Argument list too long" inside
# flutter.bat before a single test runs, the same class of failure the
# xargs-batched format check above works around. Each batch pays its own
# isolate/compile startup cost, which is the point: correctness over the
# single-invocation speed this hook otherwise optimizes for, and this path
# only engages once a selection is large enough to overflow in the first
# place. Returns non-zero if any batch fails, after running them all so one
# failing batch does not hide a later one.
run_tests_batched() {
    local -a files=("$@")
    local batch_size=100
    local i=0
    local failed=0
    while [ "$i" -lt "${#files[@]}" ]; do
        local -a batch=("${files[@]:$i:$batch_size}")
        run_tests "${batch[@]}" || failed=1
        i=$((i + batch_size))
    done
    return "$failed"
}

# True when a selection of $1 files runs bundled. The script is the pushed
# tree's, so a branch cut before it learned TEST_FILES_FROM (or before it
# existed) says no here.
selection_bundles() {
    [ "$1" -ge "$TEST_BUNDLE_MIN_FILES" ] \
        && [ -f scripts/run_all_tests.sh ] \
        && grep -q 'TEST_FILES_FROM' scripts/run_all_tests.sh
}

# The per-test limit for a bundled selection, over the 2m in dart_test.yaml. On a
# machine at load 35-55 a migration test that takes seconds alone reached that
# 2m in a bundle, twice, and never as separate files, which blocked a push over
# nothing. Widget tests keep the binding's limit, which this flag does not reach.
BUNDLED_TEST_TIMEOUT=5m

# Runs the selected files: bundled through scripts/run_all_tests.sh when the
# selection is large enough (see the header), which also handles the
# command-line limit and names the failing files, otherwise as separate files.
run_selected() {
    local list status
    if selection_bundles "$#"; then
        list=$(mktemp)
        printf '%s\n' "$@" > "$list"
        status=0
        TEST_FILES_FROM="$list" TEST_CONCURRENCY="$CONCURRENCY" \
            bash scripts/run_all_tests.sh --timeout="$BUNDLED_TEST_TIMEOUT" || status=$?
        rm -f "$list"
        return "$status"
    fi
    run_tests_batched "$@"
}

if [ "${SKIP_TESTS:-0}" = "1" ]; then
    echo "🧪 Skipping tests (SKIP_TESTS=1). CI runs the full suite."
    echo ""
    echo "🚀 All checks passed! Pushing..."
    exit 0
fi

# The full suite runs through scripts/run_all_tests.sh, which bundles it (issue
# #2512: 10m11s as separate files, 2m52s bundled, on an 18-core Mac at -j 16)
# and names the files that failed or did not compile. It runs from the tree being
# pushed. This hook runs from the main checkout for every worktree, so a branch
# cut before that script existed gets the plain run instead.
run_full_suite() {
    if [ -f scripts/run_all_tests.sh ]; then
        TEST_CONCURRENCY="$CONCURRENCY" bash scripts/run_all_tests.sh
    else
        run_tests
    fi
}

if [ "${RUN_ALL_TESTS:-0}" = "1" ]; then
    echo "🧪 Running FULL test suite (RUN_ALL_TESTS=1, concurrency $CONCURRENCY)..."
    if ! run_full_suite; then
        echo ""
        echo "❌ Tests failed! Fix the failing tests before pushing."
        exit 1
    fi
    echo "✅ All tests passed"
    echo ""
    echo "🚀 All checks passed! Pushing..."
    exit 0
fi

# Map changed files to affected test files. "matched" accumulates candidate
# lines "<tier> <path>" (newline-separated), the tier being the one from the
# header that selected the path; a path selected by several tiers keeps the
# lowest number. It is deduped and existence-filtered at the end, and the tier
# is what the time budget trims by.
matched=""
dart_changed=0
helper_pattern=$(mktemp)   # changed test helpers, matched by path segment
code_pattern=$(mktemp)     # package: imports of changed non-generated lib files
l10n_pattern=$(mktemp)     # package: imports of generated localization output
near_dirs=$(mktemp)        # feature areas touched by changed lib code
hub_pattern=$(mktemp)      # changed files with more than HUB_THRESHOLD importers
# A changed lib file at the top level (lib/main.dart) has no feature area to
# compare against, so proximity cannot discriminate: keep every importer.
near_everything=0
# Whether the push touched lib/ (any file, ARBs included), for the implicit
# "scans lib/" of test/architecture/ (tier 5).
lib_changed=0

while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in *.dart) dart_changed=1 ;; esac
    case "$f" in lib/*) lib_changed=1 ;; esac
    case "$f" in
        test/*_test.dart)
            # A changed test: run it directly (tier 1).
            matched="${matched}
1 ${f}"
            ;;
        test/*.dart)
            # A changed helper/fixture: run the tests that import it. Match the
            # path segment (leading slash) so relative imports at any depth
            # (../helpers/foo.dart) are caught. Files imported by nobody
            # (e.g. auto-discovered flutter_test_config.dart) map to nothing.
            printf '/%s\n' "$(basename "$f")" >> "$helper_pattern"
            ;;
        lib/*.dart)
            # Mirrored test path (lib/x/y.dart -> test/x/y_test.dart), tier 2.
            rel="${f#lib/}"
            matched="${matched}
2 test/${rel%.dart}_test.dart"
            # ... plus, below, the tests that import this file.
            case "$f" in
                lib/l10n/arb/app_localizations*.dart)
                    # Generated by `flutter gen-l10n` and imported by 378 test
                    # files. Sampled rather than expanded; see the header.
                    printf 'package:submersion/%s\n' "$rel" >> "$l10n_pattern"
                    ;;
                *)
                    printf 'package:submersion/%s\n' "$rel" >> "$code_pattern"
                    case "$rel" in
                        core/database/tables/*|core/database/migrations/*)
                            # No test imports these directly: tables and the
                            # migration library reach every test through
                            # database.dart, which exports them (#2502). Treat
                            # the change as a change to database.dart, near the
                            # migration tests in test/core/database/.
                            printf 'package:submersion/core/database/database.dart\n' >> "$code_pattern"
                            printf 'core/database\n' >> "$near_dirs"
                            ;;
                    esac
                    dir=$(dirname "$rel")
                    if [ "$dir" = "." ]; then
                        near_everything=1
                    else
                        printf '%s\n' "$dir" | cut -d/ -f1-3 >> "$near_dirs"
                    fi
                    ;;
            esac
            ;;
    esac
done <<< "$changed_files"

# Patterns from file $1 that more than HUB_THRESHOLD test files contain. One
# grep pass for every pattern: -o prints each match as "path:pattern", deduped
# per file so a test naming a file twice (an import plus a comment, say) still
# counts once, then counted per pattern.
hub_patterns_in() {
    grep -roF -f "$1" --include='*_test.dart' test 2>/dev/null \
        | sort -u | cut -d: -f2- | sort | uniq -c \
        | awk -v limit="$HUB_THRESHOLD_COUNT" '$1 > limit { print $2 }' || true
}

# Moves the hub patterns of file $1 into $hub_pattern, so the tiers below see
# only ordinary files. RUN_ALL_AFFECTED runs every importer, so it has no hubs.
split_out_hubs() {
    [ -s "$1" ] || return 0
    [ "${RUN_ALL_AFFECTED:-0}" = "1" ] && return 0
    local hubs rest
    hubs=$(hub_patterns_in "$1")
    [ -n "$hubs" ] || return 0
    printf '%s\n' "$hubs" >> "$hub_pattern"
    rest=$(grep -vxF -f <(printf '%s\n' "$hubs") "$1" || true)
    if [ -n "$rest" ]; then
        printf '%s\n' "$rest" > "$1"
    else
        : > "$1"
    fi
}

# A deterministic sample of the paths on stdin, $1 of them. djb2 over
# "seed + path" gives a stable pseudo-random order without a per-file
# subprocess (the l10n and hub pools run to hundreds of files). The seed is the
# pushed sha: stable within a commit so a failure reproduces on re-run, but
# rotating across commits so repeated edits accumulate coverage. With a
# near-dirs file as $2, paths in one of those feature areas (first 3 segments
# under test/, as in tier 3) come before every other path.
seeded_sample() {
    sort -u | awk -v seed="${push_sha:-none}" -v nearfile="${2:-}" '
        BEGIN {
            for (i = 32; i < 127; i++) ord[sprintf("%c", i)] = i
            if (nearfile != "") {
                while ((getline d < nearfile) > 0) near[d] = 1
            }
        }
        $0 != "" {
            s = seed $0; h = 5381
            for (i = 1; i <= length(s); i++) {
                h = (h * 33 + ord[substr(s, i, 1)]) % 4294967291
            }
            rank = 1
            if (nearfile != "") {
                rel = $0
                sub(/^test\//, "", rel)
                if (rel ~ /\//) {
                    sub(/\/[^\/]*$/, "", rel)
                    n = split(rel, seg, "/")
                    area = seg[1]
                    for (i = 2; i <= n && i <= 3; i++) area = area "/" seg[i]
                } else {
                    area = "."
                }
                if (area in near) rank = 0
            }
            printf "%d\t%012d\t%s\n", rank, h, $0
        }' | sort -t "$(printf '\t')" -k1,1n -k2,2n -k3 | cut -f3 | head -n "$1"
}

sort -u -o "$code_pattern" "$code_pattern"
split_out_hubs "$helper_pattern"
split_out_hubs "$code_pattern"

# Tests importing a changed test helper are always kept: the tier is small and
# a helper change breaks its consumers directly. Hub helpers were split out
# above and are sampled with the other hubs.
if [ -s "$helper_pattern" ]; then
    while IFS= read -r t; do
        matched="${matched}
1 ${t}"
    done < <(grep -rlF -f "$helper_pattern" --include='*_test.dart' test 2>/dev/null || true)
fi

# Repo-wide guards, selected by the paths they read: see tier 5 in the header.
# [[:space:]] rather than \s, which BSD grep's -E does not promise.
guard_marker='^[[:space:]]*//[[:space:]]*pre-push:[[:space:]]*scans[[:space:]]'

# True when a file the push changed starts with prefix $1.
changed_under() {
    local f
    while IFS= read -r f; do
        case "$f" in "$1"*) return 0 ;; esac
    done <<< "$changed_files"
    return 1
}

guards=""
if [ "$lib_changed" = "1" ] && [ -d test/architecture ]; then
    guards="$(find test/architecture -name '*_test.dart' 2>/dev/null || true)"
fi
# grep -H gives "path:<marker line>". The CR comes off first: some Dart files
# are CRLF, and a trailing CR would end up glued to the last prefix.
while IFS= read -r line; do
    [ -n "$line" ] || continue
    line="${line%$'\r'}"
    guard_file="${line%%:*}"
    prefix_list="$(printf '%s\n' "${line#*:}" | sed -E \
        's#^[[:space:]]*//[[:space:]]*pre-push:[[:space:]]*scans[[:space:]]+##')"
    # read -a splits on spaces without glob-expanding the prefixes.
    read -r -a prefixes <<< "$prefix_list"
    for prefix in "${prefixes[@]}"; do
        if changed_under "$prefix"; then
            guards="${guards}
${guard_file}"
            break
        fi
    done
done < <(grep -rHE "$guard_marker" --include='*_test.dart' test 2>/dev/null || true)
while IFS= read -r t; do
    [ -n "$t" ] || continue
    matched="${matched}
5 ${t}"
done <<< "$guards"

# Importers of changed lib code, ranked. `grep -rc` reports "path:count" per
# file; import lines are unique, so the count approximates how many distinct
# changed files that test pulls in. A test is kept when it is in the same
# feature area (proximity) OR imports two or more changed files (an orthogonal
# signal that catches cross-feature dependents proximity would drop).
if [ -s "$code_pattern" ]; then
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        hits="${line##*:}"
        path="${line%:*}"
        [ "$hits" != "0" ] || continue
        # keep is the tier that selects the test: 3 for proximity (which
        # every importer gets when nothing is dropped), 4 for the multi-hit
        # signal, 0 for not selected.
        keep=0
        if [ "${RUN_ALL_AFFECTED:-0}" = "1" ] || [ "$near_everything" = "1" ]; then
            keep=3
        elif [ "$hits" -ge 2 ]; then
            keep=4
        else
            area=$(dirname "${path#test/}" | cut -d/ -f1-3)
            if grep -qxF "$area" "$near_dirs" 2>/dev/null; then
                keep=3
            fi
        fi
        if [ "$keep" != "0" ]; then
            matched="${matched}
${keep} ${path}"
        fi
    done < <(grep -rcF -f "$code_pattern" --include='*_test.dart' test 2>/dev/null || true)
fi

# Importers of regenerated localization output, sampled (see seeded_sample).
if [ -s "$l10n_pattern" ]; then
    l10n_hits=$(grep -rlF -f "$l10n_pattern" --include='*_test.dart' test 2>/dev/null || true)
    if [ -n "$l10n_hits" ]; then
        if [ "${RUN_ALL_AFFECTED:-0}" = "1" ]; then
            l10n_pick="$l10n_hits"
        else
            l10n_pick=$(printf '%s\n' "$l10n_hits" | seeded_sample "$L10N_SAMPLE_SIZE")
        fi
        while IFS= read -r t; do
            [ -n "$t" ] || continue
            matched="${matched}
6 ${t}"
        done <<< "$l10n_pick"
    fi
fi

# Importers of hubs, sampled near-first from whatever the tiers above did not
# already select, so the sample is never spent on a file that runs anyway.
if [ -s "$hub_pattern" ]; then
    hub_hits=$(grep -rlF -f "$hub_pattern" --include='*_test.dart' test 2>/dev/null || true)
    if [ -n "$hub_hits" ]; then
        already=$(printf '%s\n' "$matched" | grep -v '^$' | sed 's/^[0-9] //' || true)
        if [ -n "$already" ]; then
            hub_hits=$(printf '%s\n' "$hub_hits" \
                | grep -vxF -f <(printf '%s\n' "$already") || true)
        fi
    fi
    if [ -n "$hub_hits" ]; then
        hub_pick=$(printf '%s\n' "$hub_hits" | seeded_sample "$HUB_SAMPLE_SIZE" "$near_dirs")
        while IFS= read -r t; do
            [ -n "$t" ] || continue
            matched="${matched}
7 ${t}"
        done <<< "$hub_pick"
    fi
fi

rm -f "$helper_pattern" "$code_pattern" "$l10n_pattern" "$near_dirs" "$hub_pattern"

# Dedupe (a path selected by several tiers keeps the lowest tier number),
# drop blanks/non-tests/deleted paths, load into parallel arrays.
final=$(printf '%s\n' "$matched" | grep -v '^$' | sort -k2,2 -k1,1n \
    | awk '!seen[$2]++' | while read -r tier t; do
    [ -n "$t" ] || continue
    [[ "$t" == *_test.dart ]] || continue
    # Must be "|| continue", never '[ -f "$t" ] && printf'. This loop is the
    # last command of a $(...) assignment, so a false test on the FINAL
    # iteration makes the loop, the substitution, and then the assignment all
    # exit 1 -- and set -e kills the hook with no message at all. Missing paths
    # here are routine: the mirrored lib/x.dart -> test/x_test.dart mapping is
    # speculative, and plenty of lib files have no mirrored test.
    [ -f "$t" ] || continue
    printf '%s %s\n' "$tier" "$t"
done)

test_files=()
test_tiers=()
while read -r tier t; do
    [ -n "$t" ] || continue
    test_tiers+=("$tier")
    test_files+=("$t")
done <<< "$final"

# --- The time budget (see the header) ---------------------------------------

# Whole seconds a bundled run of $1 test files is expected to take.
estimate_seconds() {
    awk -v n="$1" -v cost="$TEST_FILE_COST" -v j="$CONCURRENCY" \
        'BEGIN { s = n * cost / j; printf "%d", (s == int(s)) ? s : int(s) + 1 }'
}

# $1 seconds as "1m09s", or "45s" under a minute.
format_seconds() {
    if [ "$1" -ge 60 ]; then
        printf '%dm%02ds' $(($1 / 60)) $(($1 % 60))
    else
        printf '%ds' "$1"
    fi
}

tier_label() {
    case "$1" in
        3) printf 'same-area importers of changed files' ;;
        4) printf 'tests importing two or more changed files' ;;
        6) printf 'sampled importers of generated l10n' ;;
        7) printf 'sampled importers of hub files' ;;
        *) printf 'tier %s' "$1" ;;
    esac
}

# Removes every test of tier $1 from test_files and test_tiers, leaving the
# count in dropped_count. Not a $(...) call: that would run in a subshell and
# lose the arrays.
dropped_count=0
drop_tier() {
    local -a keep_files=() keep_tiers=()
    local i
    dropped_count=0
    for i in "${!test_files[@]}"; do
        if [ "${test_tiers[$i]}" = "$1" ]; then
            dropped_count=$((dropped_count + 1))
        else
            keep_files+=("${test_files[$i]}")
            keep_tiers+=("${test_tiers[$i]}")
        fi
    done
    test_files=(${keep_files[@]+"${keep_files[@]}"})
    test_tiers=(${keep_tiers[@]+"${keep_tiers[@]}"})
}

budget_notes=""
run_whole_suite=0
if [ "${#test_files[@]}" -gt 0 ] && [ "$TEST_BUDGET_SECONDS" -gt 0 ] \
    && [ "${RUN_ALL_AFFECTED:-0}" != "1" ]; then
    selected=${#test_files[@]}
    suite_files=$(find test -name '*_test.dart' -not -path 'test/.bundles/*' \
        2>/dev/null | wc -l | tr -d ' ')
    suite_estimate=$(estimate_seconds "$suite_files")
    if [ $((selected * 2)) -ge "$suite_files" ] \
        && [ "$suite_estimate" -le "$TEST_BUDGET_SECONDS" ] \
        && [ -f scripts/run_all_tests.sh ]; then
        run_whole_suite=1
        budget_notes="⏱️  The selection is ${selected} of ${suite_files} test files, so the whole suite
   runs instead: bundled it takes about $(format_seconds "$suite_estimate"), within
   TEST_BUDGET=${TEST_BUDGET_SECONDS}s, and covers everything."
    else
        estimate=$(estimate_seconds "$selected")
        if [ "$estimate" -gt "$TEST_BUDGET_SECONDS" ]; then
            budget_notes="⏱️  ${selected} test files would take about $(format_seconds "$estimate") bundled, over
   TEST_BUDGET=${TEST_BUDGET_SECONDS}s. Trimming the lowest-signal tiers first:"
            for tier in 7 6 4 3; do
                [ "$estimate" -gt "$TEST_BUDGET_SECONDS" ] || break
                drop_tier "$tier"
                [ "$dropped_count" -gt 0 ] || continue
                estimate=$(estimate_seconds "${#test_files[@]}")
                budget_notes="${budget_notes}
   dropped ${dropped_count} $(tier_label "$tier") (now about $(format_seconds "$estimate"))"
            done
            if [ "$estimate" -gt "$TEST_BUDGET_SECONDS" ]; then
                budget_notes="${budget_notes}
   Still over budget with the ${#test_files[@]} files that always run (changed and
   mirrored tests, repo-wide guards); running them anyway."
            fi
            budget_notes="${budget_notes}
   CI runs the full suite. (TEST_BUDGET=0 runs the whole selection; a larger
   TEST_BUDGET keeps more tiers.)"
        fi
    fi
fi

if [ "${DRY_RUN:-0}" = "1" ]; then
    echo "🧪 DRY_RUN: ${#test_files[@]} affected test file(s):"
    printf '   %s\n' "${test_files[@]}"
    if [ -n "$budget_notes" ]; then
        printf '%s\n' "$budget_notes"
    fi
    if [ "$run_whole_suite" = "1" ]; then
        echo "   DRY_RUN: the whole suite would run, as bundles, instead of this selection."
    fi
    exit 0
fi

if [ "$run_whole_suite" = "1" ]; then
    printf '%s\n' "$budget_notes"
    echo ""
    echo "🧪 Running the whole test suite as bundles (concurrency $CONCURRENCY)..."
    if ! run_full_suite; then
        echo ""
        echo "❌ Tests failed! Fix the failing tests before pushing."
        exit 1
    fi
    echo "✅ All tests passed"
    echo ""
elif [ "${#test_files[@]}" -gt 0 ]; then
    if [ -n "$budget_notes" ]; then
        printf '%s\n' "$budget_notes"
        echo ""
    fi
    if selection_bundles "${#test_files[@]}"; then
        echo "🧪 Running ${#test_files[@]} affected test file(s) as bundles (concurrency $CONCURRENCY)..."
    else
        echo "🧪 Running ${#test_files[@]} affected test file(s) (concurrency $CONCURRENCY)..."
    fi
    if [ "${#test_files[@]}" -le 25 ]; then
        printf '   %s\n' "${test_files[@]}"
    fi
    echo ""
    if ! run_selected "${test_files[@]}"; then
        echo ""
        echo "❌ Tests failed! Fix the failing tests before pushing."
        echo "   (RUN_ALL_TESTS=1 git push runs the full suite; CI runs it regardless.)"
        exit 1
    fi
    echo "✅ Affected tests passed"
    echo "   Ranked selection: changed and mirrored tests, same-area importers,"
    echo "   tests hitting 2+ changed files, and repo-wide guards."
    echo "   Distant single-hit importers, and most importers of generated l10n"
    echo "   and of hub files, are left to CI's full suite."
    echo "   (RUN_ALL_AFFECTED=1 runs every importer, ignoring TEST_BUDGET.)"
    echo ""
elif [ "$dart_changed" = "1" ]; then
    echo "🧪 No test files directly import the changed Dart files; skipping local tests."
    echo "   CI runs the full suite. (RUN_ALL_TESTS=1 forces a full local run.)"
    echo ""
else
    echo "🧪 No Dart changes in this push; skipping local tests."
    echo ""
fi

echo "🚀 All checks passed! Pushing..."
exit 0
