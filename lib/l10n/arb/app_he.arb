  "species_whitetip_reef_shark_name": "כריש שונית לבן-קצה",
  "species_whitetip_reef_shark_desc": "דייר שונית נוח שנמצא לרוב נח במערות ומתחת למדפי סלע במהלך היום.",
  "species_blacktip_reef_shark_name": "כריש שונית שחור-קצה",
  "species_blacktip_reef_shark_desc": "כריש שונית נפוץ במים רדודים, בעל קצות סנפירים שחורים אופייניים.",
  "species_grey_reef_shark_name": "כריש שונית אפור",
  "species_grey_reef_shark_desc": "טורף שונית פעיל שנפגשים בו לרוב בקבוצות לאורך מדרונות תלולים ותעלות.",
  "species_caribbean_reef_shark_name": "כריש שונית קריבי",
  "species_caribbean_reef_shark_desc": "כריש השונית הנפוץ ביותר בקריביים, חסון וסקרן.",
  "species_nurse_shark_name": "כריש אומנת",
  "species_nurse_shark_desc": "דייר קרקעית איטי שנמצא לרוב נח מתחת למדפי אלמוגים.",
  "species_tawny_nurse_shark_name": "כריש אומנת שחום",
  "species_tawny_nurse_shark_desc": "דייר קרקעית הודו-פסיפי הנח במערות שונית ובאזורי חול.",
  "species_bull_shark_name": "כריש שור",
  "species_bull_shark_desc": "כריש חסון ורב-עוצמה המצוי בסביבות חוף ובמים מתוקים בכל העולם.",
  "species_tiger_shark_name": "כריש טיגריס",
  "species_tiger_shark_desc": "טורף גדול בעל דוגמת פסים אופיינית, נפגש בצלילות שונית עמוקות.",
  "species_oceanic_whitetip_shark_name": "כריש לבן-קצה אוקייני",
  "species_oceanic_whitetip_shark_desc": "כריש פלגי בעל סנפירים מעוגלים לבני-קצה, נצפה בצלילות באוקיינוס הפתוח.",
  "species_thresher_shark_name": "כריש שועל",
  "species_thresher_shark_desc": "ניכר בסנפיר הזנב הארוך במיוחד שלו, ולעיתים נצפה בתחנות ניקוי.",
  "species_pelagic_thresher_shark_name": "כריש שועל פלגי",
  "species_pelagic_thresher_shark_desc": "המין הקטן ביותר בקרב כרישי השועל, מפורסם בתצפיות במונאד שול שבפיליפינים.",
  "species_shortfin_mako_shark_name": "כריש מאקו קצר-סנפיר",
  "species_shortfin_mako_shark_desc": "הכריש המהיר ביותר באוקיינוס, טורף מים פתוחים חלקלק בגוון כחול מתכתי.",
  "species_blue_shark_name": "כריש כחול",
  "species_blue_shark_desc": "כריש פלגי תמיר בגוון כחול עמוק, נפגש לעיתים קרובות בצלילות מים כחולים.",
  "species_spotted_wobbegong_name": "וובגונג מנוקד",
  "species_spotted_wobbegong_desc": "כריש שטיח שטוח ומוסווה השוכב ללא תנועה על שוניות סלע באוסטרליה.",
  "species_tasselled_wobbegong_name": "וובגונג מצויץ",
  "species_tasselled_wobbegong_desc": "כריש שטיח מקושט בעל אונות משוננות סביב הראש, מצוי בשוניות אלמוגים.",
  "species_epaulette_shark_name": "כריש כתפייה",
  "species_epaulette_shark_desc": "כריש קטן הצועד על קרקעית השונית בעזרת סנפירי החזה שלו.",
  "species_horn_shark_name": "כריש קרן",
  "species_horn_shark_desc": "דייר קרקעית לילי בעל רכסים מעל העיניים, מצוי מול חופי קליפורניה.",
  "species_leopard_shark_name": "כריש נמר",
  "species_leopard_shark_desc": "כריש בעל דוגמה יפהפייה המצוי במפרצים רדודים לאורך חופי האוקיינוס השקט של ארצות הברית.",
  "species_pacific_angel_shark_name": "כריש מלאך פסיפי",
  "species_pacific_angel_shark_desc": "טורף מארב שטוח-גוף השוכב טמון בחול על קרקעית הים.",
  "species_sand_tiger_shark_name": "כריש חול",
  "species_sand_tiger_shark_desc": "כריש בעל מראה מאיים אך אופי נוח, נצפה לעיתים קרובות מרחף במערות ובספינות טרופות.",
  "species_zebra_shark_name": "כריש זברה",
  "species_zebra_shark_desc": "כריש שונית מנוקד הנח על קרקעיות חול, נפוץ בהודו-פסיפי.",
  "species_blacktip_shark_name": "כריש שחור-קצה",
  "species_blacktip_shark_desc": "כריש חופי מהיר הידוע בקפיצות המסתובבות שלו, מצוי במים חמים בכל העולם.",
  "species_silvertip_shark_name": "כריש כסוף-קצה",
  "species_silvertip_shark_desc": "כריש שונית נועז בעל סנפירים לבני-שוליים, מצוי ליד מדרונות עמוקים ואטולים.",
  "species_silky_shark_name": "כריש משיי",
