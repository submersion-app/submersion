  "species_basking_shark_desc": "הדג השני בגודלו בעולם, מסנן מזון הנצפה במים ממוזגים סמוך לפני השטח.",
  "species_greenland_shark_name": "כריש גרינלנד",
  "species_greenland_shark_desc": "כריש מים עמוקים איטי, אחד מבעלי החוליות המאריכים ימים ביותר על פני כדור הארץ.",
  "species_cookiecutter_shark_name": "כריש חותך העוגיות",
  "species_cookiecutter_shark_desc": "כריש מים עמוקים קטן הנוגס נגיסות עגולות מבעלי חיים ימיים גדולים ממנו.",
  "species_sevengill_shark_name": "כריש שבעת הזימים רחב-חוטם",
  "species_sevengill_shark_desc": "כריש קדום בעל שבעה חריצי זימים, נפגש בצלילות ביערות קלפ ממוזגים.",
  "species_pyjama_shark_name": "כריש פיג'מה",
  "species_pyjama_shark_desc": "כריש חתול מפוספס האנדמי לדרום אפריקה, מצוי בשוניות סלע וביערות קלפ.",
  "species_spiny_dogfish_name": "כלבתן קוצני",
  "species_spiny_dogfish_desc": "כריש קטן ונפוץ בעל קוצי גב ארסיים, מצוי במים ממוזגים.",
  "species_swell_shark_name": "כריש מתנפח",
  "species_swell_shark_desc": "כריש חתול לילי המנפח את גופו כשהוא מאוים, מצוי מול חופי קליפורניה.",
  "species_giant_oceanic_manta_ray_name": "מנטה אוקיינית ענקית",
  "species_giant_oceanic_manta_ray_desc": "מין הטריגון הגדול ביותר, מסנן מזון מלכותי בעל מוטת כנפיים של עד 7 מטרים.",
  "species_reef_manta_ray_name": "מנטת שונית",
