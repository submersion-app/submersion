  "species_sea_spider_desc": "פרוק רגליים ימי עדין בעל רגליים ארוכות, נצפה זוחל על הידרואידים ועל טחביתנים.",
  "species_sea_lily_name": "שושן ים",
  "species_sea_lily_desc": "קרינואיד מגובעל ומאובן חי המצוי במים עמוקים ומסנן מזון בזרועותיו הנוצתיות.",
  "species_mantis_shrimp_lysiosquilla_name": "חסילון גמל שלמה דוקרן",
  "species_mantis_shrimp_lysiosquilla_desc": "חסילון גמל שלמה גדול וחופר בעל תוספות דוקרניות, מצוי במצעים חוליים.",
  "species_purple_sea_urchin_name": "קיפוד ים סגול",
  "species_purple_sea_urchin_desc": "קיפוד ים סגול ונפוץ המצוי ביערות הקלפ ובשלוליות הסלע של האוקיינוס השקט.",
  "species_crown_jellyfish_name": "מדוזת כתר",
  "species_crown_jellyfish_desc": "מדוזה בסגול עמוק בעלת פעמון מורם דמוי כתר, מצויה בהודו-פסיפי.",
  "species_comb_jelly_name": "דומדמנית ים",
  "species_comb_jelly_desc": "מסרקן זעיר וזוהר-ביולוגית בעל טורי מסרק נוצצים ושתי זרועות ארוכות.",
  "species_warty_sea_slug_name": "חשופית ים יבלולית",
  "species_warty_sea_slug_desc": "חשופית ים בכחול ושחור בעלת יבלות בכיפות צהובות, נצפית לרוב בשוניות ההודו-פסיפי.",
  "species_doris_nudibranch_name": "לימון ים",
  "species_doris_nudibranch_desc": "חשופית ים צהובה ומנוקדת ממשפחת הדורידים, מצויה במים הממוזגים של האוקיינוס השקט וניזונה מספוגים.",
  "species_opalescent_nudibranch_name": "חשופית אופלית",
  "species_opalescent_nudibranch_desc": "חשופית שקופה למחצה ממשפחת האאוליד בעלת בליטות כתומות בוהקות וקווי גב כחולים, במימי האוקיינוס השקט.",
  "species_clown_nudibranch_name": "חשופית ליצן",
  "species_clown_nudibranch_desc": "חשופית ים בגוון ורוד-כתום בעלת נקודות כחולות ולבנות, מצויה במים הממוזגים של אוסטרליה.",
  "species_bottlenose_dolphin_name": "דולפין אף-בקבוק",
  "species_bottlenose_dolphin_desc": "דולפין סקרן ושובב הנפגש תכופות על ידי צוללנים במים טרופיים וממוזגים.",
  "species_spinner_dolphin_name": "דולפין מסתחרר",
  "species_spinner_dolphin_desc": "דולפין אקרובטי הידוע בסיבובי האוויר שלו, נצפה לרוב בעדרים גדולים סמוך לשוניות אלמוגים.",
  "species_common_dolphin_name": "דולפין מצוי",
  "species_common_dolphin_desc": "דולפין מהיר בעל דוגמת שעון חול אופיינית, מצוי באוקיינוס הפתוח ובמים חופיים.",
  "species_spotted_dolphin_name": "דולפין מנוקד אטלנטי",
  "species_spotted_dolphin_desc": "דולפין מנוקד וידידותי המתקרב תכופות לצוללנים באיי בהאמה ובקריביים.",
  "species_rissos_dolphin_name": "דולפין של ריסו",
  "species_rissos_dolphin_desc": "דולפין גדול בעל גוף אפור מצולק היטב, מצוי במים עמוקים ומרוחקים מהחוף בכל העולם.",
  "species_humpback_whale_name": "לווייתן גדול-סנפיר",
  "species_humpback_whale_desc": "לווייתן מלכותי הידוע בקפיצותיו מהמים ובשירים מורכבים, נצפה בנדידות עונתיות.",
  "species_grey_whale_name": "לווייתן אפור",
  "species_grey_whale_desc": "לווייתן מזיפים הניזון מהקרקעית ונודד לאורך חופי האוקיינוס השקט, ולרוב מכוסה בברנקלים.",
  "species_blue_whale_name": "לווייתן כחול",
  "species_blue_whale_desc": "בעל החיים הגדול ביותר שחי אי פעם, נפגש מדי פעם על ידי צוללנים במים כחולים עמוקים.",
  "species_sperm_whale_name": "לווייתן הזרע",
  "species_sperm_whale_desc": "לווייתן צולל עמוק בעל ראש עצום, נצפה לעיתים נח על פני המים בין צלילה לצלילה.",
  "species_orca_name": "לווייתן קטלן",
  "species_orca_desc": "טורף-על בעל סימנים אופייניים בשחור ולבן, מצוי בכל אגני האוקיינוס.",
  "species_minke_whale_name": "לווייתן מינקי",
  "species_minke_whale_desc": "לווייתן מזיפים קטן יחסית המגלה סקרנות כלפי צוללנים, במיוחד בשונית המחסום הגדולה.",
  "species_beluga_whale_name": "בלוגה",
  "species_beluga_whale_desc": "לווייתן ארקטי לבן הידוע בקולותיו ובהתנהגותו החברתית במים קרים.",
  "species_pilot_whale_name": "לווייתן טייס קצר-סנפיר",
  "species_pilot_whale_desc": "לווייתן חברתי הצולל לעומק ונצפה לרוב בעדרים גדולים בימים טרופיים וממוזגים-חמים.",
  "species_false_killer_whale_name": "לווייתן קטלן מדומה",
  "species_false_killer_whale_desc": "דולפין אוקייני גדול המתקרב מדי פעם לצוללנים במים פתוחים.",
  "species_dugong_name": "דוגונג",
  "species_dugong_desc": "אוכל עשב עדין הרועה בערוגות עשב ים בהודו-פסיפי, קרוב משפחה של פרות הים.",
  "species_west_indian_manatee_name": "פרת ים מערב-הודית",
  "species_west_indian_manatee_desc": "אוכל עשב איטי המצוי במים חמים ורדודים, בשפכי נהרות ובמעיינות של הקריביים.",
  "species_sea_otter_name": "לוטרת ים",
  "species_sea_otter_desc": "יונק ימי כריזמטי המצוי ביערות הקלפ לאורך חופי צפון האוקיינוס השקט.",
  "species_california_sea_lion_name": "אריה ים קליפורני",
  "species_california_sea_lion_desc": "יונק סנפירי שובב וזריז המשחק לא פעם עם צוללנים לאורך חופי האוקיינוס השקט.",
  "species_steller_sea_lion_name": "אריה ים של שטלר",
  "species_steller_sea_lion_desc": "מין אריה הים הגדול ביותר, מצוי במים הקרים של צפון האוקיינוס השקט סמוך לחופים סלעיים.",
  "species_harbor_seal_name": "כלב ים נמל",
  "species_harbor_seal_desc": "כלב ים סקרן הנצפה לרוב במים חופיים ממוזגים, ולעיתים נח על סלעים סמוך לאתרי צלילה.",
  "species_grey_seal_name": "כלב ים אפור",
  "species_grey_seal_desc": "כלב ים גדול ושובב המצוי בצפון האוקיינוס האטלנטי, ידוע בהתקרבותו לצוללנים מתחת למים.",
  "species_northern_elephant_seal_name": "פיל ים צפוני",
  "species_northern_elephant_seal_desc": "כלב ים ענק הצולל לעומק רב, ולזכרים חדק גדול; מצוי לאורך חופי מזרח האוקיינוס השקט.",
  "species_hawaiian_monk_seal_name": "כלב ים נזירי הוואי",
  "species_hawaiian_monk_seal_desc": "כלב ים בסכנת הכחדה חמורה האנדמי להוואי, נצפה מדי פעם על ידי צוללנים בשוניות.",
  "species_leopard_seal_name": "כלב ים מנומר",
  "species_leopard_seal_desc": "טורף אנטארקטי רב-עוצמה בעל פרווה מנוקדת, נפגש על ידי צוללני מים קרים.",
  "species_narwhal_name": "נרוול",
  "species_narwhal_desc": "לווייתן ארקטי בעל חט לולייני ארוך, נצפה לעיתים רחוקות אך אייקוני בקרב היונקים הימיים.",
  "species_green_sea_turtle_name": "צב ים ירוק",
  "species_green_sea_turtle_desc": "צב ים גדול הנצפה לרוב רועה עשב ים במים טרופיים.",
  "species_hawksbill_sea_turtle_name": "צב ים חד-מקור",
  "species_hawksbill_sea_turtle_desc": "צב דייר שונית בעל מקור מחודד, ניזון מספוגים בין מבני האלמוגים.",
  "species_loggerhead_sea_turtle_name": "צב ים חום",
  "species_loggerhead_sea_turtle_desc": "צב בעל ראש גדול המצוי בימים ממוזגים וטרופיים, לרוב סמוך לשוניות סלע.",
  "species_leatherback_sea_turtle_name": "צב ים עורי",
  "species_leatherback_sea_turtle_desc": "הצב הגדול ביותר החי כיום, בעל שריון עורי וגמיש, וצולל לעומקים קיצוניים.",
  "species_olive_ridley_sea_turtle_name": "צב ים זיתי",
  "species_olive_ridley_sea_turtle_desc": "מין צב הים הקטן ביותר, ידוע באירועי הטלה המוניים ומתואמים המכונים arribadas.",
  "species_kemps_ridley_sea_turtle_name": "צב ים של קמפ",
  "species_kemps_ridley_sea_turtle_desc": "צב ים בסכנת הכחדה חמורה המצוי בעיקר במפרץ מקסיקו.",
  "species_flatback_sea_turtle_name": "צב ים שטוח-גב",
  "species_flatback_sea_turtle_desc": "אנדמי למים האוסטרליים, ניכר בשריונו השטוח ובבית הגידול החופי שלו.",
  "species_brain_coral_name": "אלמוג מוח",
  "species_brain_coral_desc": "אלמוג בונה שונית מסיבי בעל פני שטח מחורצים המזכירים מוח, נפוץ בשוניות הקריביים.",
  "species_staghorn_coral_name": "אלמוג קרן צבי",
  "species_staghorn_coral_desc": "אלמוג מסועף מהיר צמיחה היוצר סבכים צפופים, בית גידול קריטי לדגי השונית.",
  "species_elkhorn_coral_name": "אלמוג קרן איל",
  "species_elkhorn_coral_desc": "אלמוג מסועף גדול בעל ענפים שטוחים ומורחבים, בונה שונית מרכזי בקריביים.",
  "species_table_coral_name": "אלמוג שולחן",
  "species_table_coral_desc": "אלמוג שטוח היוצר לוחות, מצוי בשוניות ההודו-פסיפי ומספק מחסה למיני דגים רבים.",
  "species_mushroom_coral_name": "אלמוג פטרייה",
  "species_mushroom_coral_desc": "אלמוג בודד וחופשי בצורת דיסקה, מצוי באזורי חול סמוך לשוניות ההודו-פסיפי.",
  "species_bubble_coral_name": "אלמוג בועות",
  "species_bubble_coral_desc": "אלמוג ייחודי בעל שלפוחיות דמויות ענבים המתנפחות ביום כדי לקלוט אור.",
  "species_plate_coral_name": "אלמוג צלחת",
  "species_plate_coral_desc": "אלמוג לוחי דק היוצר מדפים מסולסלים, נפוץ במדרונות השונית של ההודו-פסיפי.",
  "species_pillar_coral_name": "אלמוג עמוד",
  "species_pillar_coral_desc": "אלמוג נדיר הצומח כלפי מעלה ויוצר עמודים גבוהים, מצוי בקריביים.",
  "species_star_coral_name": "אלמוג כוכב",
  "species_star_coral_desc": "בונה שונית מרכזי בקריביים היוצר מושבות גדולות בצורת גוש ופוליפים בצורת כוכב.",
  "species_lettuce_coral_name": "אלמוג חסה",
  "species_lettuce_coral_desc": "אלמוג לוחי דק בעל קפלים דמויי עלים, נפוץ בקירות ובמדרונות השונית בקריביים.",
  "species_finger_coral_name": "אלמוג אצבע",
  "species_finger_coral_desc": "אלמוג מסועף וחסון בעל בליטות עבות דמויות אצבעות, מצוי בשוניות רדודות.",
  "species_massive_porites_name": "אלמוג פוריטס מסיבי",
  "species_massive_porites_desc": "אלמוג גושי גדול שיכול לגדול במשך מאות שנים, בונה שונית דומיננטי בהודו-פסיפי.",
  "species_cauliflower_coral_name": "אלמוג כרובית",
  "species_cauliflower_coral_desc": "אלמוג מסועף וקומפקטי בצורת כרובית, נפוץ ברדודי השוניות הטרופיות.",
  "species_flower_pot_coral_name": "אלמוג עציץ",
  "species_flower_pot_coral_desc": "מושבה של פוליפים ארוכי זרועות הנפרשים ביום ומזכירים זר פרחים.",
  "species_cup_coral_name": "אלמוג גביע כתום",
  "species_cup_coral_desc": "אלמוג כתום בוהק שאינו מבצע פוטוסינתזה, מצוי על קירות ומתחת לגגונים במים טרופיים.",
  "species_scroll_coral_name": "אלמוג מגילה",
  "species_scroll_coral_desc": "אלמוג היוצר לוחות מגולגלים גדולים, נפוץ במדרונות השונית ובלגונות של ההודו-פסיפי.",
  "species_cabbage_coral_name": "אלמוג כרוב",
  "species_cabbage_coral_desc": "אלמוג לוחי בצורת דיסקה המזכיר עלי כרוב, מצוי באזורי שונית מוגנים.",
  "species_hammer_coral_name": "אלמוג פטיש",
  "species_hammer_coral_desc": "אלמוג בעל פוליפים גדולים וקצות זרועות בצורת עוגן או פטיש, פופולרי בשוניות ההודו-פסיפי.",
  "species_torch_coral_name": "אלמוג לפיד",
  "species_torch_coral_desc": "אלמוג מסועף בעל זרועות ארוכות ומתנופפות שקצותיהן זוהרים כנורות.",
  "species_frogspawn_coral_name": "אלמוג ביצי צפרדע",
  "species_frogspawn_coral_desc": "אלמוג בעל פוליפים גדולים וקצות זרועות מסועפים המזכירים ביצי צפרדע.",
  "species_sea_fan_name": "מניפת ים מצויה",
  "species_sea_fan_desc": "גורגוניה שטוחה בצורת מניפה הניצבת בניצב לזרם, אייקונית בשוניות הקריביים.",
  "species_venus_sea_fan_name": "מניפת ים של ונוס",
  "species_venus_sea_fan_desc": "גורגוניה עדינה בצורת מניפה, מצויה בשוניות רדודות בקריביים באזורי זרם מתון.",
  "species_deepwater_sea_fan_name": "מניפת ים של מים עמוקים",
  "species_deepwater_sea_fan_desc": "גורגוניה גדולה ושיחנית המצויה בקירות שונית עמוקים בקריביים.",
  "species_sea_whip_name": "שוט ים",
  "species_sea_whip_desc": "גורגוניה תמירה בצורת מוט, נצפית מתנועעת בזרם בשוניות האטלנטי והקריביים.",
  "species_sea_plume_name": "נוצת ים",
  "species_sea_plume_desc": "גורגוניה גבוהה ונוצתית היוצרת מושבות דמויות נוצה בפסגות השוניות בקריביים.",
  "species_organ_pipe_coral_name": "אלמוג עוגב",
  "species_organ_pipe_coral_desc": "צינורות שלד אדומים בוהקים עם פוליפים עדינים, מצוי בשוניות מוגנות בהודו-פסיפי.",
  "species_leather_coral_name": "אלמוג עור",
  "species_leather_coral_desc": "אלמוג רך בעל פני שטח חלקים ועוריים היוצר מושבות גדולות בצורת פטרייה.",
  "species_toadstool_leather_coral_name": "אלמוג עור פטרייה",
  "species_toadstool_leather_coral_desc": "אלמוג רך בעל גבעול עבה וכיפה שטוחה, נפוץ במישורי השונית של ההודו-פסיפי.",
  "species_pulsing_xenia_name": "קסניה פועמת",
  "species_pulsing_xenia_desc": "אלמוג רך בעל פוליפים הפועמים בקצב, מצוי במים מוגנים בהודו-פסיפי.",
  "species_tree_coral_name": "אלמוג עץ",
  "species_tree_coral_desc": "אלמוג רך ותוסס היוצר אשכולות דמויי עץ על קירות ומתחת לגגונים בים סוף.",
  "species_blue_coral_name": "אלמוג כחול",
  "species_blue_coral_desc": "אלמוג רך ייחודי בעל שלד כחול, מצוי במישורי שונית רדודים בהודו-פסיפי.",
  "species_black_coral_name": "אלמוג שחור",
  "species_black_coral_desc": "אלמוג מים עמוקים בעל שלד כהה, מצוי בקירות ובמדרונות תלולים מתחת ל-30 מטרים.",
  "species_carnation_coral_name": "אלמוג ציפורן",
  "species_carnation_coral_desc": "אלמוג רך וצבעוני להפליא המצוי מתחת למדפי סלע ועל קירות בהודו-פסיפי.",
  "species_wire_coral_name": "אלמוג חוט",
  "species_wire_coral_desc": "אלמוג שחור וארוך היוצר שוטים מסולסלים, ומארח גוביים וחסילונים.",
  "species_dead_mans_fingers_name": "אצבעות המת",
  "species_dead_mans_fingers_desc": "אלמוג רך ובשרני בעל אונות דמויות אצבעות, נפוץ בשוניות ממוזגות בצפון האטלנטי.",
  "species_sun_coral_name": "אלמוג שמש",
  "species_sun_coral_desc": "אלמוג בגוון צהוב-כתום שאינו מבצע פוטוסינתזה ופורש את פוליפיו בלילה על קירות בהודו-פסיפי.",
  "species_lace_coral_name": "אלמוג תחרה",
  "species_lace_coral_desc": "הידרו-אלמוג ורוד ועדין בעל ענפים דמויי תחרה, מצוי בנקיקים ומתחת למדפי סלע.",
  "species_kenya_tree_coral_name": "אלמוג עץ קניה",
  "species_kenya_tree_coral_desc": "אלמוג רך ועמיד בעל ענפים דמויי עץ, נפוץ בהודו-פסיפי.",
  "species_colt_coral_name": "אלמוג סייח",
  "species_colt_coral_desc": "אלמוג רך בעל ענפים עבים וגמישים המכוסים בפוליפים קטנים, בשוניות ההודו-פסיפי.",
  "species_turtle_grass_name": "עשב צבים",
  "species_turtle_grass_desc": "עשב הים הדומיננטי בקריביים, בעל עלים רחבים ושטוחים ומקור מזון חיוני לצבי ים.",
  "species_eelgrass_name": "זוסטרה",
  "species_eelgrass_desc": "עשב ים ממוזג היוצר אחווי מים צפופים המשמשים בית גידול לגידול צאצאים.",
  "species_manatee_grass_name": "עשב פרות ים",
  "species_manatee_grass_desc": "עשב ים בעל עלים גליליים המצוי באזורי חול בקריביים, לרוב סמוך לערוגות עשב צבים.",
  "species_shoal_grass_name": "עשב שרטון",
  "species_shoal_grass_desc": "עשב ים חלוץ בעל עלים צרים המאכלס אזורי חול שהופרו בקריביים.",
  "species_paddle_grass_name": "עשב משוט",
  "species_paddle_grass_desc": "עשב ים קטן ועדין בעל עלים סגלגלים, מצוי במים עמוקים יותר ברחבי האזורים הטרופיים.",
  "species_neptune_grass_name": "עשב נפטון",
  "species_neptune_grass_desc": "עשב ים ים-תיכוני היוצר אחווים נרחבים החיוניים למערכות האקולוגיות של החוף.",
  "species_giant_kelp_name": "קלפ ענק",
  "species_giant_kelp_desc": "מין היוצר יערות תת-מימיים מתנשאים לגובה של עד 60 מטרים, אייקוני לצלילה בקליפורניה.",
  "species_bull_kelp_name": "קלפ שור",
  "species_bull_kelp_desc": "קלפ של האוקיינוס השקט בעל גבעול ארוך יחיד ומצוף בולבוסי, יוצר יערות בעלי חופה צפופה.",
  "species_bladder_wrack_name": "פוקוס שלפוחי",
  "species_bladder_wrack_desc": "אצה חומה נפוצה בעלת שלפוחיות אוויר בזוגות, מצויה באזורי הגאות והשפל של צפון האטלנטי.",
  "species_sargassum_name": "סרגסום",
  "species_sargassum_desc": "אצה חומה צפה חופשית היוצרת רפסודות המספקות מחסה לדגים צעירים ולחסרי חוליות.",
  "species_kelp_forest_ecklonia_name": "קלפ אקלוניה",
  "species_kelp_forest_ecklonia_desc": "הקלפ הדומיננטי במימי חצי הכדור הדרומי, יוצר יערות תת-מימיים חשובים.",
  "species_coralline_algae_name": "אצות גיריות",
  "species_coralline_algae_desc": "אצה אדומה קשה ומצפה המלכדת את מבני השונית ומעניקה לשוניות גוון ורדרד.",
  "species_irish_moss_name": "טחב אירי",
  "species_irish_moss_desc": "אצה אדומה בצורת מניפה המצויה בחופי הסלע של אזור הגאות והשפל בצפון האטלנטי.",
  "species_dulse_name": "דולסה",
  "species_dulse_desc": "אצה שטוחה בגוון אדמדם-סגול הגדלה על סלעים ועל גבעולי קלפ במים צפוניים קרים.",
  "species_halimeda_name": "הלימדה",
  "species_halimeda_desc": "אצה ירוקה מסויידת בעלת פרקים בצורת דיסקה, תורמת מרכזית לחול השונית.",
  "species_sea_lettuce_name": "חסת ים",
  "species_sea_lettuce_desc": "אצה ירוקה בוהקת דמוית יריעה, מצויה במים חופיים רדודים בכל העולם.",
  "species_caulerpa_name": "אצת ענבי ים",
  "species_caulerpa_desc": "אצה ירוקה זוחלת בעלת גבעולונים דמויי ענבים, מצויה על שברי אלמוגים וחול בשוניות טרופיות.",
  "species_mermaid_fan_name": "מניפת בת הים",
  "species_mermaid_fan_desc": "אצה ירוקה מסויידת בצורת מניפה קטנה, נפוצה בקרקעיות החול של הקריביים.",
  "species_shaving_brush_algae_name": "אצת מברשת גילוח",
  "species_shaving_brush_algae_desc": "אצה ירוקה מסויידת בעלת ציצית דמוית מברשת על גבעול, מצויה בקרקעיות החול של הקריביים.",
  "species_finger_kelp_name": "אצת משוט",
  "species_finger_kelp_desc": "אצה חומה בעלת גבעולונים דמויי אצבעות היוצרת ערוגות קלפ במים החופיים של צפון האטלנטי.",
  "species_banded_sea_krait_name": "נחש ים מפוספס",
  "species_banded_sea_krait_desc": "נחש ים ארסי בעל טבעות בכחול-אפור ושחור, נוח אופי ונצפה לרוב בשוניות ההודו-פסיפי.",
  "species_olive_sea_snake_name": "נחש ים זיתי",
  "species_olive_sea_snake_desc": "נחש ים סקרן המצוי בשוניות אוסטרליה, ידוע בהתקרבותו לצוללנים.",
  "species_yellow_bellied_sea_snake_name": "נחש ים צהוב-בטן",
  "species_yellow_bellied_sea_snake_desc": "נחש ים פלגי בעל בטן צהובה, מין הנחשים הנפוץ ביותר בעולם.",
  "species_marine_iguana_name": "איגואנה ימית",
  "species_marine_iguana_desc": "אנדמית לאיי גלפגוס, והלטאה היחידה המלקטת אצות מתחת למים.",
  "species_saltwater_crocodile_name": "תנין ימי",
  "species_saltwater_crocodile_desc": "הזוחל הגדול ביותר החי כיום, מצוי במים חופיים ובשפכי נהרות בהודו-פסיפי.",
