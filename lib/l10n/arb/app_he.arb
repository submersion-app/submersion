  "species_marbled_electric_ray_desc": "טריגון חשמלי ים-תיכוני בעל דוגמת שיש, ומכת החשמל שלו מורגשת היטב.",
  "species_giant_guitarfish_name": "דג גיטרה ענק",
  "species_giant_guitarfish_desc": "טריגון בעל צורת כריש המצוי בקרקעיות חול בהודו-פסיפי סמוך לשוניות אלמוגים.",
  "species_shovelnose_guitarfish_name": "דג גיטרה חוטם-את",
  "species_shovelnose_guitarfish_desc": "בעל מבנה שטוח המשלב מראה של כריש וטריגון, נפוץ ברדודי החול של מזרח האוקיינוס השקט.",
  "species_smalltooth_sawfish_name": "דג מסור קטן-שיניים",
  "species_smalltooth_sawfish_desc": "טריגון בסכנת הכחדה חמורה בעל מסור משונן בקדמת הראש, מצוי במים חופיים טרופיים.",
  "species_green_sawfish_name": "דג מסור ירוק",
  "species_green_sawfish_desc": "דג מסור גדול בעל גוף ירוק-זית, החי בשפכי נהרות בהודו-מערב פסיפי.",
  "species_devil_ray_name": "טריגון שטן ענק",
  "species_devil_ray_desc": "מובולה גדולה בעלת סנפירי ראש, נצפית קופצת מהמים בקבוצות.",
  "species_spinetail_devil_ray_name": "טריגון שטן קוץ-זנב",
  "species_spinetail_devil_ray_desc": "טריגון שטן פלגי הנצפה לעיתים קרובות בהתקהלויות גדולות סמוך לפני המים.",
  "species_lesser_devil_ray_name": "טריגון שטן גמדי",
  "species_lesser_devil_ray_desc": "מין המובולה הקטן ביותר, יוצר להקות גדולות במפרץ קליפורניה.",
  "species_bat_ray_name": "טריגון עטלף",
  "species_bat_ray_desc": "טריגון בצורת מעוין, נפוץ ביערות הקלפ ובמפרצי החול של קליפורניה.",
  "species_undulate_ray_name": "טריגון גלי",
  "species_undulate_ray_desc": "טריגון בעל דוגמת קווים גליים יפהפייה, מצוי במזרח האוקיינוס האטלנטי.",
  "species_thornback_ray_name": "טריגון קוצני",
  "species_thornback_ray_desc": "טריגון אירופי נפוץ בעל קוצים חדים לאורך הגב והזנב.",
  "species_cownose_ray_name": "טריגון אף-פרה",
  "species_cownose_ray_desc": "ניכר בראשו המחורץ, ונצפה לרוב בלהקות גדולות בעת נדידות עונתיות.",
  "species_marble_ray_name": "טריגון משויש",
  "species_marble_ray_desc": "טריגון כהה וגדול בעל נקודות לבנות, נצפה תכופות בתחנות ניקוי בהודו-פסיפי.",
  "species_ocellate_river_stingray_name": "טריגון נהרות עינוני",
  "species_ocellate_river_stingray_desc": "טריגון מים מתוקים בעל נקודות מוקפות טבעות כתומות בולטות, מקורו בנהרות דרום אמריקה.",
  "species_ocellaris_clownfish_name": "דג ליצן מצוי",
  "species_ocellaris_clownfish_desc": "דג קטן בפסים כתומים ולבנים החי בסימביוזה עם שושנות ים בשוניות אלמוגים.",
  "species_clarkii_clownfish_name": "דג ליצן של קלארק",
  "species_clarkii_clownfish_desc": "דג שושנון עמיד בעל גוף כהה ושני פסים לבנים, מצוי ברחבי ההודו-פסיפי במגוון מיני שושנות ים.",
  "species_tomato_clownfish_name": "דג ליצן עגבנייה",
  "species_tomato_clownfish_desc": "דג שושנון בגוון אדום-כתום עז עם פס לבן יחיד בראש, נפוץ בשוניות ההודו-פסיפי.",
  "species_regal_blue_tang_name": "דג כירורג כחול מלכותי",
  "species_regal_blue_tang_desc": "דג כירורג בכחול עז בעל סימן שחור דמוי לוח צבעים וזנב צהוב, מצוי בשוניות האלמוגים של ההודו-פסיפי.",
  "species_yellow_tang_name": "דג כירורג צהוב",
  "species_yellow_tang_desc": "דג כירורג בצהוב עז הנפוץ בשוניות הוואי והאוקיינוס השקט, נצפה לרוב רועה אצות בקבוצות.",
  "species_powder_blue_surgeonfish_name": "דג כירורג תכול",
  "species_powder_blue_surgeonfish_desc": "דג כירורג תכול ומרשים בעל פנים שחורות וסנפיר גב צהוב, מצוי באוקיינוס ההודי.",
  "species_sohal_surgeonfish_name": "דג כירורג ים סוף",
  "species_sohal_surgeonfish_desc": "דג כירורג מפוספס ונועז בעל קוץ אזמל כתום, אנדמי לשוניות ים סוף והמפרץ הערבי.",
  "species_blue_tang_name": "דג כירורג כחול",
  "species_blue_tang_desc": "דג כירורג בגוון כחול עמוק הנפוץ בשוניות הקריביים; הצעירים צהובים בוהקים.",
  "species_emperor_angelfish_name": "דג מלאך קיסרי",
  "species_emperor_angelfish_desc": "דג מלאך גדול בעל פסים אופקיים כחולים וצהובים מרשימים; הצעירים מציגים מעגלים קונצנטריים כחולים ולבנים.",
  "species_french_angelfish_name": "דג מלאך צרפתי",
  "species_french_angelfish_desc": "דג מלאך גדול וכהה בעל קשקשים משוליים בזהב, נצפה לרוב בזוגות בשוניות הקריביים ומערב האטלנטי.",
  "species_queen_angelfish_name": "דג מלאך מלכה",
  "species_queen_angelfish_desc": "דג מלאך מרהיב בכחול וצהוב בעל כתם כתר אופייני, מצוי בשוניות האלמוגים של הקריביים.",
  "species_regal_angelfish_name": "דג מלאך מלכותי",
  "species_regal_angelfish_desc": "דג מלאך אלגנטי בעל פסים אנכיים לסירוגין בכתום-לבן ובכחול, מצוי בשוניות ההודו-פסיפי.",
  "species_rock_beauty_name": "יפהפיית הסלעים",
  "species_rock_beauty_desc": "דג מלאך קריבי מרשים שחציו הקדמי צהוב וחציו האחורי שחור, מצוי ליד שוניות סלע ומדפי סלע.",
  "species_gray_angelfish_name": "דג מלאך אפור",
  "species_gray_angelfish_desc": "דג מלאך אפור וגדול בעל פנים בהירות וצדם הפנימי הצהוב של סנפירי החזה, נפוץ בשוניות הקריביים.",
  "species_copperband_butterflyfish_name": "דג פרפר נחושת-פסים",
  "species_copperband_butterflyfish_desc": "דג פרפר ייחודי בעל פסים אנכיים כתומים וחרטום מוארך, מצוי בשוניות ההודו-פסיפי.",
  "species_raccoon_butterflyfish_name": "דג פרפר רקון",
  "species_raccoon_butterflyfish_desc": "דג פרפר צהוב בעל מסכת עיניים כהה דמוית רקון, נפוץ בשוניות ההודו-פסיפי והוואי.",
  "species_longnose_butterflyfish_name": "דג פרפר ארוך-חרטום",
  "species_longnose_butterflyfish_desc": "דג פרפר צהוב בוהק בעל חרטום ארוך במיוחד שבעזרתו הוא לוקט מזון מנקיקים בשוניות ההודו-פסיפי.",
  "species_threadfin_butterflyfish_name": "דג פרפר חוטי-סנפיר",
  "species_threadfin_butterflyfish_desc": "דג פרפר לבן בעל דוגמת שברונים וחוט נגרר בסנפיר הגב, נפוץ ברחבי ההודו-פסיפי.",
  "species_foureye_butterflyfish_name": "דג פרפר ארבע-עיניים",
  "species_foureye_butterflyfish_desc": "דג פרפר בהיר בעל כתם עין מדומה בולט סמוך לזנב, נפוץ בשוניות הקריביים.",
  "species_spotfin_butterflyfish_name": "דג פרפר מנוקד-סנפיר",
  "species_spotfin_butterflyfish_desc": "דג פרפר לבן-צהוב בעל כתם כהה קטן על סנפיר הגב, מצוי במערב האוקיינוס האטלנטי.",
  "species_banner_butterflyfish_name": "דגלן ים סוף",
  "species_banner_butterflyfish_desc": "דגלן שחור-לבן בעל סנפיר גב מוארך ובטן צהובה, אנדמי לים סוף.",
  "species_moorish_idol_name": "אליל מורי",
  "species_moorish_idol_desc": "דג שונית אייקוני בעל פסים נועזים בשחור, לבן וצהוב וחוט ארוך נגרר בסנפיר הגב.",
  "species_green_moray_eel_name": "מורנה ירוקה",
  "species_green_moray_eel_desc": "מורנה ירוקה גדולה המגיעה ל-2.5 מטר, נצפית לרוב בפה פעור בנקיקי שונית ברחבי מערב האטלנטי.",
  "species_giant_moray_eel_name": "מורנה ענקית",
  "species_giant_moray_eel_desc": "מין המורנה הגדול ביותר, מגיע ליותר מ-3 מטרים ומעוטר בכתמים דמויי נמר, ומצוי בשוניות האלמוגים של ההודו-פסיפי.",
  "species_spotted_moray_eel_name": "מורנה מנוקדת",
  "species_spotted_moray_eel_desc": "מורנה לבנה בעלת נקודות חום כהה, נצפית לרוב מציצה מחורי השונית בקריביים.",
  "species_ribbon_eel_name": "צלופח סרט",
  "species_ribbon_eel_desc": "צלופח תמיר בעל נחיריים מתרחבים; הזכרים כחולים עזים והנקבות צהובות, והוא מצוי בלגונות חול בהודו-פסיפי.",
  "species_spotted_garden_eel_name": "צלופח גן מנוקד",
  "species_spotted_garden_eel_desc": "צלופח דק ולבן בנקודות שחורות החי במושבות בקרקעית חול ומתנועע בזרם כדי ללכוד פלנקטון.",
  "species_splendid_garden_eel_name": "צלופח גן מפואר",
  "species_splendid_garden_eel_desc": "צלופח גן בפסים כתומים ולבנים, מצוי במושבות חול גדולות במערב האוקיינוס השקט.",
  "species_snowflake_moray_name": "מורנת פתית שלג",
  "species_snowflake_moray_desc": "מורנה קטנה בעלת גוף לבן וסימנים שחורים דמויי פתיתי שלג, נפוצה בשברי אלמוגים בהודו-פסיפי.",
  "species_mandarin_dragonet_name": "דרקונית מנדרין",
  "species_mandarin_dragonet_desc": "דג זעיר וצבעוני להפליא בדוגמאות פסיכדליות של כחול וכתום, מצוי באזורי שברי אלמוגים במערב האוקיינוס השקט.",
  "species_common_lionfish_name": "דג אריה מצוי",
  "species_common_lionfish_desc": "דג עקרב ארסי בעל סנפירי חזה מרהיבים דמויי מניפה ופסים אדומים ולבנים, ומין פולש בקריביים.",
  "species_leaf_scorpionfish_name": "דג עקרב עלה",
  "species_leaf_scorpionfish_desc": "דג עקרב שטוח מאוד בצורת עלה, מתנועע עם הזרם כדי להיראות כשריד צמחי נסחף בשוניות ההודו-פסיפי.",
  "species_stonefish_name": "דג אבן",
  "species_stonefish_desc": "הדג הארסי ביותר בעולם, מוסווה להפליא כסלע על קרקעיות השונית בהודו-פסיפי ומסוכן ביותר.",
  "species_painted_frogfish_name": "דג צפרדע מצויר",
  "species_painted_frogfish_desc": "טורף מארב מגושם בעל פתיון על ראשו, צבעו משתנה מאוד, והוא מצוי בשוניות ההודו-פסיפי.",
  "species_giant_frogfish_name": "דג צפרדע ענק",
  "species_giant_frogfish_desc": "מין דג הצפרדע הגדול ביותר, מגיע ל-40 ס\"מ ומצטיין בהסוואה בין ספוגים ושברי אלמוגים.",
  "species_hairy_frogfish_name": "דג צפרדע שעיר",
  "species_hairy_frogfish_desc": "דג צפרדע המכוסה בתוספות בשרניות דמויות תולעים המחקות אצות, מציאה נחשקת לצלמי תת-מים.",
  "species_clown_triggerfish_name": "דג הדק ליצן",
  "species_clown_triggerfish_desc": "דג הדק בעל דוגמה נועזת של נקודות לבנות גדולות על גוף כהה ושפתיים צהובות, מצוי בשוניות ההודו-פסיפי.",
  "species_titan_triggerfish_name": "דג הדק טיטאן",
  "species_titan_triggerfish_desc": "דג הדק גדול ותוקפני הידוע בהסתערות על צוללנים בקרבת הקן שלו, ונפוץ בשוניות האלמוגים של ההודו-פסיפי.",
  "species_queen_triggerfish_name": "דג הדק מלכותי",
  "species_queen_triggerfish_desc": "דג הדק קריבי צבעוני בעל סימנים כחולים בפנים וסרטי זנב ארוכים.",
  "species_picasso_triggerfish_name": "דג הדק פיקאסו",
  "species_picasso_triggerfish_desc": "דג הדק בעל דוגמה מופשטת של פסים כחולים, צהובים ושחורים, נפוץ במישורי השונית של ההודו-פסיפי.",
  "species_yellowmargin_triggerfish_name": "דג הדק צהוב-שוליים",
  "species_yellowmargin_triggerfish_desc": "דג הדק גדול בגוון חום בהיר ובעל סנפירים משוליים בצהוב, ידוע בשמירה תוקפנית על הקן בשוניות ההודו-פסיפי.",
  "species_porcupinefish_name": "דג דורבן",
  "species_porcupinefish_desc": "דג קוצני גדול המתנפח לכדור כשהוא מאוים, מצוי בשוניות טרופיות בכל העולם.",
  "species_guineafowl_pufferfish_name": "דג נפוח פנינייה",
  "species_guineafowl_pufferfish_desc": "דג נפוח כהה המכוסה בנקודות לבנות קטנות, ולעיתים מופיע בגוון זהוב-צהוב בשוניות ההודו-פסיפי.",
  "species_map_pufferfish_name": "דג נפוח מפה",
  "species_map_pufferfish_desc": "דג נפוח בהיר וגדול בעל סימנים כהים ומורכבים דמויי מפה על גופו, מצוי בשוניות ההודו-פסיפי.",
  "species_sharpnose_pufferfish_name": "דג נפוח חד-חרטום",
  "species_sharpnose_pufferfish_desc": "דג נפוח זעיר בעל קווים כחולים בפנים וזנב כתום, נצפה לרוב בשוניות הקריביים.",
  "species_boxfish_name": "דג קופסה צהוב",
  "species_boxfish_desc": "הצעירים הם קוביות צהובות בוהקות בנקודות שחורות והבוגרים מכהים לכחול-אפור, והמין מצוי ברחבי ההודו-פסיפי.",
  "species_cowfish_name": "דג פרה ארוך-קרניים",
  "species_cowfish_desc": "דג צהוב ומרובע בעל בליטות אופייניות דמויות קרניים מעל כל עין, מצוי בשוניות ההודו-פסיפי.",
  "species_napoleon_wrasse_name": "דג נפוליאון",
  "species_napoleon_wrasse_desc": "דג נסיכה ענק המגיע ל-2 מטרים ובעל גבשושית מצח בולטת, נמצא בסכנת הכחדה ומוגן, ומצוי בשוניות ההודו-פסיפי.",
  "species_cleaner_wrasse_name": "דג מנקה כחול-פס",
  "species_cleaner_wrasse_desc": "דג נסיכה קטן בפס כחול המפעיל תחנות ניקוי ומסיר טפילים מדגים גדולים ממנו בשוניות ההודו-פסיפי.",
  "species_yellowtail_coris_name": "קוריס צהוב-זנב",
  "species_yellowtail_coris_desc": "דג נסיכה צבעוני בעל גוף מנוקד וזנב צהוב; הצעירים כתומים-אדומים בוהקים עם סימנים לבנים.",
  "species_bluehead_wrasse_name": "דג נסיכה כחול-ראש",
  "species_bluehead_wrasse_desc": "דג נסיכה נפוץ בקריביים; לזכרים הבוגרים ראש כחול עז וגוף ירוק עם פסים שחורים ולבנים.",
  "species_spanish_hogfish_name": "דג חזיר ספרדי",
  "species_spanish_hogfish_desc": "דג נסיכה סגול-צהוב הנפוץ בשוניות הקריביים; הצעירים משמשים כדגי ניקוי.",
  "species_bumphead_parrotfish_name": "דג תוכי גבנוני",
  "species_bumphead_parrotfish_desc": "מין דג התוכי הגדול ביותר, מגיע ל-1.3 מטר ובעל גבשושית מצח עצומה, ונע בלהקות בשוניות ההודו-פסיפי.",
  "species_stoplight_parrotfish_name": "דג תוכי רמזור",
  "species_stoplight_parrotfish_desc": "דג תוכי נפוץ בקריביים שצבעיו משתנים באופן דרמטי בין שלב הצעירות לשלב הבגרות.",
  "species_queen_parrotfish_name": "דג תוכי מלכותי",
  "species_queen_parrotfish_desc": "דג תוכי גדול בגוון כחול-ירוק המצוי בשוניות הקריביים, ונצפה לרוב נוגס באלמוגים כדי לאכול אצות.",
  "species_yellowtail_damselfish_name": "דג עלמה צהוב-זנב",
  "species_yellowtail_damselfish_desc": "דג עלמה כחול כהה בעל זנב צהוב בוהק, נפוץ בפסגות שוניות הקריביים.",
  "species_sergeant_major_name": "דג סמל",
  "species_sergeant_major_desc": "דג עלמה כסוף-צהוב בעל חמישה פסים שחורים בולטים, מצוי בהתקהלויות גדולות בשוניות האטלנטי הטרופי.",
  "species_three_spot_damselfish_name": "דג עלמה תלת-נקודה",
  "species_three_spot_damselfish_desc": "דג עלמה חום כהה וטריטוריאלי המגן בתוקפנות על גינת האצות שלו בשוניות הקריביים.",
  "species_chromis_viridis_name": "כרומיס כחול-ירוק",
  "species_chromis_viridis_desc": "דג עלמה ירוק ונוצץ קטן הנצפה בלהקות גדולות המרחפות מעל אלמוגים מסועפים בשוניות ההודו-פסיפי.",
  "species_blue_chromis_name": "כרומיס כחול",
  "species_blue_chromis_desc": "דג עלמה כחול וזוהר הניזון מפלנקטון, מצוי בהתקהלויות גדולות באמצע המים מעל קירות השונית בקריביים.",
  "species_nassau_grouper_name": "דקר נסאו",
  "species_nassau_grouper_desc": "דקר קריבי גדול בעל פס עין כהה אופייני ודוגמת פסים, וכיום בסכנת הכחדה בשל דיג יתר.",
  "species_giant_grouper_name": "דקר ענק",
  "species_giant_grouper_desc": "דג השונית הגרמי הגדול ביותר, מגיע ל-2.7 מטרים ו-400 ק\"ג, ומצוי במערות ובספינות טרופות ברחבי ההודו-פסיפי.",
  "species_coral_grouper_name": "דקר אלמוגים",
  "species_coral_grouper_desc": "דקר בגוון אדום-כתום בוהק המכוסה בנקודות כחולות, מין מובהק של שוניות האלמוגים בהודו-פסיפי.",
  "species_goliath_grouper_name": "דקר גוליית",
  "species_goliath_grouper_desc": "דקר אטלנטי ענק המגיע ל-2.5 מטרים, נפגש לרוב סמוך לספינות טרופות ולמדפי סלע בפלורידה ובקריביים.",
  "species_potato_grouper_name": "דקר תפוח אדמה",
  "species_potato_grouper_desc": "דקר גדול וידידותי בעל כתמים כהים בצורת תפוח אדמה, מפורסם באתר קוד הול שבשונית המחסום הגדולה.",
  "species_peacock_grouper_name": "דקר טווס",
  "species_peacock_grouper_desc": "דקר חום כהה בעל נקודות כחולות בוהקות ופסים אנכיים בהירים בחלקו האחורי, נפוץ בשוניות ההודו-פסיפי.",
  "species_yellowfin_tuna_name": "טונה צהובת-סנפיר",
  "species_yellowfin_tuna_desc": "טורף פלגי מהיר בעל סנפירי גב ופי הטבעת צהובים וארוכים, נצפה מדי פעם על ידי צוללנים באתרים מרוחקים מהחוף.",
  "species_dogtooth_tuna_name": "טונה שיני-כלב",
  "species_dogtooth_tuna_desc": "טונה חזקה הקשורה לשוניות ובעלת שיניים בולטות, נפגשת במדרונות שונית עמוקים בהודו-פסיפי.",
  "species_great_barracuda_name": "ברקודה גדולה",
  "species_great_barracuda_desc": "טורף כסוף וחלקלק באורך של עד 1.8 מטרים בעל שיניים בולטות, נצפה לרוב מרחף ללא תנועה סמוך לשוניות טרופיות.",
  "species_blackfin_barracuda_name": "ברקודה שחורת-סנפיר",
  "species_blackfin_barracuda_desc": "ברקודה הודו-פסיפית הידועה בלהקות ענק דמויות טורנדו באתרי צלילה כמו ברקודה פוינט.",
  "species_mahi_mahi_name": "מהי-מהי",
  "species_mahi_mahi_desc": "דג פלגי מסנוור בגוני כחול-ירוק וזהב בעל מצח קהה, נצפה מדי פעם באתרי צלילה מרוחקים מהחוף.",
  "species_giant_trevally_name": "טרוואלי ענק",
  "species_giant_trevally_desc": "טורף כסוף רב-עוצמה באורך של עד 1.7 מטרים, ידוע בציד בתעלות ובמדרונות שונית ברחבי ההודו-פסיפי.",
  "species_bluefin_trevally_name": "טרוואלי כחול-סנפיר",
  "species_bluefin_trevally_desc": "טרוואלי חלקלק בנקודות כחולות הנצפה לרוב סורק את שולי השוניות בהודו-פסיפי בקבוצות ציד קטנות.",
  "species_bigeye_trevally_name": "טרוואלי גדול-עין",
  "species_bigeye_trevally_desc": "טרוואלי כסוף בעל עיניים גדולות היוצר להקות מסתחררות ומרשימות סמוך לקירות שונית ולתחנות ניקוי.",
  "species_bar_jack_name": "ג'ק מפוספס",
  "species_bar_jack_desc": "ג'ק קריבי כסוף וחלקלק בעל פס כחול כהה אופייני לאורך הגב ועד לאונה התחתונה של הזנב.",
  "species_horse_eye_jack_name": "ג'ק עין-סוס",
  "species_horse_eye_jack_desc": "ג'ק כסוף בעל עיניים גדולות היוצר להקות סמוך לשוניות ולספינות טרופות בקריביים ובמערב האטלנטי.",
  "species_yellowtail_snapper_name": "לוציאן צהוב-זנב",
  "species_yellowtail_snapper_desc": "לוציאן חלקלק בעל פס וזנב צהובים, נצפה לרוב בלהקות באמצע המים בשוניות הקריביים.",
  "species_schoolmaster_snapper_name": "לוציאן מורה",
  "species_schoolmaster_snapper_desc": "לוציאן צהוב-כסוף בעל קווים כחולים מתחת לעין, מצוי בקבוצות מתחת למדפי סלע בשוניות הקריביים.",
  "species_bluestripe_snapper_name": "לוציאן כחול-פסים",
  "species_bluestripe_snapper_desc": "לוציאן צהוב בוהק בעל ארבעה פסים כחולים אופקיים, יוצר להקות צפופות בשוניות ההודו-פסיפי.",
  "species_twinspot_snapper_name": "לוציאן דו-כתמי",
  "species_twinspot_snapper_desc": "לוציאן אדום גדול המצוי בשוניות חיצוניות בהודו-פסיפי, ולעיתים יוצר להקות בקירות עמוקים ובתעלות.",
  "species_humphead_snapper_name": "לוציאן חצות",
  "species_humphead_snapper_desc": "לוציאן כהה וגדול המצוי בלהקות ליד מדרונות תלולים בהודו-פסיפי; הצעירים שחורים ולבנים בניגוד חד.",
  "species_longfin_bannerfish_name": "דגלן ארוך-סנפיר",
  "species_longfin_bannerfish_desc": "דג שחור-לבן בעל סנפיר גב ארוך ונגרר וזנב צהוב, נצפה לרוב בזוגות בשוניות ההודו-פסיפי.",
  "species_batfish_orbicular_name": "דג עטלף עגול",
  "species_batfish_orbicular_desc": "דג כסוף בצורת דיסקה בעל סנפירים גבוהים המתקרב לצוללנים בסקרנות, נפוץ בספינות טרופות ובשוניות בהודו-פסיפי.",
  "species_batfish_teira_name": "דג עטלף ארוך-סנפיר",
  "species_batfish_teira_desc": "דג עטלף בעל סנפירים גבוהים וכתם כהה סמוך לסנפיר החזה, נצפה לרוב בתחנות ניקוי ובספינות טרופות.",
  "species_batfish_pinnatus_name": "דג עטלף מכונף",
  "species_batfish_pinnatus_desc": "הצעירים שחורים כפחם עם שוליים כתומים עזים המזכירים תולעת שטוחה רעילה, והמין מצוי במערב האוקיינוס השקט.",
  "species_banggai_cardinalfish_name": "דג חשמן בנגאי",
  "species_banggai_cardinalfish_desc": "דג חשמן מרשים בכסוף ושחור בעל סנפירים מוארכים, אנדמי לאיי בנגאי שבאינדונזיה.",
  "species_pajama_cardinalfish_name": "דג חשמן פיג'מה",
  "species_pajama_cardinalfish_desc": "דג חשמן יוצא דופן בעל פנים צהובות, פס מותניים כהה וחלק אחורי מנוקד, מצוי בין אלמוגים בהודו-פסיפי.",
  "species_longnose_hawkfish_name": "דג נץ ארוך-חרטום",
  "species_longnose_hawkfish_desc": "דג לבן קטן בעל דוגמת רשת אדומה וחרטום מוארך, נח על גורגוניות ואלמוגים שחורים.",
  "species_arc_eye_hawkfish_name": "דג נץ קשת-עין",
  "species_arc_eye_hawkfish_desc": "דג נץ קטן בעל קשת כתומה אופיינית מאחורי העין, נח לרוב על ראשי אלמוג בשוניות ההודו-פסיפי.",
  "species_flame_hawkfish_name": "דג נץ להבה",
  "species_flame_hawkfish_desc": "דג נץ אדום זוהר בעל סימנים כהים סביב העין, נח בין אלמוגי Pocillopora ברחבי מערב האוקיינוס השקט.",
  "species_fire_goby_name": "גובי אש",
  "species_fire_goby_desc": "גובי לבן אלגנטי בעל סנפיר גב קדמי גבוה וזנב אדום-כתום, מרחף מעל שברי אלמוגים בהודו-פסיפי.",
  "species_purple_firefish_name": "דג אש סגול",
  "species_purple_firefish_desc": "גובי עדין בעל סנפירים סגולים וקוץ גב גבוה, מרחף סמוך למחילות בשוניות החיצוניות של ההודו-פסיפי.",
  "species_yellownose_goby_name": "גובי צהוב-חרטום",
  "species_yellownose_goby_desc": "גובי מנקה קריבי זעיר בעל חרטום צהוב ופס צדדי כחול, מצוי על ספוגים וראשי אלמוג.",
  "species_citron_goby_name": "גובי לימוני",
  "species_citron_goby_desc": "גובי זעיר בצהוב בוהק החי בין ענפי אלמוגי Acropora בשוניות ההודו-פסיפי.",
  "species_shrimp_goby_name": "גובי חסילונים של שטייניץ",
  "species_shrimp_goby_desc": "גובי בגוון חול החולק מחילה עם חסילון אלפאידי ביחסי גומלין, במישורי החול של ההודו-פסיפי.",
  "species_neon_goby_name": "גובי ניאון",
  "species_neon_goby_desc": "גובי כהה וזעיר בעל פס כחול ניאוני זוהר, מפעיל תחנות ניקוי על ראשי אלמוג בקריביים.",
  "species_bluestriped_fangblenny_name": "בלני ניבים כחול-פס",
  "species_bluestriped_fangblenny_desc": "בלני קטן בפס כחול המחקה דגי ניקוי כדי לנשוך קשקשים מדגים תמימים.",
  "species_sailfin_blenny_name": "בלני מפרשי",
  "species_sailfin_blenny_desc": "בלני קריבי זעיר המרים סנפיר גב גדול דמוי מפרש מתוך מחילתו כדי למשוך בנות זוג.",
  "species_bicolor_blenny_name": "בלני דו-גוני",
  "species_bicolor_blenny_desc": "בלני קטן שחציו הקדמי חום כהה וחציו האחורי כתום, מציץ מחורים בשוניות ההודו-פסיפי.",
  "species_redlip_blenny_name": "בלני אדום-שפתיים",
  "species_redlip_blenny_desc": "בלני כהה בעל שפתיים אדומות-כתומות בולטות המגן על כתמי אצות בפסגות השוניות בקריביים.",
  "species_pygmy_seahorse_name": "סוסון ים גמדי של ברגיבנט",
  "species_pygmy_seahorse_desc": "סוסון ים זעיר באורך של פחות מ-2 ס\"מ המתמזג באופן מושלם עם הגורגוניה המארחת, נושא מבוקש לצילומי מאקרו.",
  "species_common_seahorse_name": "סוסון ים מצוי",
  "species_common_seahorse_desc": "סוסון ים בינוני המצוי בערוגות עשב ים ובשברי אלמוגים ברחבי ההודו-פסיפי, וצבעו משתנה.",
  "species_thorny_seahorse_name": "סוסון ים קוצני",
  "species_thorny_seahorse_desc": "סוסון ים המכוסה בקוצים ארוכים, מצוי בערוגות עשב ים ובקרקעיות רכות ברחבי ההודו-פסיפי.",
  "species_ornate_ghost_pipefish_name": "דג צינור רפאים מקושט",
  "species_ornate_ghost_pipefish_desc": "דג צינור מוסווה להפליא המרחף עם הראש כלפי מטה סמוך לקרינואידים ולאלמוגים רכים בהודו-פסיפי.",
  "species_robust_ghost_pipefish_name": "דג צינור רפאים חסון",
  "species_robust_ghost_pipefish_desc": "דג צינור רפאים גדול המחקה עשב ים או אצות, ונמצא לרוב בזוגות במים חופיים בהודו-פסיפי.",
  "species_trumpetfish_name": "דג חצוצרה",
  "species_trumpetfish_desc": "דג ארוך ותמיר הצד בהסתתרות בצל דגים גדולים, מצוי בשוניות הקריביים והאטלנטי במגוון צבעים.",
  "species_cornetfish_name": "דג חליל",
  "species_cornetfish_desc": "דג מוארך במיוחד באורך של עד 1.5 מטרים בעל חוט זנב נגרר, נצפה לרוב גולש מעל מישורי שונית.",
  "species_yellowhead_jawfish_name": "דג לסת צהוב-ראש",
  "species_yellowhead_jawfish_desc": "דג קטן בעל גוף כחול וראש צהוב המרחף מעל מחילת החול שלו בשוניות הקריביים, והזכרים דוגרים על הביצים בפיהם.",
  "species_flamefish_name": "דג להבה",
  "species_flamefish_desc": "דג חשמן קטן ואדום בוהק בעל כתם כהה מתחת לסנפיר הגב השני, מסתתר בנקיקי שונית בקריביים במשך היום.",
  "species_longspine_squirrelfish_name": "דג סנאי ארוך-קוץ",
  "species_longspine_squirrelfish_desc": "דג לילי אדום בעל עיניים גדולות וקוץ גב ארוך, מצוי ביום מתחת למדפי סלע בשוניות הקריביים.",
  "species_soldierfish_name": "דג חייל גדול-קשקש",
  "species_soldierfish_desc": "דג לילי אדום בעל עיניים כהות ענקיות וקשקשים גדולים, מתקבץ ביום במערות ומתחת לגגונים.",
  "species_flame_angelfish_name": "דג מלאך להבה",
  "species_flame_angelfish_desc": "דג מלאך ננסי באדום-כתום זוהר בעל פסים אנכיים שחורים וסנפירים כחולי-קצה, מצוי ברחבי האוקיינוס השקט.",
  "species_royal_gramma_name": "גרמה מלכותית",
  "species_royal_gramma_desc": "דג בסלט קריבי קטן ודו-גוני שחציו הקדמי סגול וחציו האחורי צהוב, מצוי מתחת למדפי סלע.",
  "species_anthias_lyretail_name": "אנתיאס נבל-זנב",
  "species_anthias_lyretail_desc": "דג שונית נפוץ היוצר ענני כתום וורוד גדולים מעל מבני אלמוג בהודו-פסיפי, והזכרים סגולים.",
  "species_mediterranean_grouper_name": "לוקוס",
  "species_mediterranean_grouper_desc": "דקר גדול בחום כהה עם כתמים בהירים, הטורף האייקוני של שוניות הסלע בים התיכון.",
  "species_mediterranean_moray_name": "מורנה ים-תיכונית",
  "species_mediterranean_moray_desc": "מורנה בחום כהה עם כתמים צהובים, נצפית לרוב מציצה מנקיקי סלע בים התיכון.",
  "species_ornate_wrasse_name": "דג נסיכה מקושט",
  "species_ornate_wrasse_desc": "דג נסיכה ירוק וצבעוני בעל סימנים אדומים בראש, אחד מדגי הנסיכה הנפוצים ביותר בשוניות הים התיכון.",
  "species_red_sea_bannerfish_name": "דג פרפר ממוסך",
  "species_red_sea_bannerfish_desc": "דג פרפר צהוב בוהק בעל כתם עין כהה, אנדמי לים סוף ונצפה לרוב בזוגות.",
  "species_red_sea_anemonefish_name": "דג שושנון ים סוף",
  "species_red_sea_anemonefish_desc": "דג שושנון בגוון כתום-צהוב עם שני פסים לבנים, אנדמי לים סוף ולמפרץ עדן.",
  "species_arabian_angelfish_name": "דג מלאך ערבי",
  "species_arabian_angelfish_desc": "דג מלאך גדול בכחול כהה בעל פס אנכי וזנב צהובים ובולטים, אנדמי למערב האוקיינוס ההודי.",
  "species_king_angelfish_name": "דג מלאך מלך",
  "species_king_angelfish_desc": "דג מלאך גדול בכחול כהה בעל פס אנכי לבן וזנב צהוב, מצוי במזרח האוקיינוס השקט ובגלפגוס.",
  "species_ocean_sunfish_name": "דג שמש",
  "species_ocean_sunfish_desc": "הדג הגרמי הכבד ביותר, מגיע למשקל של יותר משני טונות ונצפה מדי פעם על ידי צוללנים בתחנות ניקוי בבאלי ובגלפגוס.",
  "species_lingcod_name": "לינגקוד",
  "species_lingcod_desc": "דג טורף גדול ומנומר ממשפחת הגרינלינגים, מצוי בשוניות סלע בצפון-מערב האוקיינוס השקט ולרוב שומר על גושי ביצים.",
  "species_wolf_eel_name": "צלופח זאב",
  "species_wolf_eel_desc": "צלופח זאב אפור וגדול בעל ראש בולבוסי ולסתות חזקות, מצוי במאורות סלע בצפון-מערב האוקיינוס השקט.",
  "species_giant_sea_bass_name": "בס ים ענק",
  "species_giant_sea_bass_desc": "בס ענק המגיע ליותר מ-2 מטרים ו-250 ק\"ג, מצוי בשוניות סלע וביערות קלפ מול חופי דרום קליפורניה.",
  "species_garibaldi_name": "גריבלדי",
  "species_garibaldi_desc": "דג עלמה כתום בוהק והדג הימי הרשמי של קליפורניה, טריטוריאלי בשוניות שביערות הקלפ.",
  "species_sheephead_name": "דג ראש-כבש קליפורני",
  "species_sheephead_desc": "דג נסיכה גדול בעל ראש וזנב שחורים, גוף אמצעי אדום וסנטר לבן, מצוי ביערות הקלפ של קליפורניה.",
  "species_copper_rockfish_name": "דג סלע נחושתי",
  "species_copper_rockfish_desc": "דג סלע בגוון נחושת-כתום עם כתמים בהירים, מראה נפוץ בשוניות הסלע וביערות הקלפ של צפון-מערב האוקיינוס השקט.",
  "species_oriental_sweetlips_name": "דג שפתיים מתוקות מזרחי",
  "species_oriental_sweetlips_desc": "דג שונית הודו-פסיפי גדול בעל פסים שחורים ולבנים נועזים וסנפירים צהובים, והצעירים מבצעים ריקוד מתפתל.",
  "species_harlequin_sweetlips_name": "דג שפתיים מתוקות הרלקין",
  "species_harlequin_sweetlips_desc": "הבוגרים אפורים עם נקודות כהות והצעירים חומים עם נקודות לבנות גדולות ושוחים בתנועה גלית.",
  "species_blue_ringed_angelfish_name": "דג מלאך כחול-טבעת",
  "species_blue_ringed_angelfish_desc": "דג מלאך חום וגדול בעל קווים כחולים מעוקלים וטבעת כחולה אופיינית מעל מכסה הזימים.",
  "species_yellowbar_angelfish_name": "דג מלאך צהוב-פס",
  "species_yellowbar_angelfish_desc": "דג מלאך גדול בגוון אפור-כחול בעל כתם גוף צהוב בולט, מצוי בים סוף ובמערב האוקיינוס ההודי.",
  "species_filefish_scrawled_name": "דג פצירה משורבט",
  "species_filefish_scrawled_desc": "דג פצירה גדול בגוון חום-זית בעל סימנים כחולים דמויי שרבוט וזפק כתום, מצוי בשוניות טרופיות בכל העולם.",
  "species_clown_filefish_name": "דג פצירה כתום-נקודות",
  "species_clown_filefish_desc": "דג פצירה ירוק וקטן בעל נקודות כתומות וחרטום ארוך, ניזון אך ורק מפוליפים של אלמוגי Acropora.",
  "species_unicornfish_name": "דג חד-קרן כחול-קוץ",
  "species_unicornfish_desc": "דג כירורג אפור בעל קרן מצח בולטת ושני קוצי זנב כחולים, נפוץ במישורי השונית של ההודו-פסיפי.",
  "species_surgeonfish_sailfin_name": "דג כירורג מפרשי",
  "species_surgeonfish_sailfin_desc": "דג כירורג בעל פסים נועזים וסנפירי גב ופי הטבעת מורחבים מאוד, מצוי ברחבי ההודו-פסיפי.",
  "species_achilles_tang_name": "דג כירורג אכילס",
  "species_achilles_tang_desc": "דג כירורג בחום כהה בעל כתם דמעה כתום בולט סמוך לזנב, מצוי באזורי גלים סוערים במרכז האוקיינוס השקט.",
  "species_doctorfish_name": "דג רופא",
  "species_doctorfish_desc": "דג כירורג בגוון אפרפר-חום בעל פסים כהים עדינים ואזמל זנב בולט, נפוץ בשוניות הקריביים.",
  "species_checkerboard_wrasse_name": "דג נסיכה משבצות",
  "species_checkerboard_wrasse_desc": "דג נסיכה צבעוני בעל דוגמת משבצות ירוקות, ורודות ושחורות לאורך הגוף.",
  "species_bird_wrasse_name": "דג נסיכה ציפור",
  "species_bird_wrasse_desc": "דג נסיכה בעל חרטום מוארך במיוחד המזכיר מקור של ציפור; הזכרים ירוקים כהים והנקבות חומות.",
  "species_sling_jaw_wrasse_name": "דג נסיכה מקלע-לסת",
  "species_sling_jaw_wrasse_desc": "דג נסיכה בעל לסת נשלפת הנורית קדימה כדי ללכוד טרף, ומופיע בגרסאות צבע צהובה או חומה.",
  "species_peacock_flounder_name": "דג שטוח טווסי",
  "species_peacock_flounder_desc": "דג קרקעית שטוח בעל טבעות ונקודות כחולות המסוגל לשנות את צבעו כדי להתמזג עם קרקעית הים.",
  "species_hogfish_name": "דג חזיר",
  "species_hogfish_desc": "דג נסיכה גדול ממערב האטלנטי בעל חרטום דמוי חזיר וקוצי גב מוארכים, מצוי סמוך לשוניות ולספינות טרופות.",
  "species_tarpon_name": "טרפון אטלנטי",
  "species_tarpon_desc": "דג כסוף ענק בעל קשקשים גדולים דמויי מראה, נפגש לעיתים על ידי צוללנים במערות ובתעלות בקריביים.",
  "species_permit_name": "פרמיט",
  "species_permit_desc": "דג ג'ק כסוף בעל גוף גבוה וזנב מפוצל כהה, מצוי במישורי החול של הקריביים וסמוך לשוניות.",
  "species_spotted_drum_name": "דג תוף מנוקד",
  "species_spotted_drum_desc": "דג קריבי מרשים בעל סנפיר גב גבוה ומוארך ודוגמת נקודות נועזת בשחור ולבן.",
  "species_jackknife_fish_name": "דג אולר",
  "species_jackknife_fish_desc": "דג קריבי אלגנטי בעל פס שחור גבוה בסנפיר הגב ופס אלכסוני בגוף, מצוי מתחת למדפי סלע.",
  "species_bigeye_name": "עין-זכוכית",
  "species_bigeye_desc": "דג לילי אדום בוהק בעל עיניים גדולות ומחזירות אור, מסתתר במערות בשוניות הקריביים והאטלנטי.",
  "species_remora_name": "רמורה",
  "species_remora_desc": "דג תמיר בעל דיסקת יניקה על ראשו הנטפל לכרישים, לטריגונים, לצבים ולבעלי חיים גדולים אחרים.",
  "species_tilefish_sand_name": "דג אריח חולי",
  "species_tilefish_sand_desc": "דג מוארך בכחול בהיר הבונה תלוליות משברי אלמוגים מעל אזורי חול בשוניות הקריביים.",
  "species_weedy_seadragon_name": "דרקון ים עשבי",
  "species_weedy_seadragon_desc": "קרוב משפחה מקושט של סוסוני הים בעל תוספות דמויות עלים, אנדמי למים הממוזגים של דרום אוסטרליה.",
  "species_leafy_seadragon_name": "דרקון ים עלים",
  "species_leafy_seadragon_desc": "דרקון ים מרהיב המכוסה בבליטות מורכבות דמויות עלים, אנדמי לדרום אוסטרליה ותצפית שכל צוללן חולם עליה.",
  "species_sailfin_snapper_name": "לוציאן מפרשי",
  "species_sailfin_snapper_desc": "לוציאן אלגנטי בצהוב וכחול בעל סנפירי גב ופי הטבעת מוארכים, מצוי במדרונות שונית בהודו-פסיפי.",
  "species_sweetlip_emperor_name": "דג קיסר מנצנץ",
  "species_sweetlip_emperor_desc": "דג קיסר כסוף וגדול בעל קווים כחולים בפנים ושולי סנפירים צהובים, נפוץ מעל אזורי חול סמוך לשוניות בהודו-פסיפי.",
  "species_crocodilefish_name": "דג תנין",
  "species_crocodilefish_desc": "טורף מארב שטוח-ראש בעל גדילים מורכבים סביב העיניים, שוכב מוסווה להפליא על קרקעיות השונית בהודו-פסיפי.",
  "species_devil_scorpionfish_name": "דג עקרב שטן",
  "species_devil_scorpionfish_desc": "דג עקרב חסון ומוסווה החושף צבעים עזים בצדם הפנימי של סנפירי החזה כאזהרה לטורפים.",
  "species_spiny_devilfish_name": "עוקצן שד",
  "species_spiny_devilfish_desc": "דייר קרקעית ארסי הצועד על קרני סנפיר מותאמות וחושף סנפירי חזה בוהקים כשמפריעים לו.",
  "species_waspfish_name": "דג צרעה קקדו",
  "species_waspfish_desc": "דג עקרב קטן ושטוח המתנועע בזרם כמו עלה מת מעל קרקעיות בוציות בהודו-פסיפי.",
  "species_stargazer_name": "צופה בכוכבים לבן-שוליים",
  "species_stargazer_desc": "טורף מארב הטומן את עצמו בחול כשרק עיניו גלויות, ומסוגל לתת מכות חשמל; מצוי בהודו-פסיפי.",
  "species_striped_catfish_name": "שפמנון ים מפוספס",
  "species_striped_catfish_desc": "שפמנון בעל קוצים ארסיים; הצעירים יוצרים להקות כדוריות צפופות המתגלגלות על קרקעיות השונית בהודו-פסיפי.",
  "species_red_emperor_name": "קיסר אדום",
  "species_red_emperor_desc": "לוציאן גדול; הבוגרים בגוון אדום-ורדרד והצעירים בעלי פסים אדומים ולבנים בולטים, והמין מצוי בשוניות ההודו-פסיפי.",
  "species_mangrove_snapper_name": "לוציאן מנגרובים",
  "species_mangrove_snapper_desc": "לוציאן אפור המצוי במנגרובים, בערוגות עשב ים ובשוניות בקריביים, ולרוב מתקבץ סמוך למבנים.",
  "species_dottyback_orchid_name": "דוטיבק סחלב",
  "species_dottyback_orchid_desc": "דג קטן בסגול עז האנדמי לים סוף, מזנק פנימה והחוצה מנקיקים בקירות שונית תלולים.",
  "species_dottyback_royal_name": "דוטיבק מלכותי",
  "species_dottyback_royal_desc": "דג קטן ודו-גוני שחלקו הקדמי מג'נטה וחלקו האחורי צהוב בוהק, מצוי בקירות שונית בהודו-פסיפי.",
  "species_coral_trout_name": "דקר נמרי",
  "species_coral_trout_desc": "טורף נחשק של שונית המחסום הגדולה, בעל גוף אדום-כתום המכוסה בנקודות כחולות.",
  "species_barramundi_cod_name": "דקר ברמונדי",
  "species_barramundi_cod_desc": "דקר ייחודי בעל ראש קטן, גוף גבנוני ונקודות כהות גדולות על רקע בהיר.",
  "species_spadefish_atlantic_name": "דג את אטלנטי",
  "species_spadefish_atlantic_desc": "דג כסוף בצורת דיסקה בעל פסים אנכיים כהים, נצפה לרוב בלהקות גדולות סביב ספינות טרופות בקריביים.",
  "species_fusilier_yellowback_name": "פוזיליר צהוב-גב",
  "species_fusilier_yellowback_desc": "דג כחול וחלקלק הניזון מפלנקטון ובעל גב צהוב, יוצר להקות ענק מעל מדרונות שונית בהודו-פסיפי.",
  "species_fusilier_bluestreak_name": "פוזיליר כחול-פס",
  "species_fusilier_bluestreak_desc": "פוזיליר כחול קטן בעל פס צדדי כהה, נצפה בלהקות מהירות לאורך קירות שונית בהודו-פסיפי.",
  "species_porkfish_name": "דג נוהם חזירי",
  "species_porkfish_desc": "דג נוהם קריבי צבעוני בעל פסים כחולים וצהובים ושני פסי ראש שחורים, מצוי סמוך לשוניות ולספינות טרופות.",
  "species_blue_striped_grunt_name": "דג נוהם כחול-פסים",
  "species_blue_striped_grunt_desc": "דג נוהם קריבי צהוב בעל פסים אופקיים כחולים עזים, יוצר ביום להקות מנוחה גדולות מתחת למדפי סלע.",
  "species_french_grunt_name": "דג נוהם צרפתי",
  "species_french_grunt_desc": "דג נוהם קטן בפסים צהובים היוצר להקות מנוחה צפופות בשוניות הקריביים בשעות היום.",
  "species_convict_tang_name": "דג כירורג אסיר",
  "species_convict_tang_desc": "דג כירורג בהיר בעל שישה פסים שחורים אנכיים, נצפה לרוב רועה בלהקות גדולות במישורי השונית של ההודו-פסיפי.",
  "species_great_hammerhead_name": "כריש פטיש משונן",
  "species_great_hammerhead_desc": "כריש ייחודי בעל ראש משונן בצורת פטיש, יוצר להקות גדולות סביב הרי ים ואיים מרוחקים מהחוף.",
  "species_wobbegong_name": "וובגונג מנוקד",
  "species_wobbegong_desc": "כריש שטיח שטוח ומוסווה היטב בעל אונות משוננות סביב הפה, מצוי בשוניות ממוזגות באוסטרליה.",
  "species_manta_ray_name": "מנטת שונית",
  "species_manta_ray_desc": "ענק חינני במוטת כנפיים של עד 5 מטרים המבקר בתחנות ניקוי וניזון מפלנקטון בשוניות ההודו-פסיפי.",
  "species_oceanic_manta_name": "מנטה אוקיינית",
  "species_oceanic_manta_desc": "מין הטריגון הגדול ביותר, במוטת כנפיים של יותר מ-7 מטרים, נפגש בהרי ים מרוחקים מהחוף ובתחנות ניקוי.",
  "species_undulated_moray_name": "מורנה גלית",
  "species_undulated_moray_desc": "מורנה בגוון ירוק-צהבהב עם סימנים גליים כהים, נצפית לרוב צדה בלילה בשוניות ההודו-פסיפי.",
  "species_whitemouth_moray_name": "מורנה לבנת-פה",
  "species_whitemouth_moray_desc": "מורנה בחום כהה עם נקודות לבנות קטנות וחלל פה לבן אופייני, מצויה ברחבי ההודו-פסיפי.",
  "species_dragon_moray_name": "מורנת דרקון",
  "species_dragon_moray_desc": "מורנה מרשימה בעלת קרניים דמויות דרקון מעל הנחיריים וכתמי נמר אדומים-כתומים, מצויה בהודו-פסיפי.",
  "species_lyretail_grouper_name": "דקר נבל-זנב",
  "species_lyretail_grouper_desc": "דקר בגוון אדום-ורוד בעל נקודות כחולות וזנב אופייני בצורת סהר, מצוי בקירות שונית חיצוניים בהודו-פסיפי.",
  "species_banded_butterflyfish_name": "דג פרפר מפוספס",
  "species_banded_butterflyfish_desc": "דג פרפר לבן בעל ארבעה פסים אנכיים שחורים בולטים, אחד מדגי הפרפר הנפוצים ביותר בשוניות הקריביים.",
  "species_ringed_pipefish_name": "דג צינור טבעות",
  "species_ringed_pipefish_desc": "דג צינור תמיר בטבעות אדומות ולבנות לסירוגין, מצוי במערות ומתחת למדפי סלע בשוניות ההודו-פסיפי.",
  "species_razorfish_name": "דג תער",
  "species_razorfish_desc": "דג זעיר השוחה בקבוצות במאונך כשראשו כלפי מטה, ומסתתר לרוב בין קוצי קיפודי ים בשוניות ההודו-פסיפי.",
  "species_harlequin_tuskfish_name": "דג ניבים הרלקין",
  "species_harlequin_tuskfish_desc": "דג נסיכה צבעוני בעל ניבים כחולים בוהקים, פסים אדומים-כתומים וכתמים לבנים, מצוי בשוניות מערב האוקיינוס השקט.",
  "species_blue_groper_name": "גרופר כחול",
  "species_blue_groper_desc": "דג נסיכה כחול וגדול האנדמי למזרח אוסטרליה, ידידותי ומתקרב לעיתים קרובות לצוללנים בשוניות ממוזגות.",
  "species_red_lipped_batfish_name": "דג עטלף אדום-שפתיים",
  "species_red_lipped_batfish_desc": "דג מוזר ושטוח-גוף בעל שפתיים אדומות בוהקות הצועד על סנפירים מותאמים על קרקעית הים בגלפגוס.",
  "species_orangeband_surgeonfish_name": "דג כירורג כתום-פס",
  "species_orangeband_surgeonfish_desc": "דג כירורג בגוון אפור-חום בעל פס אופקי כתום מאחורי העין, מצוי במדרונות שונית באוקיינוס השקט.",
  "species_maori_wrasse_name": "דג נסיכה מאורי",
  "species_maori_wrasse_desc": "דג נסיכה בינוני בעל פס כהה מאחורי סנפיר החזה, נפוץ בשוניות האוקיינוס השקט והאוקיינוס ההודי.",
  "species_blue_ringed_octopus_name": "תמנון כחול-טבעות",
  "species_blue_ringed_octopus_desc": "תמנון קטן אך ארסי ביותר בעל טבעות כחולות בוהקות המהבהבות כשהוא מאוים.",
  "species_common_octopus_name": "תמנון מצוי",
  "species_common_octopus_desc": "תמנון אינטליגנטי מאוד הידוע בשינויי צבע מהירים וביכולות פתרון בעיות.",
  "species_giant_pacific_octopus_name": "תמנון פסיפי ענק",
  "species_giant_pacific_octopus_desc": "מין התמנון הגדול ביותר, מוטת זרועותיו מגיעה ליותר מ-4 מטרים במים הקרים של האוקיינוס השקט.",
  "species_mimic_octopus_name": "תמנון מחקה",
  "species_mimic_octopus_desc": "תמנון יוצא דופן המחקה את מראם ואת התנהגותם של מינים ימיים אחרים.",
  "species_coconut_octopus_name": "תמנון קוקוס",
  "species_coconut_octopus_desc": "תמנון קטן המפורסם בנשיאת קליפות קוקוס ובשימוש בהן כמחסה נייד.",
  "species_day_octopus_name": "תמנון יום",
  "species_day_octopus_desc": "צייד פעיל בשעות היום, נפוץ בשוניות ההודו-פסיפי ובעל יכולות הסוואה מרשימות.",
  "species_wonderpus_octopus_name": "תמנון וונדרפוס",
  "species_wonderpus_octopus_desc": "תמנון מרשים בעל פסים לבנים וחומים ייחודיים, מצוי באתרי צלילת מאק חוליים.",
  "species_broadclub_cuttlefish_name": "ספיה רחבת-אלה",
