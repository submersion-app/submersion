  "species_bladder_wrack_desc": "Gyakori barnamoszat páros léghólyagokkal, az Atlanti-óceán északi részének árapályzónájában él.",
  "species_sargassum_name": "Szargasszumhínár",
  "species_sargassum_desc": "Szabadon lebegő barnamoszat, amely tutajokat alkot, és menedéket nyújt a fiatal halaknak és gerincteleneknek.",
  "species_kelp_forest_ecklonia_name": "Ecklonia moszat",
  "species_kelp_forest_ecklonia_desc": "A déli félteke vizeinek meghatározó moszatja, amely fontos víz alatti erdőket alkot.",
  "species_coralline_algae_name": "Korallmoszat",
  "species_coralline_algae_desc": "Kemény, bevonatot képző vörösmoszat, amely összecementezi a zátony szerkezetét, és rózsaszín árnyalatot ad neki.",
  "species_irish_moss_name": "Ír moszat",
  "species_irish_moss_desc": "Legyező alakú vörösmoszat az Atlanti-óceán északi részének sziklás partjain, az árapályzónában.",
  "species_dulse_name": "Tenyeres vörösmoszat",
  "species_dulse_desc": "Lapos, vörösesbíbor moszat, amely sziklákon és moszatnyeleken nő a hideg északi vizekben.",
  "species_halimeda_name": "Halimeda",
  "species_halimeda_desc": "Meszes zöldmoszat korong alakú szelvényekkel, jelentős mértékben hozzájárul a zátonyhomok képződéséhez.",
  "species_sea_lettuce_name": "Tengeri saláta",
  "species_sea_lettuce_desc": "Élénkzöld, lemezes moszat, világszerte sekély part menti vizekben él.",
  "species_caulerpa_name": "Zöld szőlőmoszat",
  "species_caulerpa_desc": "Kúszó zöldmoszat szőlőszemre emlékeztető ágakkal, trópusi zátonytörmeléken és homokon él.",
  "species_mermaid_fan_name": "Sellőlegyező",
  "species_mermaid_fan_desc": "Meszes zöldmoszat kis legyező alakjával, gyakori a karibi homokos fenéken.",
  "species_shaving_brush_algae_name": "Borotvapamacs moszat",
  "species_shaving_brush_algae_desc": "Meszes zöldmoszat nyélen ülő, ecsetszerű bojttal, a karibi homokos fenéken él.",
  "species_finger_kelp_name": "Ujjas moszat",
  "species_finger_kelp_desc": "Barnamoszat ujjszerű levelekkel, amely moszatágyakat alkot az Atlanti-óceán északi részének part menti vizeiben.",
  "species_banded_sea_krait_name": "Sávos tengeri krajt",
  "species_banded_sea_krait_desc": "Mérges tengeri kígyó kékesszürke és fekete sávokkal, szelíd természetű, gyakran látható az indo-csendes-óceáni zátonyokon.",
  "species_olive_sea_snake_name": "Olívzöld tengeri kígyó",
  "species_olive_sea_snake_desc": "Kíváncsi tengeri kígyó az ausztrál zátonyokon, amely gyakran közelít a búvárokhoz.",
  "species_yellow_bellied_sea_snake_name": "Sárgahasú tengeri kígyó",
  "species_yellow_bellied_sea_snake_desc": "Nyíltvízi tengeri kígyó sárga hassal, a Föld legelterjedtebb kígyófaja.",
  "species_marine_iguana_name": "Tengeri leguán",
  "species_marine_iguana_desc": "A Galápagos endemikus faja, az egyetlen gyík, amely a víz alatt algával táplálkozik.",
  "species_saltwater_crocodile_name": "Bordás krokodil",
  "species_saltwater_crocodile_desc": "A legnagyobb élő hüllő, amely az Indo-csendes-óceán part menti és torkolati vizeiben él.",
  "species_northern_pike_name": "csuka",
  "species_northern_pike_desc": "Megnyúlt testű, kacsacsőrszerű orrú lesből támadó ragadozó, mozdulatlanul áll a parti hínár között.",
  "species_muskellunge_name": "Muskellunge csuka",
  "species_muskellunge_desc": "A legnagyobb csukafaj, a tiszta északi tavak csíkos vagy pettyes óriása, ritkán látni, de felejthetetlen.",
  "species_chain_pickerel_name": "Láncos csuka",
  "species_chain_pickerel_desc": "Karcsú csuka Észak-Amerika keleti, hínáros tavaiból, oldalán láncszerű mintázatáról kapta a nevét.",
  "species_walleye_name": "Walleye",
  "species_walleye_desc": "Aranyzöld sügérrokon nagy, fényvisszaverő szemekkel, alkonyatkor vadászik sziklás és homokos tófenék fölött.",
  "species_sauger_name": "Sauger",
  "species_sauger_desc": "A walleye kisebb, foltosabb rokona, zavaros folyókat és víztározókat kedvel.",
  "species_yellow_perch_name": "Sárga sügér",
  "species_yellow_perch_desc": "Rajokban járó aranysárga sügér sötét függőleges csíkokkal, gyakori stégek és hínárosok körül Észak-Amerikában.",
  "species_european_perch_name": "csapósügér",
  "species_european_perch_desc": "Csíkos, tüskés úszójú sügér vörös-narancs alsó úszókkal, szinte minden európai tóban és lassú folyóban megtalálható.",
  "species_zander_name": "Fogassüllő",
  "species_zander_desc": "Nagy, sápadt ragadozó üveges szemekkel és agyarszerű fogakkal, sötétedés után járja a zavaros európai tavakat és folyókat.",
  "species_ruffe_name": "vágó durbincs",
  "species_ruffe_desc": "Kis, márványozott mintájú vágó durbincs egybefüggő tüskés hátúszóval, gyakori az európai tavak puha fenekén.",
  "species_largemouth_bass_name": "pisztrángsügér",
  "species_largemouth_bass_desc": "Zöld hátú sügér sötét oldalcsíkkal és hatalmas szájjal, fatörzsek és hínárszegélyek mellett les a meleg tavakban.",
  "species_smallmouth_bass_name": "Kisszájú sügér",
  "species_smallmouth_bass_desc": "Bronzszínű sügér halvány függőleges csíkokkal, sziklás és kavicsos aljzat fölött áll tiszta, hűvös tavakban és folyókban.",
  "species_rock_bass_name": "Sziklasügér",
  "species_rock_bass_desc": "Zömök, vörös szemű naphal sötét pontsorokkal, sziklatömbök között rejtőzik tiszta patakokban és tavakban.",
  "species_bluegill_name": "Kékkopoltyús naphal",
  "species_bluegill_desc": "Korong alakú naphal kékesfekete kopoltyúfedő-lebennyel és narancssárga mellel, kolóniákban fészkel sekély homokos aljzaton.",
  "species_pumpkinseed_name": "naphal",
  "species_pumpkinseed_desc": "Élénken pettyezett naphal vörös szegélyű kopoltyúlebennyel és hullámos kék pofacsíkokkal, gyakori a hínáros sekélyesekben.",
  "species_black_crappie_name": "Fekete crappie",
  "species_black_crappie_desc": "Ezüstös, magas testű, fekete pettyes naphalféle, elmerült ágak és cölöpök körül rajzik.",
  "species_white_crappie_name": "Fehér crappie",
  "species_white_crappie_desc": "Halványabb crappie gyenge függőleges sávokkal, zavaros víztározókat és lassú folyókat kedvel.",
  "species_brown_trout_name": "sebes pisztráng",
  "species_brown_trout_desc": "Aranybarna pisztráng vörös és fekete pettyekkel, hűvös, tiszta folyók és tavak sodrában áll.",
  "species_rainbow_trout_name": "Szivárványos pisztráng",
  "species_rainbow_trout_desc": "Ezüstös pisztráng rózsaszín oldalsávval és finom fekete pettyezéssel, telepített és vad populációi hideg vizekben világszerte.",
  "species_brook_trout_name": "pataki szaibling",
  "species_brook_trout_desc": "Pataki szaibling féregszerű hátmintázattal, kék udvarú vörös pettyekkel és fehér szegélyű úszókkal, hideg forrásvidéki patakokban.",
  "species_lake_trout_name": "Tavi szaibling",
  "species_lake_trout_desc": "Nagy, szürke, világos foltokkal borított szaibling villás farokkal, az északi tavak mély, hideg vizét járja.",
  "species_arctic_char_name": "Sarki szaibling",
  "species_arctic_char_desc": "A legészakibb édesvízi hal, karcsú szaibling, amelynek hasa az őszi ívási időszakban narancsvörösre színeződik.",
  "species_atlantic_salmon_name": "Atlanti lazac",
  "species_atlantic_salmon_desc": "Ezüstös, tengerjáró lazac fekete X alakú pettyekkel, vízeséseket ugrik át, amikor ívni visszatér szülőfolyójába.",
  "species_chinook_salmon_name": "Királylazac",
  "species_chinook_salmon_desc": "A legnagyobb csendes-óceáni lazac, kékeszöld háttal és fekete ínnyel, ívni a nagy nyugati folyókba vándorol fel.",
  "species_sockeye_salmon_name": "Vörös lazac",
  "species_sockeye_salmon_desc": "Íváskor élénkvörösre színeződő, zöld fejű lazac, ellepi a tavak táplálta folyók kavicságyait.",
  "species_coho_salmon_name": "Ezüstlazac",
  "species_coho_salmon_desc": "Ezüstlazac fehér ínnyel és csak a farok felső felén lévő pettyekkel, kis parti patakokban ívik.",
  "species_lake_whitefish_name": "Tavi maréna",
  "species_lake_whitefish_desc": "Ezüstös, kis szájú maréna mély, hideg tavakból, nagy rajokban táplálkozik a fenéken.",
  "species_cisco_name": "Cisco maréna",
  "species_cisco_desc": "Karcsú, heringre emlékeztető maréna, az északi hideg tavak nyílt vizében rajzik, a tavi szaibling zsákmánya.",
  "species_european_grayling_name": "pénzes pér",
  "species_european_grayling_desc": "Ezüstszürke folyami hal magas, vitorlaszerű, lila szegélyű hátúszóval, gyors, tiszta kavicsos szakaszokon áll.",
  "species_common_carp_name": "ponty",
  "species_common_carp_desc": "Testes, bronzszínű ponty nagy pikkelyekkel és két bajuszszállal, meleg tavak és folyók puha fenekét túrja.",
  "species_grass_carp_name": "amur",
  "species_grass_carp_desc": "Torpedó alakú ázsiai ponty, világszerte betelepítették a vízinövények legelésére, gyakran látható tiszta bányatavakban.",
  "species_tench_name": "compó",
  "species_tench_desc": "Olajzöld hal apró pikkelyekkel, vörös szemekkel és lekerekített úszókkal, az állóvizek iszapjában és nádasában siklik.",
  "species_common_bream_name": "dévérkeszeg",
  "species_common_bream_desc": "Magas testű, oldalról lapított bronzszínű hal, fejjel lefelé táplálkozik iszapos rajokban, gyakori az európai síkvidékeken.",
  "species_roach_name": "Bodorka",
  "species_roach_desc": "Ezüstös, rajokban élő hal vörös úszókkal és vörös szivárványhártyával, sok európai tó és csatorna leggyakoribb hala.",
  "species_rudd_name": "vörösszárnyú keszeg",
  "species_rudd_desc": "A bodorka aranyoldalú rokona élénkvörös úszókkal és felfelé álló szájjal, közvetlenül a felszín alatt táplálkozik.",
  "species_chub_name": "Fejes domolykó",
  "species_chub_desc": "Zömök folyami hal széles fejjel, nagy, sötét szegélyű pikkelyekkel és nagy szájjal, a víz fölé hajló fák alatt áll.",
  "species_barbel_name": "márna",
  "species_barbel_desc": "Áramvonalas fenéklakó hal négy bajuszszállal és alsó állású szájjal, a gyors európai folyók kavicsához simul.",
  "species_european_eel_name": "európai angolna",
  "species_european_eel_desc": "Kígyószerű hal, amely évtizedeket tölt folyókban és tavakban, mielőtt egyetlen ívásra a Sargasso-tengerbe vándorol.",
  "species_american_eel_name": "Amerikai angolna",
  "species_american_eel_desc": "Észak-amerikai angolna, nappal folyók és tavak kövei alatt rejtőzik, szaporodni a Sargasso-tengerbe tér vissza.",
  "species_burbot_name": "menyhal",
  "species_burbot_desc": "Az egyetlen édesvízi tőkehalféle, márványozott, angolnaszerű hal egyetlen állbajuszszállal, nappal a hideg mélyvízben rejtőzik.",
  "species_channel_catfish_name": "Pettyes harcsa",
  "species_channel_catfish_desc": "Szürke harcsa elszórt sötét foltokkal, villás farokkal és nyolc bajuszszállal, gyakori Észak-Amerika folyóiban és víztározóiban.",
  "species_flathead_catfish_name": "Laposfejű harcsa",
  "species_flathead_catfish_desc": "Hatalmas, barnán márványozott harcsa lapított fejjel és előreálló alsó állkapoccsal, mély folyami gödrökben fekszik.",
  "species_brown_bullhead_name": "törpeharcsa",
  "species_brown_bullhead_desc": "Kis, zömök törpeharcsa sötét bajuszszálakkal és egyenes farokkal, elviseli az iszapos, meleg, oxigénszegény tavakat.",
  "species_wels_catfish_name": "Harcsa",
  "species_wels_catfish_desc": "Európa legnagyobb édesvízi hala, pikkely nélküli óriás széles, lapos fejjel és hosszú bajuszszálakkal, mély folyami gödrökben fekszik.",
  "species_white_sturgeon_name": "Fehér tok",
  "species_white_sturgeon_desc": "Észak-Amerika legnagyobb édesvízi hala, páncélos szürke óriás cápaszerű farokkal, a nagy nyugati folyókat járja.",
  "species_lake_sturgeon_name": "Tavi tok",
  "species_lake_sturgeon_desc": "Lassan növő páncélos tok a Nagy-tavakból és a Mississippi vízgyűjtőjéből, csöves szájával a fenéket szívja fel.",
  "species_european_sturgeon_name": "Közönséges tok",
  "species_european_sturgeon_desc": "Kritikusan veszélyeztetett páncélos tok az atlanti folyókból, ma a Garonne-ba és az Elbába tenyésztik és telepítik vissza.",
  "species_alligator_gar_name": "Aligátor kajmánhal",
  "species_alligator_gar_desc": "Őskori óriás széles, fogas orral és rombusz alakú páncélpikkelyekkel, a déli folyókban levegőért jön a felszínre.",
  "species_longnose_gar_name": "Hosszúorrú kajmánhal",
  "species_longnose_gar_desc": "Karcsú páncélos hal tűszerű orral, mozdulatlanul lebeg közvetlenül a meleg folyók felszíne alatt.",
  "species_bowfin_name": "Iszaphal",
  "species_bowfin_desc": "Élő kövület hosszú, hullámzó hátúszóval és csontos fejjel, ivadékait hínáros holtágakban őrzi.",
  "species_american_paddlefish_name": "Amerikai lapátorrú hal",
  "species_american_paddlefish_desc": "Szűrögető óriás lapátszerű orral, amely testhosszának harmadát teszi ki, nyitott szájjal úszik a nagy folyókban.",
  "species_sea_lamprey_name": "Nagy tengeri ingola",
  "species_sea_lamprey_desc": "Állkapocs nélküli, angolnaszerű élősködő fogakkal körülvett tapadószájjal, kavicsos patakokban ívik, miután a tengerben vagy tavakban táplálkozott.",
  "species_freshwater_drum_name": "Édesvízi dobhal",
  "species_freshwater_drum_desc": "Ezüstös, púpos hátú hal, amely hallhatóan morog és garatfogaival kagylókat tör, gyakori nagy folyókban és tavakban.",
  "species_white_sucker_name": "Fehér szívóhal",
  "species_white_sucker_desc": "Hengeres testű fenéklakó hal húsos, lefelé álló szájjal, tavasszal ívó tömegekben vonul fel a patakokba.",
  "species_common_minnow_name": "fürge cselle",
  "species_common_minnow_desc": "Apró, csíkos, rajokban élő hal tiszta, hűvös patakokból és tavakból, a hímek tavasszal vörös és zöld színt öltenek.",
  "species_three_spined_stickleback_name": "tüskés pikó",
  "species_three_spined_stickleback_desc": "Apró, páncélos hal három háttüskével, vörös torkú hímjei növényi rostokból építenek és őriznek fészket.",
  "species_alewife_name": "Alewife hering",
  "species_alewife_desc": "Ezüstös hering, tavasszal a folyókba vonul fel, és ma hatalmas rajokban tölti meg a Nagy-tavakat.",
  "species_nile_perch_name": "Nílusi sügér",
  "species_nile_perch_desc": "Hatalmas ezüstös ragadozó fekete szegélyű szemmel, a Viktória-tóba telepítették, ahol uralja a nyílt vizet.",
  "species_nile_tilapia_name": "Nílusi tilápia",
  "species_nile_tilapia_desc": "Szürke bölcsőszájú hal függőleges farokcsíkokkal, ivadékait a szájában költi, világszerte tenyésztik és elvadult a meleg vizekben.",
  "species_african_tigerfish_name": "Afrikai tigrishal",
  "species_african_tigerfish_desc": "Csíkos ezüstös ragadozó egymásba illeszkedő tőrszerű fogakkal, gyors afrikai folyókban, például a Zambéziben vadászik.",
  "species_marbled_lungfish_name": "Márványos tüdőshal",
  "species_marbled_lungfish_desc": "Angolna alakú, levegőt lélegző hal fonalszerű úszókkal, a szárazságot iszapgubóba zárkózva vészeli át.",
  "species_electric_catfish_name": "Elektromos harcsa",
  "species_electric_catfish_desc": "Kövér szürke harcsa a Nílusból és a Kongóból, több száz voltos áramütéssel bénítja meg zsákmányát.",
  "species_zebra_mbuna_name": "Zebra mbuna",
  "species_zebra_mbuna_desc": "Kék csíkos sziklalakó bölcsőszájú hal a Malawi-tóból, sűrű, territoriális tömegekben legeli az algát a sziklákról.",
  "species_malawi_butterfly_peacock_name": "Pillangó pávacichlida",
  "species_malawi_butterfly_peacock_desc": "Irizáló kék pávacichlida a Malawi-tó barlangjaiból, a hímek fehér szegélyű úszókkal pompáznak.",
  "species_fuelleborn_cichlid_name": "Fuelleborn-cichlida",
  "species_fuelleborn_cichlid_desc": "Tompa orrú mbuna a Malawi-tóból húsos, előreálló orral, amellyel a hullámverés zónájában kaparja az algát.",
  "species_princess_of_burundi_name": "Burundi hercegnő",
  "species_princess_of_burundi_desc": "Elegáns Tanganyika-tavi bölcsőszájú hal líra alakú úszókkal, nagycsaládokban él, amelyek megosztják a fészekgondozást.",
  "species_frontosa_name": "Frontosa",
  "species_frontosa_desc": "Mélyvízi Tanganyika-tavi bölcsőszájú hal erős kékesfehér sávokkal és púpos homlokkal, lassan, csoportosan mozog a sziklák fölött.",
  "species_tropheus_moorii_name": "Moore-cichlida",
  "species_tropheus_moorii_desc": "Zömök Tanganyika-tavi sziklalakó bölcsőszájú hal több tucat színváltozatban, mindegyik saját partszakaszára korlátozódik.",
  "species_arapaima_name": "arapaima (pirarucu)",
  "species_arapaima_desc": "Az egyik legnagyobb édesvízi hal, páncélos amazonasi óriás vörös pettyes farokkal, levegőért emelkedik a felszínre.",
  "species_silver_arowana_name": "Ezüst arowana",
  "species_silver_arowana_desc": "Szalagszerű ezüstös amazonasi hal két állbajuszszállal, kiugrik a vízből, hogy rovarokat kapjon el az ágakról.",
  "species_red_bellied_piranha_name": "Vöröshasú piranha",
  "species_red_bellied_piranha_desc": "Magas testű ezüstös hal karmazsinvörös hassal és borotvaéles fogakkal, rajokban vonul az Amazonas holtágain.",
  "species_black_piranha_name": "Fekete piranha",
  "species_black_piranha_desc": "Nagy, magányos piranha vörös szemekkel és sötét, rombusz alakú testtel, tiszta, sziklás amazonasi mellékfolyókban les.",
  "species_red_bellied_pacu_name": "Vöröshasú pacu",
  "species_red_bellied_pacu_desc": "Piranhára emlékeztető gyümölcsevő lapos, zúzó fogakkal és vörös hassal, elárasztott erdők fái alatt gyülekezik.",
  "species_tambaqui_name": "Tambaqui",
  "species_tambaqui_desc": "Hatalmas, sötét pacu az Amazonasból, az elárasztott erdő lombkoronája alatt lehullott dióféléket és magvakat ropogtat.",
  "species_electric_eel_name": "Elektromos angolna",
  "species_electric_eel_desc": "Nem angolna, hanem késhal, hosszú, sötét, levegőt lélegző hal, amely akár 600 voltos ütéssel bénítja meg zsákmányát.",
  "species_redtail_catfish_name": "Vörösfarkú harcsa",
  "species_redtail_catfish_desc": "Nagy amazonasi harcsa sötét háttal, fehér hassal és élénk narancsvörös farokkal, mély folyami medencékben pihen.",
  "species_tiger_shovelnose_catfish_name": "Tigrisharcsa",
  "species_tiger_shovelnose_catfish_desc": "Karcsú, csíkos harcsa hosszú, lapított orral, éjjel vadászik a dél-amerikai folyók homokos medrei mentén.",
  "species_peacock_bass_name": "Pávasügér",
  "species_peacock_bass_desc": "Agresszív amazonasi bölcsőszájú hal három sötét sávval és farokfoltjával, elsüllyedt fák mentén les halakra.",
  "species_oscar_name": "Oszkár",
  "species_oscar_desc": "Zömök, sötét bölcsőszájú hal narancssárga márványozással és farokfolttal, lassú amazonasi vizeket és elárasztott partokat jár be.",
  "species_freshwater_angelfish_name": "Vitorláshal",
  "species_freshwater_angelfish_desc": "Magas, korong alakú amazonasi bölcsőszájú hal hosszú úszókkal és függőleges csíkokkal, elmerült gyökerek között lebeg.",
  "species_discus_name": "Diszkoszhal",
  "species_discus_desc": "Kerek, oldalról lapított bölcsőszájú hal hullámos kék vonalakkal, ivadékait saját bőrének nyálkájával táplálja.",
  "species_sailfin_pleco_name": "Vitorlás algaevő harcsa",
  "species_sailfin_pleco_desc": "Páncélos, tapadószájú harcsa magas hátúszóval és leopárdfoltokkal, fáról és szikláról kaparja le az algát.",
  "species_cardinal_tetra_name": "Kardinálishal",
  "species_cardinal_tetra_desc": "Apró pontylazac neonkék csíkkal egy teljes hosszúságú vörös sáv fölött, a Rio Negro sötét vizében rajzik.",
  "species_mexican_tetra_name": "Vak barlangi hal",
  "species_mexican_tetra_desc": "Ezüstös pontylazac a mexikói folyókból, barlangi populációi vakok és sápadtak, a cenote-búvárok kedvence.",
  "species_mekong_giant_catfish_name": "Mekongi óriásharcsa",
  "species_mekong_giant_catfish_desc": "Kritikusan veszélyeztetett, fogatlan óriás a Mekongból, szürke és bajuszszál nélküli, egykor három méteresre nőtt.",
  "species_giant_barb_name": "Óriásmárna",
  "species_giant_barb_desc": "A világ legnagyobb pontyféléje, nagy pikkelyű mekongi óriás hatalmas fejjel, ma már ritka a mély folyami medencékben.",
  "species_asian_arowana_name": "Ázsiai csontnyelvű hal",
  "species_asian_arowana_desc": "Fémes vörös vagy arany sárkányhal Délkelet-Ázsia feketevizű folyóiból, közvetlenül a felszín alatt siklik.",
  "species_striped_snakehead_name": "Csíkos kígyófejű hal",
  "species_striped_snakehead_desc": "Torpedó alakú, levegőt lélegző ragadozó lapos, kígyószerű fejjel, ivadékait hínáros ázsiai tavakban őrzi.",
  "species_giant_snakehead_name": "Óriás kígyófejű hal",
  "species_giant_snakehead_desc": "Nagy, harcias kígyófejű hal, fiatalon csíkos, felnőttként sötét, élénkvörös ivadékait délkelet-ázsiai tavakban védi.",
  "species_climbing_perch_name": "Kúszó sügér",
  "species_climbing_perch_desc": "Szívós olajzöld hal, levegőt lélegzik és tüskés kopoltyúfedőin kúszik a szárazföldön a kiszáradó tócsák között.",
  "species_golden_mahseer_name": "Márna",
  "species_golden_mahseer_desc": "Aranypikkelyű pontyféle a Himalája folyóiból, erős úszó, a zúgók alatti gyors, tiszta medencékben áll.",
  "species_koi_name": "Koi",
  "species_koi_desc": "Japánban fehér, vörös, fekete és arany mintázatúra nemesített díszponty, tavakban és meleg, tiszta tavakban érzi otthon magát.",
  "species_goldfish_name": "Aranyhal",
  "species_goldfish_desc": "Háziasított ázsiai pontyféle, a vadonban olívabronz színűvé válik, meleg tavakban nagy elvadult rajokat alkot.",
  "species_giant_gourami_name": "Óriásgurámi",
  "species_giant_gourami_desc": "Széles, púpos délkelet-ázsiai hal fonalszerű hasúszókkal, lassú, hínáros vízben habfészket épít.",
  "species_clown_knifefish_name": "Bohóc késhal",
  "species_clown_knifefish_desc": "Ezüstös, pengeszerű hal szemfoltokkal a hosszú, hullámzó farokalatti úszó mentén, ázsiai folyók fatörzsei alatt lebeg.",
  "species_walking_catfish_name": "Vándorló harcsa",
  "species_walking_catfish_desc": "Karcsú, levegőt lélegző harcsa, nedves talajon tekereg a tavak között, ma Floridában elvadult.",
  "species_japanese_eel_name": "Japán angolna",
  "species_japanese_eel_desc": "Kelet-ázsiai angolna, folyókban és tavakban nő fel, ívni a Csendes-óceán nyugati részére vándorol.",
  "species_ayu_name": "Ayu",
  "species_ayu_desc": "Karcsú, ezüstös japán hal, tiszta folyók kövein legeli az algát és táplálkozóterületet véd.",
  "species_baikal_omul_name": "Bajkáli omul",
  "species_baikal_omul_desc": "Ezüstös maréna, amely csak a Bajkál-tóban él, a hideg nyílt vízben rajzik és ívni a folyókba vonul fel.",
  "species_baikal_oilfish_name": "Golomjanka",
  "species_baikal_oilfish_desc": "Áttetsző, pikkely nélküli hal a Bajkál-tó mélyéből, olyan olajdús, hogy szinte átlátszó, és elevenszülő.",
  "species_murray_cod_name": "Murray-tőkehal",
  "species_murray_cod_desc": "Ausztrália legnagyobb édesvízi hala, zöldesen márványozott óriás fehér hassal, a Murray-Darling fatörzsei mellett áll.",
  "species_golden_perch_name": "Aranysügér",
  "species_golden_perch_desc": "Magas testű, aranyzöld sügér Ausztrália belső folyóiból, kidőlt fák és sziklapárkányok mellett rejtőzik.",
  "species_australian_bass_name": "Ausztrál sügér",
  "species_australian_bass_desc": "Bronzzöld sügér Kelet-Ausztrália parti folyóiból, ívni lefelé vándorol a brakkvizű torkolatokba.",
  "species_barramundi_name": "Barramundi",
  "species_barramundi_desc": "Ezüstös, púpos hátú sügér Észak-Ausztrália folyóiból és torkolataiból, korával hímből nősténnyé alakul.",
  "species_silver_perch_name": "Ezüstsügér",
  "species_silver_perch_desc": "Ezüstszürke hal a Murray-Darlingból kis szájjal és villás farokkal, egykor hatalmas rajokban járt.",
  "species_gulf_saratoga_name": "Északi saratoga",
  "species_gulf_saratoga_desc": "Bronzszínű ausztrál arowana vörös pettyes pikkelyekkel, ikráit a szájában költi az északi billabongokban.",
  "species_sooty_grunter_name": "Fekete morgóhal",
  "species_sooty_grunter_desc": "Sötét, zömök hal Észak-Ausztrália folyóiból, sziklák és zúgók körül algát és gyümölcsöt legel.",
  "species_eel_tailed_catfish_name": "Angolnafarkú harcsa",
  "species_eel_tailed_catfish_desc": "Ausztrál harcsa elkeskenyedő, angolnaszerű farokkal, tiszta folyói sekélyesekben kavicsfészket épít és őriz.",
  "species_spangled_perch_name": "Flitteres sügér",
  "species_spangled_perch_desc": "Kis, ezüstpettyes hal Ausztrália egész belső részén, minden víznyelőt benépesít, amelyet egy árvíz összeköt.",
  "species_eastern_rainbowfish_name": "Keleti szivárványhal",
  "species_eastern_rainbowfish_desc": "Kis, irizáló hal Kelet-Ausztrália patakjaiból, a hímek a napfényben vörös és kék csíkokat villantanak.",
  "species_signal_crayfish_name": "jelzőrák",
  "species_signal_crayfish_desc": "Nagy, barna folyami rák fehér folttal az olló ízületénél, invazív észak-amerikai faj, amely Európa folyóiban terjed.",
  "species_red_swamp_crayfish_name": "kaliforniai vörösrák",
  "species_red_swamp_crayfish_desc": "Sötétvörös folyami rák dudoros ollókkal Louisiana mocsaraiból, ma minden kontinens meleg vizes élőhelyeibe ássa be magát.",
  "species_noble_crayfish_name": "folyami rák",
  "species_noble_crayfish_desc": "Európa őshonos folyami rákja, sötétbarna, alul vörös ollókkal, tiszta, hűvös patakok és tavak parti üregeiben rejtőzik.",
  "species_white_clawed_crayfish_name": "Fehérkarmú rák",
  "species_white_clawed_crayfish_desc": "Kis, olajzöld folyami rák halvány ollóaljjal, Nyugat-Európa tiszta mészkőpatakjainak veszélyeztetett őshonos faja.",
  "species_tasmanian_giant_freshwater_crayfish_name": "Tasmán óriásrák",
  "species_tasmanian_giant_freshwater_crayfish_desc": "A világ legnagyobb édesvízi gerinctelenje, lassan növő kékesbarna folyami rák Tasmania árnyékos folyóiból.",
  "species_zebra_mussel_name": "vándorkagyló",
  "species_zebra_mussel_desc": "Hüvelykujjköröm méretű, csíkos kagyló, ezrével borítja be a sziklákat, roncsokat és csöveket, terjedése közben kitisztítja a vizet.",
  "species_quagga_mussel_name": "bugi vándorkagyló",
  "species_quagga_mussel_desc": "A vándorkagyló kerekebb, halványabb rokona, puha aljzatot és mély, hideg vizet népesít be, ahová a vándorkagyló nem jut el.",
  "species_freshwater_pearl_mussel_name": "Folyami gyöngykagyló",
  "species_freshwater_pearl_mussel_desc": "Sötét, megnyúlt kagyló, amely több mint egy évszázadig élhet félig beásva a gyors lazacos folyók tiszta kavicsába.",
  "species_swan_mussel_name": "tavikagyló",
  "species_swan_mussel_desc": "Nagy, vékony héjú kagyló iszapos tavakból és csatornákból, szifóival közvetlenül az iszap fölött szűri a vizet.",
  "species_chinese_pond_mussel_name": "Amuri kagyló",
  "species_chinese_pond_mussel_desc": "Nagyon nagy, invazív ázsiai kagyló fényes barna héjjal, tenyésztett halakkal érkezett és meleg tavakban terjed.",
  "species_freshwater_sponge_name": "Édesvízi szivacs",
  "species_freshwater_sponge_desc": "Zöld vagy szürke, elágazó szivacs, tiszta tavakban ágakat és köveket von be, színét a benne élő algák adják.",
  "species_freshwater_jellyfish_name": "Édesvízi medúza",
  "species_freshwater_jellyfish_desc": "Érme méretű, átlátszó medúza, nyár végén rajokban jelenik meg meleg bányatavakban és víztározókban.",
  "species_great_pond_snail_name": "nagy mocsáricsiga",
  "species_great_pond_snail_desc": "Nagy, hegyes házú csiga, az európai állóvizek növényein siklik és a felszínen levegőt lélegzik.",
  "species_great_ramshorn_snail_name": "nagy tányércsiga",
  "species_great_ramshorn_snail_desc": "Lapos, kosszarvra emlékeztető tekercses csiga, hínáros tavak levelein és kövein legeli az algát.",
  "species_channeled_apple_snail_name": "Almacsiga",
  "species_channeled_apple_snail_desc": "Nagy, aranybarna csiga, élénk rózsaszín petecsomóit a vízvonal fölé rakja, invazív a meleg vizes élőhelyeken és rizsföldeken.",
  "species_magnificent_bryozoan_name": "óriási mohaállat",
  "species_magnificent_bryozoan_desc": "Focilabda méretű, kocsonyás telep, apró állatokkal telehintve, ágakon és köteleken tapad meleg, csendes vízben.",
  "species_chinese_mitten_crab_name": "Kínai gyapjasollós rák",
  "species_chinese_mitten_crab_desc": "Üregásó rák szőrös ollókkal, éveket tölt folyókban, mielőtt a torkolatokba vándorol szaporodni.",
  "species_giant_freshwater_prawn_name": "Óriás édesvízi garnéla",
  "species_giant_freshwater_prawn_desc": "Nagy, kék ollójú garnéla Ázsia és Ausztrália folyóiból, az idős hímek ollói hosszabbak a testüknél.",
  "species_common_snapping_turtle_name": "aligátorteknős",
  "species_common_snapping_turtle_desc": "Nehéz, érdes páncélú teknős hosszú, fűrészes farokkal, kidugott fejjel fekszik tavak és lassú folyók iszapjában.",
  "species_alligator_snapping_turtle_name": "keselyűteknős",
  "species_alligator_snapping_turtle_desc": "Őskori külsejű óriás három tarajos gerinccel és féregszerű nyelvcsalival, nyitott szájjal várakozik a déli folyók fenekén.",
  "species_painted_turtle_name": "díszes ékszerteknős",
  "species_painted_turtle_desc": "Sima, sötét teknős vörös és sárga csíkokkal a nyakán és a páncél szegélyén, sorban napozik fatörzseken Észak-Amerika-szerte.",
  "species_red_eared_slider_name": "Vörösfülű ékszerteknős",
  "species_red_eared_slider_desc": "Zöld csíkos mocsári teknős vörös sávval mindkét szeme mögött, a kedvtelésből tartott teknős, ma világszerte elvadult a meleg vizekben.",
  "species_northern_map_turtle_name": "térképes tarajosteknős",
  "species_northern_map_turtle_desc": "Olajzöld teknős térképszerű sárga vonalakkal a páncélján és alacsony gerinccel, tiszta folyók és nagy tavak szikláin napozik.",
  "species_spiny_softshell_turtle_name": "tüskés lágyhéjúteknős",
  "species_spiny_softshell_turtle_desc": "Lapos, bőrszerű, palacsintára emlékeztető teknős szipkaszerű orral, sekély folyók homokjába ásva, csak a feje látszik ki.",
  "species_florida_softshell_turtle_name": "floridai lágyhéjúteknős",
  "species_florida_softshell_turtle_desc": "Nagy, sötét lágyhéjú teknős hosszú, csőszerű orral, gyakori Florida forrásaiban, csatornáiban és tavaiban.",
  "species_pig_nosed_turtle_name": "kétkarmú teknős",
  "species_pig_nosed_turtle_desc": "Egyedülálló folyami teknős Új-Guineából és Észak-Ausztráliából tengeri teknősre emlékeztető uszonyokkal és húsos, disznószerű orral.",
  "species_mary_river_turtle_name": "Mary-folyói teknős",
  "species_mary_river_turtle_desc": "Ritka ausztrál teknős, kloákáján át lélegzik és zöld algataréjt visel, egyetlen queenslandi folyóban él.",
  "species_yellow_spotted_river_turtle_name": "Terekay-folyamteknős",
  "species_yellow_spotted_river_turtle_desc": "Amazonasi nyakfordító teknős sárga fejfoltokkal, csoportosan napozik nagy folyók fatörzsein és homokpadjain.",
  "species_european_pond_turtle_name": "mocsári teknős",
  "species_european_pond_turtle_desc": "Sárga pöttyökkel hintett sötét teknős, Európa őshonos mocsári teknőse, napos partokról hínáros tavakba csusszan.",
  "species_american_alligator_name": "mississippi aligátor",
  "species_american_alligator_desc": "Széles orrú páncélos hüllő az USA délkeleti mocsaraiból, forrásaiból és folyóiból, csak a szeme és az orrlyukai látszanak ki a vízből.",
  "species_spectacled_caiman_name": "pápaszemes kajmán",
  "species_spectacled_caiman_desc": "Kis, olajzöld kajmán csontos taréjjal a szemei között, gyakori Közép- és Dél-Amerika lassú folyóiban és lagúnáiban.",
  "species_black_caiman_name": "fekete kajmán",
  "species_black_caiman_desc": "Az Amazonas legnagyobb ragadozója, akár öt méteres fekete páncélos kajmán, éjjel vadászik tavakban és elárasztott erdőben.",
  "species_freshwater_crocodile_name": "Johnson-krokodil",
  "species_freshwater_crocodile_desc": "Keskeny orrú ausztrál krokodil az északi folyókból és szurdokokból, félénk és jóval kisebb a bordás krokodilnál.",
  "species_northern_water_snake_name": "Északi vízisikló",
  "species_northern_water_snake_desc": "Vaskos testű, sávos barna kígyó, Észak-Amerika keleti patakjai fölött sziklákon és ágakon napozik, ártalmatlan, de gyorsan harap.",
  "species_green_anaconda_name": "zöld anakonda",
  "species_green_anaconda_desc": "A Föld legnehezebb kígyója, olajzöld óriás fekete foltokkal, az Amazonas mocsaraiban és lassú folyóiban fekszik a víz alatt.",
  "species_hellbender_name": "mocsári ördög",
  "species_hellbender_desc": "Óriási, lapos fejű szalamandra ráncos bőrredőkkel, az Appalache-hegység hideg, tiszta folyóiban nagy kövek alatt rejtőzik.",
  "species_mudpuppy_name": "Iszapkutya",
  "species_mudpuppy_desc": "Barna, foltos szalamandra, tollas vörös kopoltyúit egész életében megtartja, éjjel tó- és folyófenéken mászik.",
  "species_axolotl_name": "mexikói axolotl",
  "species_axolotl_desc": "Mosolygós, kopoltyús szalamandra, sosem hagyja el a vizet, kritikusan veszélyeztetett Xochimilco csatornáiban Mexikóváros mellett.",
  "species_chinese_giant_salamander_name": "Kínai óriásszalamandra",
  "species_chinese_giant_salamander_desc": "A legnagyobb élő kétéltű, ráncos, barna, közel két méteres óriás, hűvös, sziklás hegyi patakokban rejtőzik.",
  "species_smooth_newt_name": "Pettyes gőte",
  "species_smooth_newt_desc": "Kis, olajzöld gőte, minden tavasszal visszatér a tavakba, a hímek hullámos tarajt és foltos narancssárga hasat növesztenek.",
  "species_great_crested_newt_name": "Közönséges tarajosgőte",
  "species_great_crested_newt_desc": "Nagy, fekete, szemölcsös gőte tűznarancs hassal, a nászruhás hímek csipkézett, sárkányszerű tarajt viselnek.",
  "species_american_bullfrog_name": "ökörbéka",
  "species_american_bullfrog_desc": "Hatalmas zöld béka mély, bőgő hanggal, meleg tavak tavirózsái között ül, ma több kontinensen invazív.",
  "species_common_frog_name": "Gyepi béka",
  "species_common_frog_desc": "Barna béka sötét szemmaszkkal, tavasszal hangos tömegekben gyűlik össze petézni az európai tavakban és árkokban.",
  "species_north_american_river_otter_name": "kanadai vidra",
  "species_north_american_river_otter_desc": "Karcsú, játékos vidra, Észak-Amerika folyóiban és tavaiban halakra és rákokra vadászik, a partokon sárcsúszdákat hagy.",
  "species_eurasian_otter_name": "európai vidra",
  "species_eurasian_otter_desc": "Félénk, barna vidra Európa folyóiból, tavaiból és partjairól, évtizedes hanyatlás után egész elterjedési területén erősödik.",
  "species_giant_otter_name": "óriásvidra",
  "species_giant_otter_desc": "Közel két méteres vidra krémszínű torokfolttal, zajos családi csoportokban él az Amazonas folyóin és morotvatavain.",
  "species_north_american_beaver_name": "kanadai hód",
  "species_north_american_beaver_desc": "Nagy, lapos farkú rágcsáló, patakokat duzzaszt tavakká és a jég alatt úszik, ágakból épített várában húzza meg magát.",
  "species_eurasian_beaver_name": "eurázsiai hód",
  "species_eurasian_beaver_desc": "Európa legnagyobb rágcsálója, a kontinens egészén visszatelepítették, parti fákat dönt ki, gátakat és várakat épít.",
  "species_muskrat_name": "Pézsmapocok",
  "species_muskrat_desc": "Patkány méretű, barna rágcsáló pikkelyes, lapított farokkal, gyékényes mocsarakban úszik és kupolás nádvárakat épít.",
  "species_platypus_name": "kacsacsőrű emlős",
  "species_platypus_desc": "Tojásrakó emlős kacsacsőrrel és úszóhártyás lábakkal, csukott szemmel keres táplálékot Kelet-Ausztrália patakjaiban hajnalban és alkonyatkor.",
  "species_amazonian_manatee_name": "dél-amerikai manátusz",
  "species_amazonian_manatee_desc": "A legkisebb manátusz, sima, sötét növényevő fehér mellfolttal, az Amazonas tavaiban és folyóiban vízinövényeket legel.",
  "species_amazon_river_dolphin_name": "amazonasi folyamidelfin",
  "species_amazon_river_dolphin_desc": "Rózsaszín, hosszú csőrű delfin hajlékony nyakkal, az Amazonas és az Orinoco elárasztott erdőinek fatörzsei között kanyarog.",
  "species_baikal_seal_name": "bajkáli fóka",
  "species_baikal_seal_desc": "A világ egyetlen édesvízi fókája, kis, ezüstszürke fóka, a Bajkál-tó jegén és sziklás partjain pihen.",
  "species_capybara_name": "vízidisznó",
  "species_capybara_desc": "A legnagyobb rágcsáló, hordó alakú növényevő, nyugodt csordákban gázol és úszik Dél-Amerika folyóiban és vizes élőhelyein.",
  "species_hippopotamus_name": "nílusi víziló",
  "species_hippopotamus_desc": "Hatalmas afrikai folyami óriás, a napot csoportokban a víz alatt tölti, és inkább jár a fenéken, mint úszik; veszélyes megközelíteni.",
  "species_white_water_lily_name": "fehér tündérrózsa",
  "species_white_water_lily_desc": "Úszó, kerek levelek és nagy fehér virágok, amelyek az európai állóvizek iszapjában gyökerező vastag rizómákból emelkednek ki.",
  "species_yellow_pond_lily_name": "sárga vízitök",
  "species_yellow_pond_lily_desc": "Szív alakú úszólevelek és kehelyszerű sárga virágok, nagy, áttetsző víz alatti levelekkel, amelyeket a búvárok alulról látnak.",
  "species_american_eelgrass_name": "Amerikai vízicsavar",
  "species_american_eelgrass_desc": "Szalagszerű, akár két méter hosszú levelek, tiszta folyók és források sodrában ringatóznak, a manátuszok kedvence.",
  "species_coontail_name": "érdes tócsagaz",
  "species_coontail_desc": "Gyökértelen, alámerült növény merev, villás levelekből álló örvökkel, mint egy mosómedve farka, sűrű tömegekben sodródik az állóvízben.",
  "species_eurasian_watermilfoil_name": "füzéres süllőhínár",
  "species_eurasian_watermilfoil_desc": "Tollszerű, alámerült növény finoman szeldelt levelekből álló örvökkel, a felszín közelében vastag szőnyeget alkot, sok tóban invazív.",
  "species_muskgrass_name": "Csillárka",
  "species_muskgrass_desc": "Törékeny, pézsmaillatú zöldalga örvös ágakkal, gyakran mészkéreggel borítva, tiszta, kemény vizű tavak fenekét szőnyegezi be.",
  "species_canadian_waterweed_name": "kanadai átokhínár",
  "species_canadian_waterweed_desc": "Sűrű, alámerült növény három kis sötétzöld levélből álló örvökkel, töredékekkel terjed hűvös tavakban és csatornákban világszerte.",
  "species_curly_leaf_pondweed_name": "Bodros békaszőlő",
  "species_curly_leaf_pondweed_desc": "Alámerült növény hullámos szélű, vörösesnek tűnő zöld levelekkel, mint a fodros lasagne, kora tavasszal nő, más hínárok előtt.",
  "species_water_hyacinth_name": "közönséges vízijácint",
  "species_water_hyacinth_desc": "Úszó növény fényes levelekkel levegővel telt szárakon és levendulaszínű virágfüzérekkel, világszerte elfojtja a meleg vízi utakat.",
  "species_common_reed_name": "Közönséges nád",
  "species_common_reed_desc": "Magas, tollas bugájú fűféle, sűrű nádasokat alkot a tópartokon; víz alatti szárai ivadékoknak és szitakötőlárváknak adnak menedéket.",
