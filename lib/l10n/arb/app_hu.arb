  "species_olive_ridley_sea_turtle_name": "Olajzöld teknős",
  "species_olive_ridley_sea_turtle_desc": "A legkisebb tengeriteknős-faj, amely az arribada néven ismert összehangolt tömeges fészkeléseiről híres.",
  "species_kemps_ridley_sea_turtle_name": "Kemp-teknős",
  "species_kemps_ridley_sea_turtle_desc": "Súlyosan veszélyeztetett tengeri teknős, amely elsősorban a Mexikói-öbölben él.",
  "species_flatback_sea_turtle_name": "Laposhátú teknős",
  "species_flatback_sea_turtle_desc": "Az ausztrál vizek endemikus faja, amelyet lapos páncélja és part menti élőhelye különböztet meg.",
  "species_brain_coral_name": "Agykorall",
  "species_brain_coral_desc": "Hatalmas zátonyépítő korall barázdált felszínnel, amely egy agyra emlékeztet, gyakori a karibi zátonyokon.",
  "species_staghorn_coral_name": "Agancskorall",
  "species_staghorn_coral_desc": "Gyorsan növő, elágazó korall, amely sűrű bozótokat alkot, a zátonyi halak létfontosságú élőhelye.",
  "species_elkhorn_coral_name": "Jávorszarvas-korall",
  "species_elkhorn_coral_desc": "Nagy, elágazó korall lapos, tenyeres ágakkal, a Karib-tenger egyik kulcsfontosságú zátonyépítője.",
  "species_table_coral_name": "Asztalkorall",
  "species_table_coral_desc": "Lapos, táblát formáló korall az indo-csendes-óceáni zátonyokon, számos halfajnak nyújt menedéket.",
  "species_mushroom_coral_name": "Gombakorall",
  "species_mushroom_coral_desc": "Szabadon élő, magányos, korong alakú korall az indo-csendes-óceáni zátonyok melletti homokos részeken.",
  "species_bubble_coral_name": "Buborékkorall",
  "species_bubble_coral_desc": "Jellegzetes korall szőlőszemre emlékeztető hólyagokkal, amelyek nappal felfúvódva gyűjtik a fényt.",
  "species_plate_coral_name": "Tányérkorall",
  "species_plate_coral_desc": "Vékony, lemezes korall, amely örvénylő polcokat alkot, gyakori az indo-csendes-óceáni zátonylejtőkön.",
  "species_pillar_coral_name": "Oszlopkorall",
  "species_pillar_coral_desc": "Ritka, felfelé növő korall, amely magas oszlopokat alkot, a Karib-tengeren él.",
  "species_star_coral_name": "Csillagkorall",
  "species_star_coral_desc": "A Karib-tenger egyik fő zátonyépítője, nagy, sziklatömb alakú telepeket alkot csillag alakú polipokkal.",
  "species_lettuce_coral_name": "Salátakorall",
  "species_lettuce_coral_desc": "Vékony, lemezes korall levélszerű redőkkel, gyakori a karibi zátonyfalakon és lejtőkön.",
  "species_finger_coral_name": "Ujjkorall",
  "species_finger_coral_desc": "Erős, elágazó korall vastag, ujjszerű nyúlványokkal, sekély zátonyokon él.",
  "species_massive_porites_name": "Tömör Porites korall",
  "species_massive_porites_desc": "Nagy, sziklatömb alakú korall, amely évszázadokig növekedhet, az Indo-csendes-óceán meghatározó zátonyépítője.",
  "species_cauliflower_coral_name": "Karfiolkorall",
  "species_cauliflower_coral_desc": "Tömör, elágazó korall karfiolszerű alakkal, széles körben elterjedt a trópusi zátonyok sekély vizeiben.",
  "species_flower_pot_coral_name": "Virágcserép korall",
  "species_flower_pot_coral_desc": "Hosszú csápú polipokból álló telep, amelyek nappal kinyúlva egy virágcsokorra emlékeztetnek.",
  "species_cup_coral_name": "Narancssárga kehelykorall",
  "species_cup_coral_desc": "Élénk narancssárga, nem fotoszintetizáló korall a trópusi vizek falain és túlnyúlásai alatt.",
  "species_scroll_coral_name": "Tekercskorall",
  "species_scroll_coral_desc": "Nagy, tekercsszerű lemezeket alkotó korall, gyakori az indo-csendes-óceáni zátonylejtőkön és lagúnákban.",
  "species_cabbage_coral_name": "Káposztakorall",
  "species_cabbage_coral_desc": "Korong alakú, lemezes korall, amely káposztalevelekre emlékeztet, védett zátonyterületeken él.",
  "species_hammer_coral_name": "Kalapácskorall",
  "species_hammer_coral_desc": "Nagy polipú korall horgony vagy kalapács alakú csápvégekkel, kedvelt látvány az indo-csendes-óceáni zátonyokon.",
  "species_torch_coral_name": "Fáklyakorall",
  "species_torch_coral_desc": "Elágazó korall hosszú, hullámzó csápokkal, amelyek végén világító gömbök ülnek.",
  "species_frogspawn_coral_name": "Békaikra-korall",
  "species_frogspawn_coral_desc": "Nagy polipú korall elágazó csápvégekkel, amelyek békaikrára emlékeztetnek.",
  "species_sea_fan_name": "Közönséges tengeri legyező",
  "species_sea_fan_desc": "Lapos, legyező alakú gorgónia, amely az áramlásra merőlegesen áll, a karibi zátonyok ikonikus látványa.",
  "species_venus_sea_fan_name": "Vénusz tengeri legyező",
  "species_venus_sea_fan_desc": "Finom, legyező alakú gorgónia a sekély karibi zátonyokon, mérsékelt áramlású területeken.",
  "species_deepwater_sea_fan_name": "Mélyvízi tengeri legyező",
  "species_deepwater_sea_fan_desc": "Nagy, bokros gorgónia a Karib-tenger mély zátonyfalain.",
  "species_sea_whip_name": "Tengeri ostor",
  "species_sea_whip_desc": "Karcsú, pálca alakú gorgónia, amely az atlanti és karibi zátonyokon az áramlatban ring.",
  "species_sea_plume_name": "Tengeri tollbokréta",
  "species_sea_plume_desc": "Magas, tollas gorgónia, amely bokrétaszerű telepeket alkot a karibi zátonytetőkön.",
  "species_organ_pipe_coral_name": "Orgonasípkorall",
  "species_organ_pipe_coral_desc": "Élénkvörös vázcsövek finom polipokkal, védett indo-csendes-óceáni zátonyokon él.",
  "species_leather_coral_name": "Bőrkorall",
  "species_leather_coral_desc": "Lágykorall sima, bőrszerű felszínnel, amely nagy, gomba alakú telepeket alkot.",
  "species_toadstool_leather_coral_name": "Gombakalapos bőrkorall",
  "species_toadstool_leather_coral_desc": "Lágykorall vastag nyéllel és lapos kalappal, gyakori az indo-csendes-óceáni zátonylapokon.",
  "species_pulsing_xenia_name": "Lüktető xenia",
  "species_pulsing_xenia_desc": "Lágykorall ütemesen lüktető polipokkal, védett indo-csendes-óceáni vizekben él.",
  "species_tree_coral_name": "Fakorall",
  "species_tree_coral_desc": "Élénk színű lágykorall, amely fa alakú csoportokat alkot a Vörös-tenger falain és túlnyúlásai alatt.",
  "species_blue_coral_name": "Kékkorall",
  "species_blue_coral_desc": "Egyedülálló nyolcosztatú korall kék vázzal, a sekély indo-csendes-óceáni zátonylapokon él.",
  "species_black_coral_name": "Feketekorall",
  "species_black_coral_desc": "Mélyvízi korall sötét vázzal, falakon és letöréseken, 30 méter alatt található.",
  "species_carnation_coral_name": "Szegfűkorall",
  "species_carnation_coral_desc": "Élénk színű lágykorall, amely az Indo-csendes-óceánon a sziklapárkányok alatt és a falakon él.",
  "species_wire_coral_name": "Drótkorall",
  "species_wire_coral_desc": "Hosszú, spirális feketekorall, amely csavart ostorokat alkot, gébeknek és garnéláknak ad otthont.",
  "species_dead_mans_fingers_name": "Halottujj-korall",
  "species_dead_mans_fingers_desc": "Húsos lágykorall ujjszerű karéjokkal, gyakori az Atlanti-óceán északi részének mérsékelt övi zátonyain.",
  "species_sun_coral_name": "Napkorall",
  "species_sun_coral_desc": "Sárgásnarancs, nem fotoszintetizáló korall, amely éjszaka nyitja ki polipjait az indo-csendes-óceáni falakon.",
  "species_lace_coral_name": "Csipkekorall",
  "species_lace_coral_desc": "Finom rózsaszín hidrakorall csipkeszerű ágakkal, repedésekben és sziklapárkányok alatt él.",
  "species_kenya_tree_coral_name": "Kenyai fakorall",
  "species_kenya_tree_coral_desc": "Szívós lágykorall fa alakú ágakkal, gyakori az Indo-csendes-óceánon.",
  "species_colt_coral_name": "Csikókorall",
  "species_colt_coral_desc": "Lágykorall vastag, gumiszerű ágakkal, amelyeket apró polipok borítanak az indo-csendes-óceáni zátonyokon.",
  "species_turtle_grass_name": "Teknősfű",
  "species_turtle_grass_desc": "A Karib-tenger meghatározó tengerifüve széles, lapos levelekkel, a tengeri teknősök létfontosságú tápláléka.",
  "species_eelgrass_name": "Tengeri angolnafű",
  "species_eelgrass_desc": "Mérsékelt övi tengerifű, amely sűrű víz alatti réteket alkot, és fontos ivadéknevelő élőhely.",
  "species_manatee_grass_name": "Lamantinfű",
  "species_manatee_grass_desc": "Hengeres levelű tengerifű a Karib-tenger homokos részein, gyakran teknősfűmezők közelében.",
  "species_shoal_grass_name": "Zátonyfű",
  "species_shoal_grass_desc": "Úttörő tengerifű keskeny levelekkel, amely a Karib-tengeren a bolygatott homokos területeket népesíti be.",
  "species_paddle_grass_name": "Lapátfű",
  "species_paddle_grass_desc": "Kis, finom tengerifű ovális levelekkel, a trópusokon mélyebb vizekben fordul elő.",
  "species_neptune_grass_name": "Neptunfű",
  "species_neptune_grass_desc": "Földközi-tengeri tengerifű, amely hatalmas réteket alkot, és létfontosságú a part menti tengeri ökoszisztémák számára.",
  "species_giant_kelp_name": "Óriásmoszat",
  "species_giant_kelp_desc": "Akár 60 méter magasra növő víz alatti erdőalkotó faj, a kaliforniai merülések ikonikus növénye.",
  "species_bull_kelp_name": "Bikamoszat",
  "species_bull_kelp_desc": "Csendes-óceáni moszat egyetlen hosszú nyéllel és gömbölyű úszóhólyaggal, sűrű lombkoronaerdőket alkot.",
  "species_bladder_wrack_name": "Hólyagos moszat",
  "species_bladder_wrack_desc": "Gyakori barnamoszat páros léghólyagokkal, az Atlanti-óceán északi részének árapályzónájában él.",
  "species_sargassum_name": "Szargasszumhínár",
  "species_sargassum_desc": "Szabadon lebegő barnamoszat, amely tutajokat alkot, és menedéket nyújt a fiatal halaknak és gerincteleneknek.",
  "species_kelp_forest_ecklonia_name": "Ecklonia moszat",
  "species_kelp_forest_ecklonia_desc": "A déli félteke vizeinek meghatározó moszatja, amely fontos víz alatti erdőket alkot.",
  "species_coralline_algae_name": "Korallmoszat",
  "species_coralline_algae_desc": "Kemény, bevonatot képző vörösmoszat, amely összecementezi a zátony szerkezetét, és rózsaszín árnyalatot ad neki.",
  "species_irish_moss_name": "Ír moszat",
  "species_irish_moss_desc": "Legyező alakú vörösmoszat az Atlanti-óceán északi részének sziklás partjain, az árapályzónában.",
  "species_dulse_name": "Tenyeres vörösmoszat",
  "species_dulse_desc": "Lapos, vörösesbíbor moszat, amely sziklákon és moszatnyeleken nő a hideg északi vizekben.",
  "species_halimeda_name": "Halimeda",
  "species_halimeda_desc": "Meszes zöldmoszat korong alakú szelvényekkel, jelentős mértékben hozzájárul a zátonyhomok képződéséhez.",
  "species_sea_lettuce_name": "Tengeri saláta",
  "species_sea_lettuce_desc": "Élénkzöld, lemezes moszat, világszerte sekély part menti vizekben él.",
  "species_caulerpa_name": "Zöld szőlőmoszat",
  "species_caulerpa_desc": "Kúszó zöldmoszat szőlőszemre emlékeztető ágakkal, trópusi zátonytörmeléken és homokon él.",
  "species_mermaid_fan_name": "Sellőlegyező",
  "species_mermaid_fan_desc": "Meszes zöldmoszat kis legyező alakjával, gyakori a karibi homokos fenéken.",
  "species_shaving_brush_algae_name": "Borotvapamacs moszat",
  "species_shaving_brush_algae_desc": "Meszes zöldmoszat nyélen ülő, ecsetszerű bojttal, a karibi homokos fenéken él.",
  "species_finger_kelp_name": "Ujjas moszat",
  "species_finger_kelp_desc": "Barnamoszat ujjszerű levelekkel, amely moszatágyakat alkot az Atlanti-óceán északi részének part menti vizeiben.",
  "species_banded_sea_krait_name": "Sávos tengeri krajt",
  "species_banded_sea_krait_desc": "Mérges tengeri kígyó kékesszürke és fekete sávokkal, szelíd természetű, gyakran látható az indo-csendes-óceáni zátonyokon.",
  "species_olive_sea_snake_name": "Olívzöld tengeri kígyó",
  "species_olive_sea_snake_desc": "Kíváncsi tengeri kígyó az ausztrál zátonyokon, amely gyakran közelít a búvárokhoz.",
  "species_yellow_bellied_sea_snake_name": "Sárgahasú tengeri kígyó",
  "species_yellow_bellied_sea_snake_desc": "Nyíltvízi tengeri kígyó sárga hassal, a Föld legelterjedtebb kígyófaja.",
  "species_marine_iguana_name": "Tengeri leguán",
  "species_marine_iguana_desc": "A Galápagos endemikus faja, az egyetlen gyík, amely a víz alatt algával táplálkozik.",
  "species_saltwater_crocodile_name": "Bordás krokodil",
  "species_saltwater_crocodile_desc": "A legnagyobb élő hüllő, amely az Indo-csendes-óceán part menti és torkolati vizeiben él.",
