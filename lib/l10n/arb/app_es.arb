  "species_sun_coral_name": "Coral sol",
  "species_sun_coral_desc": "Coral no fotosintético de color amarillo anaranjado que abre sus pólipos de noche en las paredes del Indopacífico.",
  "species_lace_coral_name": "Coral encaje",
  "species_lace_coral_desc": "Delicado hidrocoral rosado con ramas como de encaje, habita grietas y zonas bajo los salientes.",
  "species_kenya_tree_coral_name": "Coral árbol de Kenia",
  "species_kenya_tree_coral_desc": "Coral blando resistente de ramas arborescentes, común en el Indopacífico.",
  "species_colt_coral_name": "Coral potro",
