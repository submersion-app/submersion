  "species_shoal_grass_name": "Hierba de bajío",
  "species_shoal_grass_desc": "Fanerógama pionera de hojas estrechas que coloniza las zonas arenosas alteradas del Caribe.",
  "species_paddle_grass_name": "Hierba pala",
