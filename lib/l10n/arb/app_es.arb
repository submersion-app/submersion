  "species_finger_coral_name": "Coral dedo",
  "species_finger_coral_desc": "Coral ramificado y robusto con gruesas proyecciones en forma de dedo, habita los arrecifes someros.",
  "species_massive_porites_name": "Coral Porites masivo",
  "species_massive_porites_desc": "Gran coral masivo que puede crecer durante siglos, un constructor dominante de los arrecifes del Indopacífico.",
  "species_cauliflower_coral_name": "Coral coliflor",
  "species_cauliflower_coral_desc": "Coral ramificado y compacto con forma de coliflor, extendido por las zonas someras de los arrecifes tropicales.",
  "species_flower_pot_coral_name": "Coral maceta",
  "species_flower_pot_coral_desc": "Colonia de pólipos de tentáculos largos que se extienden durante el día y recuerdan a un ramo de flores.",
  "species_cup_coral_name": "Coral copa naranja",
  "species_cup_coral_desc": "Coral no fotosintético de un naranja brillante que habita paredes y voladizos de aguas tropicales.",
  "species_scroll_coral_name": "Coral pergamino",
  "species_scroll_coral_desc": "Coral que forma grandes placas enrolladas, común en los taludes y las lagunas de los arrecifes del Indopacífico.",
  "species_cabbage_coral_name": "Coral col",
  "species_cabbage_coral_desc": "Coral laminar con forma de disco que recuerda a las hojas de una col, habita zonas resguardadas del arrecife.",
  "species_hammer_coral_name": "Coral martillo",
  "species_hammer_coral_desc": "Coral de pólipos grandes con las puntas de los tentáculos en forma de ancla o martillo, muy presente en los arrecifes del Indopacífico.",
  "species_torch_coral_name": "Coral antorcha",
  "species_torch_coral_desc": "Coral ramificado con largos tentáculos ondulantes rematados por bulbos luminosos.",
  "species_frogspawn_coral_name": "Coral huevas de rana",
  "species_frogspawn_coral_desc": "Coral de pólipos grandes con las puntas de los tentáculos ramificadas, parecidas a huevos de rana.",
  "species_sea_fan_name": "Abanico de mar común",
  "species_sea_fan_desc": "Gorgonia plana en forma de abanico orientada perpendicular a la corriente, icónica en los arrecifes del Caribe.",
  "species_venus_sea_fan_name": "Abanico de mar de Venus",
  "species_venus_sea_fan_desc": "Delicada gorgonia en forma de abanico que habita los arrecifes someros del Caribe en zonas de corriente moderada.",
  "species_deepwater_sea_fan_name": "Abanico de mar de aguas profundas",
  "species_deepwater_sea_fan_desc": "Gran gorgonia arbustiva que habita las paredes profundas de los arrecifes del Caribe.",
  "species_sea_whip_name": "Látigo de mar",
  "species_sea_whip_desc": "Gorgonia esbelta con forma de vara que se mece con la corriente en los arrecifes del Atlántico y del Caribe.",
  "species_sea_plume_name": "Penacho de mar",
  "species_sea_plume_desc": "Gorgonia alta y plumosa que forma colonias en forma de penacho en las partes altas de los arrecifes del Caribe.",
  "species_organ_pipe_coral_name": "Coral tubo de órgano",
