  "species_carnation_coral_name": "Coral clavel",
  "species_carnation_coral_desc": "Coral blando de colores vivos que habita bajo los salientes y en las paredes del Indopacífico.",
  "species_wire_coral_name": "Coral alambre",
  "species_wire_coral_desc": "Coral negro alargado y espiral que forma látigos enrollados, alberga gobios y camarones.",
  "species_dead_mans_fingers_name": "Dedos de hombre muerto",
