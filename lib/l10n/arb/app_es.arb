  "species_leather_coral_name": "Coral cuero",
  "species_leather_coral_desc": "Coral blando de superficie lisa y coriácea que forma grandes colonias con forma de seta.",
  "species_toadstool_leather_coral_name": "Coral cuero seta",
  "species_toadstool_leather_coral_desc": "Coral blando con un pie grueso y un sombrero plano, común en las planicies de arrecife del Indopacífico.",
  "species_pulsing_xenia_name": "Xenia pulsante",
