  "species_coralline_algae_name": "Algas coralinas",
  "species_coralline_algae_desc": "Alga roja incrustante y dura que cementa las estructuras del arrecife y le da un tono rosado.",
  "species_irish_moss_name": "Musgo de Irlanda",
  "species_irish_moss_desc": "Alga roja con forma de abanico que habita las costas rocosas de la zona intermareal del Atlántico Norte.",
  "species_dulse_name": "Dulse",
  "species_dulse_desc": "Alga plana de color rojo violáceo que crece sobre rocas y estipes de kelp en las frías aguas del norte.",
  "species_halimeda_name": "Halimeda",
  "species_halimeda_desc": "Alga verde calcificada con segmentos en forma de disco, gran contribuyente a la arena del arrecife.",
  "species_sea_lettuce_name": "Lechuga de mar",
  "species_sea_lettuce_desc": "Alga verde brillante con forma de lámina que habita aguas costeras someras de todo el mundo.",
  "species_caulerpa_name": "Alga uva verde",
  "species_caulerpa_desc": "Alga verde rastrera con frondas parecidas a uvas, habita el cascajo y la arena de los arrecifes tropicales.",
  "species_mermaid_fan_name": "Abanico de sirena",
  "species_mermaid_fan_desc": "Alga verde calcificada con forma de pequeño abanico, común en los fondos arenosos del Caribe.",
  "species_shaving_brush_algae_name": "Alga brocha de afeitar",
  "species_shaving_brush_algae_desc": "Alga verde calcificada con un mechón en forma de brocha sobre un pie, habita los fondos arenosos del Caribe.",
  "species_finger_kelp_name": "Laminaria",
  "species_finger_kelp_desc": "Alga parda con frondas en forma de dedos que forma praderas de kelp en las aguas costeras del Atlántico Norte.",
  "species_banded_sea_krait_name": "Serpiente marina de bandas",
  "species_banded_sea_krait_desc": "Serpiente marina venenosa con bandas gris azuladas y negras, dócil y muy habitual en los arrecifes del Indopacífico.",
  "species_olive_sea_snake_name": "Serpiente marina oliva",
  "species_olive_sea_snake_desc": "Serpiente marina curiosa de los arrecifes australianos, conocida por acercarse a los buceadores.",
  "species_yellow_bellied_sea_snake_name": "Serpiente marina de vientre amarillo",
