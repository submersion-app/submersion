  "species_batfish_teira_name": "Poisson chauve-souris à longues nageoires",
  "species_batfish_teira_desc": "Poisson chauve-souris aux nageoires hautes portant une tache sombre près de la pectorale, souvent vu aux stations de nettoyage et sur les épaves.",
  "species_batfish_pinnatus_name": "Poisson chauve-souris pinnatus",
  "species_batfish_pinnatus_desc": "Les juvéniles sont noir de jais bordés d'orange vif et ressemblent à un ver plat toxique. Présent dans le Pacifique Ouest.",
  "species_banggai_cardinalfish_name": "Apogon des Banggai",
  "species_banggai_cardinalfish_desc": "Apogon saisissant, argenté et noir, aux nageoires allongées, endémique des îles Banggai en Indonésie.",
  "species_pajama_cardinalfish_name": "Apogon pyjama",
  "species_pajama_cardinalfish_desc": "Apogon original à la face jaune, à la bande sombre médiane et à l'arrière tacheté, présent parmi les coraux de l'Indo-Pacifique.",
  "species_longnose_hawkfish_name": "Poisson-faucon à long nez",
  "species_longnose_hawkfish_desc": "Petit poisson blanc au quadrillage rouge et au museau allongé, perché sur les gorgones et les coraux noirs.",
  "species_arc_eye_hawkfish_name": "Poisson-faucon à arc oculaire",
  "species_arc_eye_hawkfish_desc": "Petit poisson-faucon reconnaissable à l'arc orange derrière l'oeil, souvent perché sur les massifs coralliens des récifs indo-pacifiques.",
  "species_flame_hawkfish_name": "Poisson-faucon flamme",
  "species_flame_hawkfish_desc": "Poisson-faucon rouge éclatant aux marques sombres autour de l'oeil, perché dans les coraux Pocillopora du Pacifique Ouest.",
  "species_fire_goby_name": "Gobie de feu",
  "species_fire_goby_desc": "Élégant gobie blanc à la haute première nageoire dorsale et à la queue rouge orangé, en suspension au-dessus des débris coralliens indo-pacifiques.",
  "species_purple_firefish_name": "Gobie de feu pourpre",
  "species_purple_firefish_desc": "Gobie délicat aux nageoires violettes et à la longue épine dorsale, en suspension près de son terrier sur les récifs externes indo-pacifiques.",
  "species_yellownose_goby_name": "Gobie à nez jaune",
  "species_yellownose_goby_desc": "Minuscule gobie nettoyeur des Caraïbes au museau jaune et à la bande latérale bleue, présent sur les éponges et les massifs coralliens.",
  "species_citron_goby_name": "Gobie citron",
  "species_citron_goby_desc": "Minuscule gobie jaune vif qui vit parmi les branches des coraux Acropora sur les récifs indo-pacifiques.",
  "species_shrimp_goby_name": "Gobie crevette de Steinitz",
  "species_shrimp_goby_desc": "Gobie couleur sable qui partage un terrier avec une crevette alphéidé dans une relation mutualiste sur les fonds sableux indo-pacifiques.",
  "species_neon_goby_name": "Gobie néon",
  "species_neon_goby_desc": "Minuscule gobie sombre orné d'une éclatante bande bleu néon, qui tient des stations de nettoyage sur les massifs coralliens des Caraïbes.",
  "species_bluestriped_fangblenny_name": "Blennie à raie bleue",
  "species_bluestriped_fangblenny_desc": "Petite blennie rayée de bleu qui imite les labres nettoyeurs pour arracher les écailles des poissons imprudents.",
  "species_sailfin_blenny_name": "Blennie voilière",
  "species_sailfin_blenny_desc": "Minuscule blennie des Caraïbes qui déploie une grande nageoire dorsale en forme de voile depuis son tube pour attirer les femelles.",
  "species_bicolor_blenny_name": "Blennie bicolore",
  "species_bicolor_blenny_desc": "Petite blennie à l'avant brun foncé et à l'arrière orange, qui pointe la tête hors des trous des récifs indo-pacifiques.",
  "species_redlip_blenny_name": "Blennie à lèvres rouges",
  "species_redlip_blenny_desc": "Blennie sombre aux lèvres rouge orangé marquées, qui défend ses plaques d'algues sur les crêtes récifales des Caraïbes.",
  "species_pygmy_seahorse_name": "Hippocampe pygmée de Bargibant",
  "species_pygmy_seahorse_desc": "Minuscule hippocampe de moins de 2 cm qui se confond parfaitement avec sa gorgone hôte, sujet macro très prisé.",
  "species_common_seahorse_name": "Hippocampe commun",
  "species_common_seahorse_desc": "Hippocampe de taille moyenne présent dans les herbiers et les débris coralliens de tout l'Indo-Pacifique, de couleur variable.",
  "species_thorny_seahorse_name": "Hippocampe épineux",
  "species_thorny_seahorse_desc": "Hippocampe couvert de longues épines, présent dans les herbiers et sur les fonds meubles de tout l'Indo-Pacifique.",
  "species_ornate_ghost_pipefish_name": "Poisson-fantôme orné",
  "species_ornate_ghost_pipefish_desc": "Syngnathe fantôme au camouflage élaboré, en suspension tête en bas près des crinoïdes et des coraux mous de l'Indo-Pacifique.",
  "species_robust_ghost_pipefish_name": "Poisson-fantôme robuste",
  "species_robust_ghost_pipefish_desc": "Grand poisson-fantôme qui imite un brin d'herbier ou une algue, souvent trouvé en couple dans les eaux côtières indo-pacifiques.",
  "species_trumpetfish_name": "Poisson-trompette",
  "species_trumpetfish_desc": "Poisson long et élancé qui chasse en se dissimulant derrière de plus gros poissons, présent sur les récifs des Caraïbes et de l'Atlantique dans des coloris variés.",
  "species_cornetfish_name": "Poisson-flûte",
  "species_cornetfish_desc": "Poisson extrêmement allongé atteignant 1,5 m, prolongé par un filament caudal, souvent vu glisser au-dessus des platiers.",
  "species_yellowhead_jawfish_name": "Poisson-bâilleur à tête jaune",
  "species_yellowhead_jawfish_desc": "Petit poisson au corps bleu et à la tête jaune, en suspension au-dessus de son terrier sableux sur les récifs des Caraïbes. Les mâles incubent les oeufs dans leur bouche.",
  "species_flamefish_name": "Apogon flamme",
  "species_flamefish_desc": "Petit apogon rouge vif portant une tache sombre sous la seconde nageoire dorsale, caché le jour dans les anfractuosités des récifs des Caraïbes.",
  "species_longspine_squirrelfish_name": "Poisson-écureuil à longue épine",
  "species_longspine_squirrelfish_desc": "Poisson rouge nocturne aux grands yeux et à la longue épine dorsale, réfugié le jour sous les surplombs des récifs des Caraïbes.",
  "species_soldierfish_name": "Poisson-soldat à grandes écailles",
  "species_soldierfish_desc": "Poisson rouge nocturne aux énormes yeux sombres et aux grandes écailles, qui forme des groupes dans les grottes et sous les surplombs pendant la journée.",
  "species_flame_angelfish_name": "Poisson-ange flamme",
  "species_flame_angelfish_desc": "Poisson-ange nain rouge orangé éclatant, barré de noir et aux nageoires bordées de bleu, présent dans tout le Pacifique.",
  "species_royal_gramma_name": "Gramma royal",
  "species_royal_gramma_desc": "Petit poisson bicolore des Caraïbes, violet sur la moitié avant et jaune sur la moitié arrière, présent sous les surplombs.",
  "species_anthias_lyretail_name": "Anthias à queue de lyre",
  "species_anthias_lyretail_desc": "Poisson de récif abondant qui forme de grands nuages orange et roses au-dessus des formations coralliennes indo-pacifiques. Les mâles sont violets.",
  "species_mediterranean_grouper_name": "Mérou brun",
  "species_mediterranean_grouper_desc": "Grand mérou brun foncé marbré de clair, prédateur emblématique des récifs rocheux de Méditerranée.",
  "species_mediterranean_moray_name": "Murène de Méditerranée",
  "species_mediterranean_moray_desc": "Murène brun foncé marbrée de jaune, couramment observée à l'affût dans les anfractuosités rocheuses de Méditerranée.",
  "species_ornate_wrasse_name": "Girelle paon",
  "species_ornate_wrasse_desc": "Labre vert coloré aux marques rouges sur la tête, l'un des labres les plus communs des récifs de Méditerranée.",
  "species_red_sea_bannerfish_name": "Poisson-papillon masqué",
  "species_red_sea_bannerfish_desc": "Poisson-papillon jaune vif portant une tache oculaire sombre, endémique de la mer Rouge. Souvent observé en couple.",
  "species_red_sea_anemonefish_name": "Poisson-clown de la mer Rouge",
  "species_red_sea_anemonefish_desc": "Poisson-clown jaune orangé barré de deux bandes blanches, endémique de la mer Rouge et du golfe d'Aden.",
  "species_arabian_angelfish_name": "Poisson-ange arabe",
  "species_arabian_angelfish_desc": "Grand poisson-ange bleu foncé portant une large bande verticale jaune et une queue jaune, endémique de l'ouest de l'océan Indien.",
  "species_king_angelfish_name": "Poisson-ange roi",
  "species_king_angelfish_desc": "Grand poisson-ange bleu foncé portant une bande verticale blanche et une queue jaune, présent dans le Pacifique Est et aux Galapagos.",
  "species_ocean_sunfish_name": "Poisson-lune",
  "species_ocean_sunfish_desc": "Le poisson osseux le plus lourd, dépassant 2 tonnes. Parfois observé par les plongeurs aux stations de nettoyage de Bali et des Galapagos.",
  "species_lingcod_name": "Morue-lingue",
  "species_lingcod_desc": "Grand prédateur marbré des récifs rocheux du Nord-Ouest Pacifique, souvent vu en train de garder ses pontes.",
  "species_wolf_eel_name": "Loup-anguille",
  "species_wolf_eel_desc": "Grand loup-anguille gris à la tête bulbeuse et aux mâchoires puissantes, présent dans les tanières rocheuses du Nord-Ouest Pacifique.",
  "species_giant_sea_bass_name": "Bar géant",
  "species_giant_sea_bass_desc": "Bar massif dépassant 2 m et 250 kg, présent sur les récifs rocheux et dans les forêts de laminaires du sud de la Californie.",
  "species_garibaldi_name": "Garibaldi",
  "species_garibaldi_desc": "Demoiselle orange vif et poisson marin emblème de la Californie, territoriale sur les récifs des forêts de laminaires.",
  "species_sheephead_name": "Labre californien",
  "species_sheephead_desc": "Grand labre à la tête et à la queue noires, au milieu du corps rouge et au menton blanc. Présent dans les forêts de laminaires de Californie.",
  "species_copper_rockfish_name": "Sébaste cuivré",
  "species_copper_rockfish_desc": "Sébaste orange cuivré marqué de plages claires, courant sur les récifs rocheux et dans les forêts de laminaires du Nord-Ouest Pacifique.",
  "species_oriental_sweetlips_name": "Gaterin oriental",
  "species_oriental_sweetlips_desc": "Grand poisson de récif indo-pacifique rayé de noir et de blanc, aux nageoires jaunes. Les juvéniles exécutent une danse ondulante.",
  "species_harlequin_sweetlips_name": "Gaterin arlequin",
  "species_harlequin_sweetlips_desc": "Les adultes sont gris tachetés de sombre; les juvéniles sont bruns à grandes taches blanches et nagent en ondulant.",
  "species_blue_ringed_angelfish_name": "Poisson-ange à anneau bleu",
  "species_blue_ringed_angelfish_desc": "Grand poisson-ange brun parcouru de lignes bleues courbes et portant un anneau bleu caractéristique au-dessus de l'opercule.",
  "species_yellowbar_angelfish_name": "Poisson-ange à bande jaune",
  "species_yellowbar_angelfish_desc": "Grand poisson-ange gris-bleu marqué d'une large plage jaune, présent en mer Rouge et dans l'ouest de l'océan Indien.",
  "species_filefish_scrawled_name": "Poisson-lime griffonné",
  "species_filefish_scrawled_desc": "Grand poisson-lime brun olive aux marques bleues en gribouillis et au fanon orange, présent sur les récifs tropicaux du monde entier.",
  "species_clown_filefish_name": "Poisson-lime à points orange",
  "species_clown_filefish_desc": "Petit poisson-lime vert à points orange et au museau allongé, qui se nourrit exclusivement de polypes de coraux Acropora.",
  "species_unicornfish_name": "Poisson-licorne à épines bleues",
  "species_unicornfish_desc": "Chirurgien gris portant une corne frontale proéminente et deux épines caudales bleues, commun sur les platiers récifaux indo-pacifiques.",
  "species_surgeonfish_sailfin_name": "Chirurgien voilier",
  "species_surgeonfish_sailfin_desc": "Chirurgien aux bandes marquées et aux nageoires dorsale et anale très développées, présent dans tout l'Indo-Pacifique.",
  "species_achilles_tang_name": "Chirurgien d'Achille",
  "species_achilles_tang_desc": "Chirurgien brun foncé portant une nette larme orange près de la queue, présent dans les zones de ressac du Pacifique central.",
  "species_doctorfish_name": "Chirurgien docteur",
  "species_doctorfish_desc": "Chirurgien brun grisâtre aux bandes sombres discrètes et au scalpel caudal marqué, commun sur les récifs des Caraïbes.",
  "species_checkerboard_wrasse_name": "Labre damier",
  "species_checkerboard_wrasse_desc": "Labre coloré au motif en damier de carrés verts, roses et noirs sur tout le corps.",
  "species_bird_wrasse_name": "Labre oiseau",
  "species_bird_wrasse_desc": "Labre au museau extrêmement allongé évoquant un bec d'oiseau; les mâles sont vert foncé, les femelles brunes.",
  "species_sling_jaw_wrasse_name": "Labre à mâchoire projetable",
  "species_sling_jaw_wrasse_desc": "Labre doté d'une mâchoire extensible qui se projette vers l'avant pour capturer ses proies, présent en formes jaune ou brune.",
  "species_peacock_flounder_name": "Turbot paon",
  "species_peacock_flounder_desc": "Poisson plat de fond orné d'anneaux et de points bleus, capable de changer de couleur pour se fondre dans le substrat.",
  "species_hogfish_name": "Labre capitaine",
  "species_hogfish_desc": "Grand labre de l'Atlantique Ouest au museau en groin et aux épines dorsales allongées, présent près des récifs et des épaves.",
  "species_tarpon_name": "Tarpon atlantique",
  "species_tarpon_desc": "Énorme poisson argenté aux grandes écailles réfléchissantes, parfois rencontré par les plongeurs dans les grottes et les passes des Caraïbes.",
  "species_permit_name": "Pompaneau permit",
  "species_permit_desc": "Carangidé argenté au corps haut et à la queue fourchue sombre, présent sur les fonds sableux des Caraïbes et près des récifs.",
  "species_spotted_drum_name": "Tambour tacheté",
  "species_spotted_drum_desc": "Poisson des Caraïbes saisissant, à la haute nageoire dorsale allongée et au motif tacheté noir et blanc marqué.",
  "species_jackknife_fish_name": "Tambour lancéolé",
  "species_jackknife_fish_desc": "Élégant poisson des Caraïbes à la haute nageoire dorsale rayée de noir et à la bande corporelle oblique, présent sous les surplombs.",
  "species_bigeye_name": "Beauclaire de roche",
  "species_bigeye_desc": "Poisson nocturne rouge vif aux grands yeux réfléchissants, caché dans les grottes des récifs des Caraïbes et de l'Atlantique.",
  "species_remora_name": "Rémora",
  "species_remora_desc": "Poisson élancé pourvu d'un disque adhésif sur la tête, qui se fait transporter par les requins, les raies, les tortues et d'autres grands animaux.",
  "species_tilefish_sand_name": "Matajuelo blanc",
  "species_tilefish_sand_desc": "Poisson allongé bleu pâle qui édifie des monticules de débris sur les zones sableuses des récifs des Caraïbes.",
  "species_weedy_seadragon_name": "Dragon de mer commun",
  "species_weedy_seadragon_desc": "Cousin orné des hippocampes portant des appendices en forme de feuilles, endémique des eaux tempérées du sud de l'Australie.",
  "species_leafy_seadragon_name": "Dragon de mer feuillu",
  "species_leafy_seadragon_desc": "Spectaculaire dragon de mer couvert d'expansions foliacées élaborées, endémique du sud de l'Australie. Une observation de rêve pour les plongeurs.",
  "species_sailfin_snapper_name": "Vivaneau voilier",
  "species_sailfin_snapper_desc": "Élégant vivaneau jaune et bleu aux nageoires dorsale et anale allongées, présent sur les pentes récifales indo-pacifiques.",
  "species_sweetlip_emperor_name": "Empereur moucheté",
  "species_sweetlip_emperor_desc": "Grand empereur argenté aux lignes bleues sur la face et aux nageoires bordées de jaune, commun sur les zones sableuses des récifs indo-pacifiques.",
  "species_crocodilefish_name": "Poisson-crocodile",
  "species_crocodilefish_desc": "Prédateur embusqué à la tête aplatie et aux franges oculaires élaborées, parfaitement camouflé sur les fonds récifaux indo-pacifiques.",
  "species_devil_scorpionfish_name": "Rascasse diable",
  "species_devil_scorpionfish_desc": "Rascasse trapue et camouflée qui déploie ses pectorales aux couleurs vives en signal d'avertissement.",
  "species_spiny_devilfish_name": "Poisson-diable épineux",
  "species_spiny_devilfish_desc": "Poisson de fond venimeux qui marche sur des rayons de nageoires modifiés et déploie ses pectorales colorées quand on le dérange.",
  "species_waspfish_name": "Poisson-guêpe cacatoès",
  "species_waspfish_desc": "Petite rascasse comprimée qui ondule dans le courant comme une feuille morte sur les fonds vaseux indo-pacifiques.",
  "species_stargazer_name": "Uranoscope à marge blanche",
  "species_stargazer_desc": "Prédateur embusqué qui s'enfouit dans le sable en ne laissant dépasser que les yeux et peut délivrer des décharges électriques. Présent dans l'Indo-Pacifique.",
  "species_striped_catfish_name": "Poisson-chat rayé",
  "species_striped_catfish_desc": "Poisson-chat aux épines venimeuses; les juvéniles forment des bancs denses en boule qui roulent sur les fonds récifaux indo-pacifiques.",
  "species_red_emperor_name": "Empereur rouge",
  "species_red_emperor_desc": "Grand vivaneau; les adultes sont rouge rosé, les juvéniles portent des bandes rouges et blanches marquées. Présent sur les récifs indo-pacifiques.",
  "species_mangrove_snapper_name": "Vivaneau des mangroves",
  "species_mangrove_snapper_desc": "Vivaneau gris présent dans les mangroves, les herbiers et les récifs des Caraïbes, souvent rassemblé près des structures.",
  "species_dottyback_orchid_name": "Pseudochromis orchidée",
  "species_dottyback_orchid_desc": "Petit poisson d'un violet intense endémique de la mer Rouge, qui file d'une anfractuosité à l'autre sur les tombants abrupts.",
  "species_dottyback_royal_name": "Pseudochromis royal",
  "species_dottyback_royal_desc": "Petit poisson bicolore, magenta à l'avant et jaune vif à l'arrière, présent sur les tombants indo-pacifiques.",
  "species_coral_trout_name": "Loche saumonée",
  "species_coral_trout_desc": "Prédateur prisé de la Grande Barrière de corail, au corps rouge orangé couvert de points bleus.",
  "species_barramundi_cod_name": "Mérou barramundi",
  "species_barramundi_cod_desc": "Mérou caractéristique à la petite tête, au corps bossu et aux gros pois sombres sur fond clair.",
  "species_spadefish_atlantic_name": "Disque portugais",
  "species_spadefish_atlantic_desc": "Poisson argenté en forme de disque barré de bandes verticales sombres, souvent observé en grands bancs autour des épaves des Caraïbes.",
  "species_fusilier_yellowback_name": "Fusilier à dos jaune",
  "species_fusilier_yellowback_desc": "Poisson planctonophage bleu et élancé au dos jaune, formant d'immenses bancs au-dessus des pentes récifales indo-pacifiques.",
  "species_fusilier_bluestreak_name": "Fusilier à raie bleue",
  "species_fusilier_bluestreak_desc": "Petit fusilier bleu marqué d'une bande latérale sombre, observé en bancs rapides le long des tombants indo-pacifiques.",
  "species_porkfish_name": "Grondeur porc",
  "species_porkfish_desc": "Grondeur coloré des Caraïbes rayé de bleu et de jaune, avec deux barres noires sur la tête, présent près des récifs et des épaves.",
  "species_blue_striped_grunt_name": "Grondeur à raies bleues",
  "species_blue_striped_grunt_desc": "Grondeur jaune des Caraïbes aux raies horizontales bleu vif, qui forme de grands bancs au repos sous les surplombs pendant la journée.",
  "species_french_grunt_name": "Grondeur français",
  "species_french_grunt_desc": "Petit grondeur rayé de jaune qui forme des bancs denses au repos sur les récifs des Caraïbes pendant la journée.",
  "species_convict_tang_name": "Chirurgien bagnard",
  "species_convict_tang_desc": "Chirurgien clair barré de six bandes noires verticales, souvent vu brouter en grands bancs sur les platiers récifaux indo-pacifiques.",
  "species_great_hammerhead_name": "Requin-marteau halicorne",
  "species_great_hammerhead_desc": "Requin caractéristique à la tête en marteau festonné, formant de grands bancs autour des monts sous-marins et des îles du large.",
  "species_wobbegong_name": "Requin-tapis tacheté",
  "species_wobbegong_desc": "Requin-tapis aplati et bien camouflé, orné de lobes frangés autour de la bouche, présent sur les récifs tempérés australiens.",
  "species_manta_ray_name": "Raie manta de récif",
  "species_manta_ray_desc": "Géant gracieux atteignant 5 m d'envergure, qui fréquente les stations de nettoyage et se nourrit de plancton sur les récifs indo-pacifiques.",
  "species_oceanic_manta_name": "Raie manta océanique",
  "species_oceanic_manta_desc": "La plus grande espèce de raie, dont l'envergure dépasse 7 m, rencontrée sur les monts sous-marins du large et aux stations de nettoyage.",
  "species_undulated_moray_name": "Murène ondulée",
  "species_undulated_moray_desc": "Murène vert jaunâtre aux marques sombres ondulées, couramment vue chasser de nuit sur les récifs indo-pacifiques.",
  "species_whitemouth_moray_name": "Murène à bouche blanche",
  "species_whitemouth_moray_desc": "Murène brun foncé à petits points blancs, reconnaissable à l'intérieur blanc de sa gueule, présente dans tout l'Indo-Pacifique.",
  "species_dragon_moray_name": "Murène dragon",
  "species_dragon_moray_desc": "Murène saisissante portant des cornes au-dessus des narines et des taches léopard rouge orangé, présente dans l'Indo-Pacifique.",
  "species_lyretail_grouper_name": "Mérou à queue en lyre",
  "species_lyretail_grouper_desc": "Mérou rouge rosé à points bleus et à la queue en croissant caractéristique, présent sur les tombants récifaux externes indo-pacifiques.",
  "species_banded_butterflyfish_name": "Poisson-papillon rubané",
  "species_banded_butterflyfish_desc": "Poisson-papillon blanc barré de quatre bandes verticales noires marquées, l'un des papillons les plus communs des récifs des Caraïbes.",
  "species_ringed_pipefish_name": "Syngnathe annelé",
