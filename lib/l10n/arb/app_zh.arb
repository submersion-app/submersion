  "species_deepwater_sea_fan_name": "深水海扇",
  "species_deepwater_sea_fan_desc": "体形庞大、枝条繁茂的柳珊瑚，见于加勒比海的深水礁壁。",
  "species_sea_whip_name": "海鞭",
  "species_sea_whip_desc": "细长杆状的柳珊瑚，在大西洋和加勒比礁区随水流摇曳。",
  "species_sea_plume_name": "海羽",
  "species_sea_plume_desc": "高大的羽状柳珊瑚，在加勒比礁顶形成羽毛般的群体。",
  "species_organ_pipe_coral_name": "管风琴珊瑚",
  "species_organ_pipe_coral_desc": "骨骼为鲜红色的管状结构，水螅体纤柔，见于印度洋至太平洋水流平缓的礁区。",
  "species_leather_coral_name": "皮革软珊瑚",
  "species_leather_coral_desc": "表面光滑似皮革的软珊瑚，可形成大片蘑菇状的群体。",
  "species_toadstool_leather_coral_name": "蘑菇皮革软珊瑚",
  "species_toadstool_leather_coral_desc": "柄部粗厚、顶盖扁平的软珊瑚，常见于印度洋至太平洋的礁坪。",
  "species_pulsing_xenia_name": "脉冲珊瑚",
