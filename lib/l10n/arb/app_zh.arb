  "species_whale_shark_name": "鲸鲨",
  "species_whale_shark_desc": "海洋中最大的鱼类，性情温和的滤食者，体表有独特的斑点花纹。",
  "species_great_white_shark_name": "大白鲨",
  "species_great_white_shark_desc": "标志性的顶级掠食者，偶尔可在温带海域的鲨笼潜水中遇见。",
  "species_great_hammerhead_shark_name": "无沟双髻鲨",
  "species_great_hammerhead_shark_desc": "体型最大的双髻鲨，头部宽而扁平，背鳍高耸。",
  "species_scalloped_hammerhead_shark_name": "路氏双髻鲨",
  "species_scalloped_hammerhead_shark_desc": "常在海山和清洁站附近成大群出现。",
  "species_smooth_hammerhead_shark_name": "锤头双髻鲨",
  "species_smooth_hammerhead_shark_desc": "头部边缘平滑圆润的双髻鲨，分布于温带海域。",
  "species_whitetip_reef_shark_name": "白顶礁鲨",
  "species_whitetip_reef_shark_desc": "性情温和的礁区居民，白天常在洞穴和岩檐下休息。",
  "species_blacktip_reef_shark_name": "黑顶礁鲨",
  "species_blacktip_reef_shark_desc": "常见的浅水礁鲨，各鳍尖端带有醒目的黑色斑纹。",
  "species_grey_reef_shark_name": "灰礁鲨",
  "species_grey_reef_shark_desc": "活跃的礁区掠食者，常成群出现在陡坡和水道沿线。",
  "species_caribbean_reef_shark_name": "加勒比礁鲨",
  "species_caribbean_reef_shark_desc": "加勒比海最常遇见的礁鲨，体格健壮且好奇心强。",
  "species_nurse_shark_name": "护士鲨",
  "species_nurse_shark_desc": "行动缓慢的底栖鲨鱼，常在珊瑚岩檐下休息。",
  "species_tawny_nurse_shark_name": "锈须鲨",
  "species_tawny_nurse_shark_desc": "印度洋至太平洋的底栖鲨鱼，常在礁洞和沙地中休息。",
  "species_bull_shark_name": "公牛鲨",
  "species_bull_shark_desc": "体格粗壮有力的鲨鱼，遍布全球沿岸海域，也会进入淡水环境。",
  "species_tiger_shark_name": "虎鲨",
  "species_tiger_shark_desc": "大型掠食者，体侧有独特的条纹，深水礁潜时偶有相遇。",
  "species_oceanic_whitetip_shark_name": "远洋白鳍鲨",
  "species_oceanic_whitetip_shark_desc": "大洋性鲨鱼，鳍端圆钝并呈白色，常在开阔水域潜水时出现。",
  "species_thresher_shark_name": "长尾鲨",
  "species_thresher_shark_desc": "以极长的尾鳍最易辨认，有时可在清洁站附近见到。",
  "species_pelagic_thresher_shark_name": "浅海长尾鲨",
  "species_pelagic_thresher_shark_desc": "体型最小的长尾鲨，以在菲律宾莫纳德浅滩的目击而闻名。",
  "species_shortfin_mako_shark_name": "尖吻鲭鲨",
  "species_shortfin_mako_shark_desc": "海洋中游速最快的鲨鱼，体形流线，体色泛金属蓝的开阔水域掠食者。",
  "species_blue_shark_name": "大青鲨",
  "species_blue_shark_desc": "体形修长、体色深蓝的大洋鲨鱼，蓝水潜水中常有遇见。",
  "species_spotted_wobbegong_name": "斑纹须鲨",
  "species_spotted_wobbegong_desc": "体形扁平、伪装极佳的须鲨，常一动不动地伏在澳大利亚的岩礁上。",
  "species_tasselled_wobbegong_name": "流苏须鲨",
  "species_tasselled_wobbegong_desc": "花纹华丽的须鲨，头部周围长有流苏状皮瓣，栖息于珊瑚礁。",
  "species_epaulette_shark_name": "肩章鲨",
  "species_epaulette_shark_desc": "体型小巧的鲨鱼，会用胸鳍在礁底行走。",
  "species_horn_shark_name": "加州异齿鲨",
  "species_horn_shark_desc": "夜行性底栖鲨鱼，眼睛上方有隆起的脊突，分布于美国加州外海。",
  "species_leopard_shark_name": "半带皱唇鲨",
  "species_leopard_shark_desc": "花纹美丽的鲨鱼，见于美国太平洋沿岸的浅水海湾。",
  "species_pacific_angel_shark_name": "太平洋扁鲨",
  "species_pacific_angel_shark_desc": "身体扁平的伏击型掠食者，常半埋在海底沙中等待猎物。",
  "species_sand_tiger_shark_name": "沙虎鲨",
  "species_sand_tiger_shark_desc": "外表凶猛但性情温和，常见其在洞穴和沉船中悬停。",
  "species_zebra_shark_name": "豹纹鲨",
  "species_zebra_shark_desc": "体表布满斑点的礁鲨，喜静卧沙底，在印度洋至太平洋十分常见。",
  "species_blacktip_shark_name": "黑边鳍真鲨",
  "species_blacktip_shark_desc": "游速很快的近岸鲨鱼，以旋转跃出水面著称，遍布全球温暖海域。",
  "species_silvertip_shark_name": "白边真鲨",
  "species_silvertip_shark_desc": "胆大的礁鲨，各鳍边缘呈白色，多见于深陡坡和环礁附近。",
  "species_silky_shark_name": "镰状真鲨",
  "species_silky_shark_desc": "体形流线、皮肤光滑的大洋鲨鱼，常出现在离岸礁区附近。",
  "species_lemon_shark_name": "柠檬鲨",
  "species_lemon_shark_desc": "体色黄褐的鲨鱼，常见于浅水红树林和沙质浅滩。",
  "species_galapagos_shark_name": "加拉帕戈斯真鲨",
  "species_galapagos_shark_desc": "大型礁鲨，栖息于大洋岛屿周围，对潜水员充满好奇。",
  "species_port_jackson_shark_name": "澳洲异齿鲨",
  "species_port_jackson_shark_desc": "夜行性底栖鲨鱼，体表有类似挽具的花纹，为澳大利亚特有种。",
  "species_bamboo_shark_name": "条纹斑竹鲨",
  "species_bamboo_shark_desc": "体型小、性情温和的底栖鲨鱼，常见于印度洋至太平洋的珊瑚礁。",
  "species_basking_shark_name": "姥鲨",
  "species_basking_shark_desc": "第二大的鱼类，滤食为生，常见于温带海域的表层水中。",
  "species_greenland_shark_name": "小头睡鲨",
  "species_greenland_shark_desc": "行动迟缓的深海鲨鱼，是地球上寿命最长的脊椎动物之一。",
  "species_cookiecutter_shark_name": "巴西达摩鲨",
  "species_cookiecutter_shark_desc": "小型深海鲨鱼，会在大型海洋动物身上咬出圆形的缺口。",
  "species_sevengill_shark_name": "扁头哈那鲨",
  "species_sevengill_shark_desc": "原始的鲨鱼，具有七对鳃裂，温带海藻林潜水时可能遇见。",
  "species_pyjama_shark_name": "条纹猫鲨",
  "species_pyjama_shark_desc": "南非特有的条纹小型鲨鱼，栖息于岩礁和海藻林中。",
  "species_spiny_dogfish_name": "白斑角鲨",
  "species_spiny_dogfish_desc": "体型小、数量多的鲨鱼，背鳍具毒棘，分布于温带海域。",
  "species_swell_shark_name": "膨腹绒毛鲨",
  "species_swell_shark_desc": "夜行性猫鲨，受到威胁时会吸水膨胀身体，见于加州外海。",
  "species_giant_oceanic_manta_ray_name": "双吻前口蝠鲼",
  "species_giant_oceanic_manta_ray_desc": "体型最大的鳐类，姿态雄伟的滤食者，翼展可达 7 米。",
  "species_reef_manta_ray_name": "珊瑚礁蝠鲼",
  "species_reef_manta_ray_desc": "体型较小的蝠鲼，常出现在热带礁区的清洁站。",
  "species_spotted_eagle_ray_name": "纳氏鹞鲼",
  "species_spotted_eagle_ray_desc": "体态优雅的鳐鱼，背部有白色斑点，尾长如鞭，常在中层水域巡游。",
  "species_common_eagle_ray_name": "普通鹰鳐",
  "species_common_eagle_ray_desc": "菱形的鳐鱼，分布于东大西洋温带海域和地中海。",
  "species_blue_spotted_ribbontail_ray_name": "蓝斑条尾魟",
  "species_blue_spotted_ribbontail_ray_desc": "体色鲜艳、布满亮蓝色斑点的魟鱼，常见于印度洋至太平洋的珊瑚礁。",
  "species_blue_spotted_stingray_name": "蓝点魟",
  "species_blue_spotted_stingray_desc": "小型礁区魟鱼，体表散布蓝色斑点，常半埋在沙地中。",
  "species_southern_stingray_name": "美洲魟",
  "species_southern_stingray_desc": "大型魟鱼，栖息于加勒比海的沙质浅滩，以 Stingray City 而闻名。",
  "species_round_stingray_name": "圆魟",
  "species_round_stingray_desc": "体形浑圆的小型魟鱼，常见于东太平洋的浅水沙地。",
  "species_short_tail_stingray_name": "短尾魟",
  "species_short_tail_stingray_desc": "体型最大的魟鱼之一，分布于南半球的温带海域。",
  "species_cowtail_stingray_name": "牛尾魟",
  "species_cowtail_stingray_desc": "体型大、体色深的魟鱼，尾部有独特的旗状皮褶，栖息于沙质礁区。",
  "species_atlantic_torpedo_ray_name": "大西洋电鳐",
  "species_atlantic_torpedo_ray_desc": "能释放强烈电击的电鳐，栖息于大西洋的沙质海底。",
  "species_marbled_electric_ray_name": "云纹电鳐",
  "species_marbled_electric_ray_desc": "地中海的电鳐，体表有云石般的花纹，可释放相当明显的电击。",
  "species_giant_guitarfish_name": "及达尖犁头鳐",
  "species_giant_guitarfish_desc": "外形似鲨的鳐类，见于印度洋至太平洋珊瑚礁附近的沙质海底。",
  "species_shovelnose_guitarfish_name": "铲吻犁头鳐",
  "species_shovelnose_guitarfish_desc": "体形扁平，兼具鳐与鲨的轮廓，常见于东太平洋的浅水沙地。",
  "species_smalltooth_sawfish_name": "小齿锯鳐",
  "species_smalltooth_sawfish_desc": "极度濒危的鳐类，吻部长有锯齿状突起，分布于热带沿岸水域。",
  "species_green_sawfish_name": "绿锯鳐",
  "species_green_sawfish_desc": "大型锯鳐，体色橄榄绿，栖息于印度洋至西太平洋的河口。",
  "species_devil_ray_name": "巨型蝠鲼",
  "species_devil_ray_desc": "体型较大的蝠鲼，头部有一对头鳍，常成群跃出水面。",
  "species_spinetail_devil_ray_name": "刺尾蝠鲼",
  "species_spinetail_devil_ray_desc": "大洋性蝠鲼，常在近水面聚成大群。",
  "species_lesser_devil_ray_name": "侏儒蝠鲼",
  "species_lesser_devil_ray_desc": "体型最小的蝠鲼，在加利福尼亚湾结成庞大的鱼群。",
  "species_bat_ray_name": "加州鹰鳐",
  "species_bat_ray_desc": "菱形的鳐鱼，常见于加州的海藻林和沙质海湾。",
  "species_undulate_ray_name": "波纹鳐",
  "species_undulate_ray_desc": "花纹优美的鳐鱼，体表有波浪状纹路，分布于东大西洋。",
  "species_thornback_ray_name": "棘鳐",
  "species_thornback_ray_desc": "欧洲常见的鳐鱼，背部和尾部长有棘刺。",
  "species_cownose_ray_name": "牛鼻鳐",
  "species_cownose_ray_desc": "头部有明显的凹槽，季节性洄游时常结成大群。",
  "species_marble_ray_name": "迈氏条尾魟",
  "species_marble_ray_desc": "体型大、体色深并带白色斑点的魟鱼，常在印度洋至太平洋的清洁站出现。",
  "species_ocellate_river_stingray_name": "珍珠魟",
  "species_ocellate_river_stingray_desc": "淡水魟鱼，体表有醒目的橙环斑点，原产于南美洲的河流。",
  "species_ocellaris_clownfish_name": "眼斑双锯鱼",
  "species_ocellaris_clownfish_desc": "橙白相间的小型鱼类，常与珊瑚礁上的海葵共生。",
  "species_clarkii_clownfish_name": "克氏双锯鱼",
  "species_clarkii_clownfish_desc": "体质强健的海葵鱼，体色深并有两道白带，广布印度洋至太平洋，可与多种海葵共生。",
  "species_tomato_clownfish_name": "白条双锯鱼",
  "species_tomato_clownfish_desc": "体色橙红鲜艳的海葵鱼，头部有一道白带，常见于印度洋至太平洋的珊瑚礁。",
  "species_regal_blue_tang_name": "拟刺尾鲷",
  "species_regal_blue_tang_desc": "体色亮蓝的刺尾鱼，身上有黑色调色板状斑纹，尾鳍黄色，见于印度洋至太平洋的珊瑚礁。",
  "species_yellow_tang_name": "黄高鳍刺尾鱼",
  "species_yellow_tang_desc": "通体亮黄的刺尾鱼，常见于夏威夷和太平洋礁区，多成群啃食藻类。",
  "species_powder_blue_surgeonfish_name": "白面刺尾鱼",
  "species_powder_blue_surgeonfish_desc": "体色淡蓝醒目的刺尾鱼，脸部黑色、背鳍黄色，分布于印度洋。",
  "species_sohal_surgeonfish_name": "索哈尔刺尾鱼",
  "species_sohal_surgeonfish_desc": "条纹醒目的刺尾鱼，尾柄有橙色的手术刀状棘刺，为红海和阿拉伯湾礁区特有种。",
  "species_blue_tang_name": "蓝刺尾鱼",
  "species_blue_tang_desc": "体色深蓝的刺尾鱼，常见于加勒比海礁区，幼鱼呈鲜黄色。",
  "species_emperor_angelfish_name": "主刺盖鱼",
  "species_emperor_angelfish_desc": "大型神仙鱼，体侧有醒目的蓝黄相间横纹。幼鱼则呈蓝白相间的同心圆花纹。",
  "species_french_angelfish_name": "法国神仙鱼",
  "species_french_angelfish_desc": "体色深、鳞片镶金边的大型神仙鱼，常成对出现在加勒比海和西大西洋礁区。",
  "species_queen_angelfish_name": "女王神仙鱼",
  "species_queen_angelfish_desc": "蓝黄相间、色彩绚丽的神仙鱼，头顶有独特的王冠状斑点，见于加勒比珊瑚礁。",
  "species_regal_angelfish_name": "双棘甲尻鱼",
  "species_regal_angelfish_desc": "体态优雅的神仙鱼，体侧有橙白与蓝色交替的竖带，见于印度洋至太平洋的礁区。",
  "species_rock_beauty_name": "三色刺蝶鱼",
  "species_rock_beauty_desc": "加勒比海醒目的神仙鱼，前半身黄色、后半身黑色，多见于岩礁和岩檐附近。",
  "species_gray_angelfish_name": "灰神仙鱼",
  "species_gray_angelfish_desc": "大型灰色神仙鱼，面部色浅，胸鳍内侧呈黄色，常见于加勒比礁区。",
  "species_copperband_butterflyfish_name": "长吻钻嘴鱼",
  "species_copperband_butterflyfish_desc": "特征鲜明的蝴蝶鱼，体侧有橙色竖带、吻部细长，见于印度洋至太平洋的礁区。",
  "species_raccoon_butterflyfish_name": "月斑蝴蝶鱼",
  "species_raccoon_butterflyfish_desc": "体色偏黄的蝴蝶鱼，眼部有似浣熊面罩的黑斑，常见于印度洋至太平洋及夏威夷礁区。",
  "species_longnose_butterflyfish_name": "黄镊口鱼",
  "species_longnose_butterflyfish_desc": "通体亮黄的蝴蝶鱼，吻部极长，可从印度洋至太平洋礁石的缝隙中取食。",
  "species_threadfin_butterflyfish_name": "扬幡蝴蝶鱼",
  "species_threadfin_butterflyfish_desc": "体色偏白的蝴蝶鱼，具人字形斑纹和延长的背鳍丝，广布印度洋至太平洋。",
  "species_foureye_butterflyfish_name": "四眼蝴蝶鱼",
  "species_foureye_butterflyfish_desc": "体色浅淡的蝴蝶鱼，近尾部有醒目的假眼斑，常见于加勒比礁区。",
  "species_spotfin_butterflyfish_name": "斑鳍蝴蝶鱼",
  "species_spotfin_butterflyfish_desc": "白黄相间的蝴蝶鱼，背鳍上有一个小黑点，分布于西大西洋。",
  "species_banner_butterflyfish_name": "红海马夫鱼",
  "species_banner_butterflyfish_desc": "黑白相间的马夫鱼，背鳍延长如旗，腹部黄色，为红海特有种。",
  "species_moorish_idol_name": "镰鱼",
  "species_moorish_idol_desc": "标志性的礁区鱼类，黑白黄三色宽带醒目，背鳍延长成长长的丝带。",
  "species_green_moray_eel_name": "绿裸胸鳝",
  "species_green_moray_eel_desc": "大型绿色海鳝，体长可达 2.5 米，常张着口栖息于西大西洋的礁石缝隙中。",
  "species_giant_moray_eel_name": "爪哇裸胸鳝",
  "species_giant_moray_eel_desc": "体型最大的海鳝，体长超过 3 米，体表有豹纹般的斑点。见于印度洋至太平洋的珊瑚礁。",
  "species_spotted_moray_eel_name": "斑点裸胸鳝",
  "species_spotted_moray_eel_desc": "白底带深褐色斑点的海鳝，常从加勒比海的礁洞中探头张望。",
  "species_ribbon_eel_name": "丝带鳗",
  "species_ribbon_eel_desc": "体形细长、鼻孔呈叶片状的鳗鱼；雄鱼呈鲜蓝色，雌鱼呈黄色。见于印度洋至太平洋的沙质潟湖。",
  "species_spotted_garden_eel_name": "斑点花园鳗",
  "species_spotted_garden_eel_desc": "白色细长并带黑色斑点的鳗鱼，成群栖息于沙地，随水流摆动以捕食浮游生物。",
  "species_splendid_garden_eel_name": "华丽花园鳗",
  "species_splendid_garden_eel_desc": "橙白相间的花园鳗，在西太平洋的沙地上形成大片群落。",
  "species_snowflake_moray_name": "雪花斑裸胸鳝",
  "species_snowflake_moray_desc": "小型海鳝，体色白并带雪花状黑斑，常见于印度洋至太平洋的礁区碎石带。",
  "species_mandarin_dragonet_name": "花斑连鳍䲗",
  "species_mandarin_dragonet_desc": "体型极小、色彩绚丽的鱼类，身上有迷幻般的蓝橙花纹，见于西太平洋的碎石区。",
  "species_common_lionfish_name": "翱翔蓑鲉",
  "species_common_lionfish_desc": "有毒的鲉科鱼类，胸鳍如折扇般展开，体表红白相间。在加勒比海属入侵物种。",
  "species_leaf_scorpionfish_name": "叶鲉",
  "species_leaf_scorpionfish_desc": "身体高度侧扁、形如落叶的鲉鱼，会随水流摆动以模仿印度洋至太平洋礁区的碎屑。",
  "species_stonefish_name": "玫瑰毒鲉",
  "species_stonefish_desc": "世界上毒性最强的鱼，在印度洋至太平洋的礁底伪装成岩石，极其危险。",
  "species_painted_frogfish_name": "大斑躄鱼",
  "species_painted_frogfish_desc": "体形粗短的伏击型掠食者，头部有诱饵状钓竿，体色变化极大。见于印度洋至太平洋的礁区。",
  "species_giant_frogfish_name": "巨躄鱼",
  "species_giant_frogfish_desc": "体型最大的躄鱼，可达 40 厘米，在海绵和珊瑚碎石间伪装极佳。",
  "species_hairy_frogfish_name": "毛躄鱼",
  "species_hairy_frogfish_desc": "体表覆满蠕虫状肉质附属物以模仿藻类，是水下摄影师梦寐以求的题材。",
  "species_clown_triggerfish_name": "花斑拟鳞鲀",
  "species_clown_triggerfish_desc": "花纹醒目的鳞鲀，深色身体上有大块白斑，嘴唇黄色，见于印度洋至太平洋的礁区。",
  "species_titan_triggerfish_name": "褐拟鳞鲀",
  "species_titan_triggerfish_desc": "体型大、攻击性强的鳞鲀，护巢时会冲撞潜水员。常见于印度洋至太平洋的珊瑚礁。",
  "species_queen_triggerfish_name": "妪鳞鲀",
  "species_queen_triggerfish_desc": "色彩鲜艳的加勒比鳞鲀，脸部有蓝色纹路，尾鳍上下叶延长如飘带。",
  "species_picasso_triggerfish_name": "毕加索鳞鲀",
  "species_picasso_triggerfish_desc": "体表有蓝、黄、黑抽象条纹的鳞鲀，常见于印度洋至太平洋的礁坪。",
  "species_yellowmargin_triggerfish_name": "黄缘副鳞鲀",
  "species_yellowmargin_triggerfish_desc": "体色黄褐的大型鳞鲀，各鳍边缘呈黄色，在印度洋至太平洋礁区护巢时颇具攻击性。",
  "species_porcupinefish_name": "刺鲀",
  "species_porcupinefish_desc": "体型较大的多刺鱼类，受威胁时会膨胀成球，遍布全球热带礁区。",
  "species_guineafowl_pufferfish_name": "白点叉鼻鲀",
  "species_guineafowl_pufferfish_desc": "体色深并布满细小白点的河鲀，在印度洋至太平洋礁区偶见通体金黄的色型。",
  "species_map_pufferfish_name": "网纹叉鼻鲀",
  "species_map_pufferfish_desc": "体色浅淡的大型河鲀，全身有繁复的深色地图状纹路，见于印度洋至太平洋的礁区。",
  "species_sharpnose_pufferfish_name": "尖鼻河鲀",
  "species_sharpnose_pufferfish_desc": "体型极小的河鲀，脸部有蓝色纹路、尾鳍橙色，加勒比礁区常见。",
  "species_boxfish_name": "黄箱鲀",
  "species_boxfish_desc": "幼鱼是带黑点的亮黄色方块。成鱼体色转为蓝灰。广布印度洋至太平洋。",
  "species_cowfish_name": "角箱鲀",
  "species_cowfish_desc": "体形方正的黄色鱼类，每只眼睛上方各有一根角状突起，见于印度洋至太平洋的礁区。",
  "species_napoleon_wrasse_name": "波纹唇鱼",
  "species_napoleon_wrasse_desc": "体型巨大的隆头鱼，可达 2 米，额头有明显隆起。已濒危并受保护，见于印度洋至太平洋的礁区。",
  "species_cleaner_wrasse_name": "裂唇鱼",
  "species_cleaner_wrasse_desc": "带蓝色纵纹的小型隆头鱼，在印度洋至太平洋的礁区经营清洁站，为大型鱼类清除寄生虫。",
  "species_yellowtail_coris_name": "黄尾盔鱼",
  "species_yellowtail_coris_desc": "色彩鲜艳的隆头鱼，体表布满斑点、尾鳍黄色，幼鱼呈橙红色并带白色斑纹。",
  "species_bluehead_wrasse_name": "蓝头锦鱼",
  "species_bluehead_wrasse_desc": "加勒比海数量众多的隆头鱼；终期雄鱼头部亮蓝、身体绿色，中间有黑白相间的横带。",
  "species_spanish_hogfish_name": "西班牙猪齿鱼",
  "species_spanish_hogfish_desc": "紫黄相间的隆头鱼，常见于加勒比礁区；幼鱼会充当清洁鱼。",
  "species_bumphead_parrotfish_name": "隆头鹦哥鱼",
  "species_bumphead_parrotfish_desc": "体型最大的鹦嘴鱼，可达 1.3 米，额头有巨大隆起。常成群巡游于印度洋至太平洋的礁区。",
  "species_stoplight_parrotfish_name": "绿鹦嘴鱼",
  "species_stoplight_parrotfish_desc": "加勒比海常见的鹦嘴鱼，初期与终期的体色差异极大。",
  "species_queen_parrotfish_name": "女王鹦嘴鱼",
  "species_queen_parrotfish_desc": "体色蓝绿的大型鹦嘴鱼，见于加勒比礁区，常见其啃咬珊瑚以刮食藻类。",
  "species_yellowtail_damselfish_name": "黄尾雀鲷",
  "species_yellowtail_damselfish_desc": "体色深蓝、尾鳍亮黄的雀鲷，常见于加勒比礁顶和礁脊。",
  "species_sergeant_major_name": "豆娘鱼",
  "species_sergeant_major_desc": "银黄色的雀鲷，体侧有五道醒目黑带，在热带大西洋礁区常聚成大群。",
  "species_three_spot_damselfish_name": "三点雀鲷",
  "species_three_spot_damselfish_desc": "深褐色的领域性雀鲷，会激烈守卫自己在加勒比礁区的藻园。",
  "species_chromis_viridis_name": "蓝绿光鳃鱼",
  "species_chromis_viridis_desc": "闪着绿色金属光泽的小型雀鲷，常成大群悬停在印度洋至太平洋礁区的分枝珊瑚上方。",
  "species_blue_chromis_name": "蓝光鳃鱼",
  "species_blue_chromis_desc": "体色亮蓝、以浮游生物为食的雀鲷，常在加勒比礁壁上方的中层水域聚成大群。",
  "species_nassau_grouper_name": "拿骚石斑鱼",
  "species_nassau_grouper_desc": "加勒比海的大型石斑鱼，眼部有明显深色条纹、体侧有横带，因过度捕捞现已濒危。",
  "species_giant_grouper_name": "鞍带石斑鱼",
  "species_giant_grouper_desc": "体型最大的礁栖硬骨鱼，可达 2.7 米、400 公斤。见于印度洋至太平洋的洞穴和沉船中。",
  "species_coral_grouper_name": "青星九棘鲈",
  "species_coral_grouper_desc": "体色橙红鲜艳、布满蓝色斑点的石斑鱼，是印度洋至太平洋珊瑚礁的代表性鱼种。",
  "species_goliath_grouper_name": "伊氏石斑鱼",
  "species_goliath_grouper_desc": "大西洋的巨型石斑鱼，可达 2.5 米，常在佛罗里达和加勒比海的沉船与岩檐附近遇见。",
  "species_potato_grouper_name": "蓝身大斑石斑鱼",
  "species_potato_grouper_desc": "体型大、性情友善的石斑鱼，体表有马铃薯状的深色斑块，以大堡礁的 Cod Hole 潜点而闻名。",
  "species_peacock_grouper_name": "眼斑九棘鲈",
  "species_peacock_grouper_desc": "深褐色的石斑鱼，体表布满亮蓝色斑点，后半身有浅色竖带，常见于印度洋至太平洋的礁区。",
  "species_yellowfin_tuna_name": "黄鳍金枪鱼",
  "species_yellowfin_tuna_desc": "游速极快的大洋掠食者，背鳍和臀鳍呈黄色且明显延长，离岸潜点偶有遇见。",
  "species_dogtooth_tuna_name": "裸狐鲣",
  "species_dogtooth_tuna_desc": "力量强劲、依礁而居的金枪鱼，牙齿粗大显眼，多见于印度洋至太平洋的深水礁壁。",
  "species_great_barracuda_name": "大梭鱼",
  "species_great_barracuda_desc": "体形流线的银色掠食者，可达 1.8 米，牙齿显眼，常一动不动地悬停在热带礁区附近。",
  "species_blackfin_barracuda_name": "黑鳍梭鱼",
  "species_blackfin_barracuda_desc": "印度洋至太平洋的梭鱼，以在 Barracuda Point 等潜点结成龙卷风般的巨大鱼群著称。",
  "species_mahi_mahi_name": "鲯鳅",
  "species_mahi_mahi_desc": "体色蓝绿与金黄交织、额头钝圆的大洋鱼类，离岸潜点偶有遇见。",
  "species_giant_trevally_name": "珍鲹",
  "species_giant_trevally_desc": "力量强劲的银色掠食者，可达 1.7 米，以在印度洋至太平洋的礁区水道和陡坡捕猎而著称。",
  "species_bluefin_trevally_name": "蓝鳍鲹",
  "species_bluefin_trevally_desc": "体形流线、带蓝色斑点的鲹鱼，常成小群沿印度洋至太平洋的礁缘巡猎。",
  "species_bigeye_trevally_name": "六带鲹",
  "species_bigeye_trevally_desc": "眼睛大的银色鲹鱼，常在礁壁和清洁站附近结成壮观的漩涡状鱼群。",
  "species_bar_jack_name": "条纹鲹",
  "species_bar_jack_desc": "体形流线的加勒比银色鲹鱼，背部至尾鳍下叶有一道醒目的深蓝色条纹。",
  "species_horse_eye_jack_name": "大眼鲹",
  "species_horse_eye_jack_desc": "眼睛大的银色鲹鱼，在加勒比海和西大西洋的礁区与沉船附近结成鱼群。",
  "species_yellowtail_snapper_name": "黄尾笛鲷",
  "species_yellowtail_snapper_desc": "体形流线的笛鲷，体侧有黄色纵带、尾鳍黄色，常在加勒比礁区的中层水域成群游动。",
  "species_schoolmaster_snapper_name": "黄笛鲷",
  "species_schoolmaster_snapper_desc": "黄银相间的笛鲷，眼下有蓝色纹路，常成群栖息在加勒比礁区的岩檐下。",
  "species_bluestripe_snapper_name": "四带笛鲷",
  "species_bluestripe_snapper_desc": "体色亮黄的笛鲷，体侧有四道蓝色纵纹，在印度洋至太平洋的礁区结成密集鱼群。",
  "species_twinspot_snapper_name": "红鳍笛鲷",
  "species_twinspot_snapper_desc": "大型红色笛鲷，见于印度洋至太平洋的外礁，有时会在深水礁壁和水道结群。",
  "species_humphead_snapper_name": "斑点羽鳃笛鲷",
  "species_humphead_snapper_desc": "体色深的大型笛鲷，常成群出现在印度洋至太平洋的陡峭落差附近，幼鱼为醒目的黑白花纹。",
  "species_longfin_bannerfish_name": "马夫鱼",
  "species_longfin_bannerfish_desc": "黑白相间的鱼类，背鳍延长如飘带、尾鳍黄色，常成对出现在印度洋至太平洋的礁区。",
  "species_batfish_orbicular_name": "圆燕鱼",
  "species_batfish_orbicular_desc": "体形如银色圆盘、鳍高耸的鱼类，会好奇地靠近潜水员。常见于印度洋至太平洋的沉船和礁区。",
  "species_batfish_teira_name": "弯鳍燕鱼",
  "species_batfish_teira_desc": "鳍高耸的燕鱼，胸鳍附近有一块深色斑，常在清洁站和沉船附近出现。",
  "species_batfish_pinnatus_name": "尖翅燕鱼",
  "species_batfish_pinnatus_desc": "幼鱼通体漆黑并镶着鲜橙色边缘，形似有毒的扁虫。见于西太平洋。",
  "species_banggai_cardinalfish_name": "邦盖天竺鲷",
  "species_banggai_cardinalfish_desc": "银黑相间、鳍条延长的醒目天竺鲷，为印度尼西亚邦盖群岛特有种。",
  "species_pajama_cardinalfish_name": "考氏鳍天竺鲷",
  "species_pajama_cardinalfish_desc": "外形奇特的天竺鲷，脸部黄色、腰部有深色宽带、后半身布满斑点，栖息于印度洋至太平洋的珊瑚间。",
  "species_longnose_hawkfish_name": "长吻鹰鲷",
  "species_longnose_hawkfish_desc": "体色白并有红色网格花纹的小型鱼类，吻部细长，常停栖在柳珊瑚和黑珊瑚上。",
  "species_arc_eye_hawkfish_name": "弧眼鹰鲷",
  "species_arc_eye_hawkfish_desc": "小型鹰鲷，眼后有醒目的橙色弧纹，常停栖在印度洋至太平洋礁区的珊瑚头上。",
  "species_flame_hawkfish_name": "火焰鹰鲷",
  "species_flame_hawkfish_desc": "体色鲜红的鹰鲷，眼周有深色斑纹，常停栖在西太平洋的 Pocillopora 珊瑚丛中。",
  "species_fire_goby_name": "华丽线塘鳢",
  "species_fire_goby_desc": "体态优雅的白色虾虎鱼，第一背鳍高耸、尾部红橙色，常悬停在印度洋至太平洋的礁区碎石上方。",
  "species_purple_firefish_name": "紫焰线塘鳢",
  "species_purple_firefish_desc": "体形纤细的虾虎鱼，鳍呈紫色、背鳍高耸如尖刺，常在印度洋至太平洋外礁的洞口附近悬停。",
  "species_yellownose_goby_name": "黄鼻虾虎鱼",
  "species_yellownose_goby_desc": "加勒比海的小型清洁虾虎鱼，吻部黄色、体侧有蓝色纵纹，常见于海绵和珊瑚头上。",
  "species_citron_goby_name": "柠檬虾虎鱼",
  "species_citron_goby_desc": "体型极小、通体亮黄的虾虎鱼，栖息于印度洋至太平洋礁区的 Acropora 珊瑚枝间。",
  "species_shrimp_goby_name": "斯氏钝塘鳢",
  "species_shrimp_goby_desc": "体色如沙的虾虎鱼，在印度洋至太平洋的沙地上与鼓虾共居一穴，互利共生。",
  "species_neon_goby_name": "霓虹虾虎鱼",
  "species_neon_goby_desc": "体色深的极小型虾虎鱼，体侧有一道亮蓝色霓虹纵纹，在加勒比海的珊瑚头上经营清洁站。",
  "species_bluestriped_fangblenny_name": "蓝纹牙鳚",
  "species_bluestriped_fangblenny_desc": "带蓝色纵纹的小型鳚鱼，会模仿清洁鱼，趁其他鱼不备咬下它们的鳞片。",
  "species_sailfin_blenny_name": "帆鳍鳚",
  "species_sailfin_blenny_desc": "加勒比海的极小型鳚鱼，会从管状巢穴中竖起如帆的大背鳍来吸引配偶。",
  "species_bicolor_blenny_name": "双色异齿鳚",
  "species_bicolor_blenny_desc": "小型鳚鱼，前半身深褐、后半身橙色，常从印度洋至太平洋礁区的孔洞中探头张望。",
  "species_redlip_blenny_name": "红唇鳚",
  "species_redlip_blenny_desc": "体色深的鳚鱼，红橙色的嘴唇十分醒目，会守卫加勒比礁脊上的藻类领地。",
  "species_pygmy_seahorse_name": "巴氏豆丁海马",
  "species_pygmy_seahorse_desc": "体长不足 2 厘米的迷你海马，与寄主柳珊瑚完美融为一体，是微距摄影梦寐以求的题材。",
  "species_common_seahorse_name": "库达海马",
  "species_common_seahorse_desc": "中等体型的海马，见于印度洋至太平洋的海草床和珊瑚碎石区，体色变化多端。",
  "species_thorny_seahorse_name": "刺海马",
  "species_thorny_seahorse_desc": "全身覆满长棘的海马，栖息于印度洋至太平洋的海草床和软底质环境。",
  "species_ornate_ghost_pipefish_name": "华丽剃刀鱼",
  "species_ornate_ghost_pipefish_desc": "伪装极为精巧的剃刀鱼，常头朝下悬停在印度洋至太平洋的海百合和软珊瑚旁。",
  "species_robust_ghost_pipefish_name": "蓝鳍剃刀鱼",
  "species_robust_ghost_pipefish_desc": "体型较大的剃刀鱼，会模仿海草或藻类，常成对出现在印度洋至太平洋的近岸水域。",
  "species_trumpetfish_name": "管口鱼",
  "species_trumpetfish_desc": "体形细长的鱼类，会紧贴大型鱼类的身影伺机捕猎，见于加勒比海和大西洋礁区，体色多样。",
  "species_cornetfish_name": "烟管鱼",
  "species_cornetfish_desc": "体形极度细长的鱼类，可达 1.5 米，尾部拖着一根丝状鳍条，常见其在礁坪上方滑行。",
  "species_yellowhead_jawfish_name": "黄头后颌䲗",
  "species_yellowhead_jawfish_desc": "身体蓝色、头部黄色的小型鱼类，常悬停在加勒比礁区的沙穴上方。雄鱼用口孵卵。",
  "species_flamefish_name": "火焰天竺鲷",
  "species_flamefish_desc": "体色鲜红的小型天竺鲷，第二背鳍下方有一个深色斑点，白天躲藏在加勒比礁区的缝隙中。",
  "species_longspine_squirrelfish_name": "长棘鳂",
  "species_longspine_squirrelfish_desc": "体色红、眼睛大的夜行性鱼类，背鳍棘明显延长，白天躲在加勒比礁区的岩檐下。",
  "species_soldierfish_name": "大鳞锯鳞鱼",
  "species_soldierfish_desc": "体色红的夜行性鱼类，眼睛巨大而深色、鳞片粗大，白天在洞穴和岩檐下成群栖息。",
  "species_flame_angelfish_name": "火焰神仙鱼",
  "species_flame_angelfish_desc": "体色红橙鲜艳的小型神仙鱼，体侧有黑色竖带、鳍缘泛蓝，广布太平洋。",
  "species_royal_gramma_name": "紫黄七夕鱼",
  "species_royal_gramma_desc": "加勒比海的小型双色鱼，前半身紫色、后半身黄色，常见于岩檐下。",
  "species_anthias_lyretail_name": "丝鳍拟花鮨",
  "species_anthias_lyretail_desc": "数量极多的礁区鱼类，在印度洋至太平洋的珊瑚上方汇成橙粉相间的云雾。雄鱼呈紫色。",
  "species_mediterranean_grouper_name": "褐石斑鱼",
  "species_mediterranean_grouper_desc": "体色深褐、带浅色斑驳的大型石斑鱼，是地中海岩礁的标志性掠食者。",
  "species_mediterranean_moray_name": "欧洲海鳝",
  "species_mediterranean_moray_desc": "深褐色并带黄色斑驳的海鳝，常见其从地中海的岩缝中探头张望。",
  "species_ornate_wrasse_name": "孔雀锦鱼",
  "species_ornate_wrasse_desc": "体色翠绿、头部有红色纹路的隆头鱼，是地中海礁区最常见的隆头鱼之一。",
  "species_red_sea_bannerfish_name": "假面蝴蝶鱼",
  "species_red_sea_bannerfish_desc": "体色亮黄的蝴蝶鱼，眼部有深色斑块，为红海特有种。常成对出现。",
  "species_red_sea_anemonefish_name": "双带双锯鱼",
  "species_red_sea_anemonefish_desc": "体色橙黄、有两道白带的海葵鱼，为红海和亚丁湾特有种。",
  "species_arabian_angelfish_name": "阿拉伯神仙鱼",
  "species_arabian_angelfish_desc": "体色深蓝的大型神仙鱼，体侧有醒目的黄色竖带且尾鳍黄色，为西印度洋特有种。",
  "species_king_angelfish_name": "国王神仙鱼",
  "species_king_angelfish_desc": "体色深蓝的大型神仙鱼，体侧有一道白色竖带、尾鳍黄色，见于东太平洋和加拉帕戈斯。",
  "species_ocean_sunfish_name": "翻车鱼",
  "species_ocean_sunfish_desc": "体重最大的硬骨鱼，可超过 2 吨。潜水员偶尔可在巴厘岛和加拉帕戈斯的清洁站遇见。",
  "species_lingcod_name": "长条蛇齿单线鱼",
  "species_lingcod_desc": "体表斑驳的大型掠食性单线鱼，见于北美太平洋西北岸的岩礁，常见其守护卵块。",
  "species_wolf_eel_name": "狼鳗",
  "species_wolf_eel_desc": "体色灰、头部隆起、颚部强壮的大型鱼类，栖息于北美太平洋西北岸的岩洞中。",
  "species_giant_sea_bass_name": "巨鲈",
  "species_giant_sea_bass_desc": "体型巨大的鲈类，可超过 2 米、250 公斤，见于南加州的岩礁和海藻林。",
  "species_garibaldi_name": "加里波第雀鲷",
  "species_garibaldi_desc": "体色亮橙的雀鲷，也是加利福尼亚州的州海洋鱼类，在海藻林礁区领域性极强。",
  "species_sheephead_name": "加州羊头隆头鱼",
  "species_sheephead_desc": "大型隆头鱼，头尾黑色、身体中段红色、下巴白色。见于加州的海藻林。",
  "species_copper_rockfish_name": "铜平鲉",
  "species_copper_rockfish_desc": "体色铜橙并带浅色斑块的平鲉，是北美太平洋西北岸岩礁和海藻林的常客。",
  "species_oriental_sweetlips_name": "东方胡椒鲷",
  "species_oriental_sweetlips_desc": "印度洋至太平洋的大型礁鱼，体侧有醒目的黑白条纹、鳍呈黄色。幼鱼会以扭动的姿态游动。",
  "species_harlequin_sweetlips_name": "斑胡椒鲷",
  "species_harlequin_sweetlips_desc": "成鱼体色灰并带深色斑点；幼鱼呈褐色并有大块白斑，游动时身体波浪般起伏。",
  "species_blue_ringed_angelfish_name": "环纹刺盖鱼",
  "species_blue_ringed_angelfish_desc": "体色褐的大型神仙鱼，体侧有蓝色弧线，鳃盖上方有一个醒目的蓝色环纹。",
  "species_yellowbar_angelfish_name": "黄斑刺盖鱼",
  "species_yellowbar_angelfish_desc": "体色灰蓝的大型神仙鱼，体侧有一块醒目的黄色斑块，见于红海和西印度洋。",
  "species_filefish_scrawled_name": "拟态革鲀",
  "species_filefish_scrawled_desc": "体色橄榄褐的大型单棘鲀，体表有蓝色涂鸦般的纹路、喉部有橙色垂皮，遍布全球热带礁区。",
  "species_clown_filefish_name": "长吻单棘鲀",
  "species_clown_filefish_desc": "体色绿的小型单棘鲀，体表有橙色斑点、吻部细长，专食 Acropora 珊瑚的水螅体。",
  "species_unicornfish_name": "突角鼻鱼",
  "species_unicornfish_desc": "体色灰的刺尾鱼，额头有明显的角状突起，尾柄有两枚蓝色棘板，常见于印度洋至太平洋的礁坪。",
  "species_surgeonfish_sailfin_name": "高鳍刺尾鱼",
  "species_surgeonfish_sailfin_desc": "条带醒目的刺尾鱼，背鳍和臀鳍可极度张开，广布印度洋至太平洋。",
  "species_achilles_tang_name": "红印刺尾鱼",
  "species_achilles_tang_desc": "体色深褐的刺尾鱼，近尾部有一块醒目的橙色泪滴形斑，见于中太平洋的浪涌带。",
  "species_doctorfish_name": "医生刺尾鱼",
  "species_doctorfish_desc": "体色灰褐的刺尾鱼，体侧有淡淡的深色横带，尾柄的手术刀状棘刺十分显眼，加勒比礁区常见。",
  "species_checkerboard_wrasse_name": "花斑拟唇鱼",
  "species_checkerboard_wrasse_desc": "色彩鲜艳的隆头鱼，全身布满绿、粉、黑相间的棋盘格花纹。",
  "species_bird_wrasse_name": "杂色尖嘴鱼",
  "species_bird_wrasse_desc": "吻部极度延长如鸟喙的隆头鱼，雄鱼呈深绿色，雌鱼呈褐色。",
  "species_sling_jaw_wrasse_name": "伸口鱼",
  "species_sling_jaw_wrasse_desc": "颚部可向前弹射以捕捉猎物的隆头鱼，有黄色和褐色两种色型。",
  "species_peacock_flounder_name": "孔雀比目鱼",
  "species_peacock_flounder_desc": "扁平的底栖鱼类，体表有蓝色环纹和斑点，可变换体色以融入海底。",
  "species_hogfish_name": "猪齿鱼",
  "species_hogfish_desc": "西大西洋的大型隆头鱼，吻部似猪鼻、背鳍棘延长，见于礁区和沉船附近。",
  "species_tarpon_name": "大西洋大海鲢",
  "species_tarpon_desc": "体型巨大的银色鱼类，鳞片大而似镜面，潜水员偶尔可在加勒比海的洞穴和水道中遇见。",
  "species_permit_name": "长鳍鲳鲹",
  "species_permit_desc": "体高侧扁的银色鲹鱼，尾鳍深叉且颜色较深，见于加勒比海的沙质浅滩和礁区附近。",
  "species_spotted_drum_name": "斑点石首鱼",
  "species_spotted_drum_desc": "加勒比海醒目的鱼类，背鳍高耸延长，全身为黑白相间的斑点花纹。",
  "species_jackknife_fish_name": "折刀鱼",
  "species_jackknife_fish_desc": "体态优雅的加勒比鱼类，背鳍高耸并带黑色条纹，体侧有一道斜带，常见于岩檐下。",
  "species_bigeye_name": "玻璃大眼鲷",
  "species_bigeye_desc": "体色鲜红的夜行性鱼类，眼大且反光，白天躲在加勒比海和大西洋礁区的洞穴中。",
  "species_remora_name": "䲟鱼",
  "species_remora_desc": "体形细长的鱼类，头顶有吸盘，可附着在鲨鱼、鳐鱼、海龟等大型动物身上搭便车。",
  "species_tilefish_sand_name": "沙方头鱼",
  "species_tilefish_sand_desc": "体形细长、体色淡蓝的鱼类，会在加勒比礁区的沙地上堆筑碎石丘。",
  "species_weedy_seadragon_name": "草海龙",
  "species_weedy_seadragon_desc": "海马的华丽近亲，体表有叶片状附肢，为澳大利亚南部温带海域特有种。",
  "species_leafy_seadragon_name": "叶海龙",
  "species_leafy_seadragon_desc": "外形惊艳的海龙，全身覆满精致的叶状突起，为澳大利亚南部特有种。是潜水员心愿清单上的目击目标。",
  "species_sailfin_snapper_name": "帆鳍笛鲷",
  "species_sailfin_snapper_desc": "黄蓝相间、体态优雅的笛鲷，背鳍和臀鳍明显延长，见于印度洋至太平洋的礁坡。",
  "species_sweetlip_emperor_name": "星斑裸颊鲷",
  "species_sweetlip_emperor_desc": "体色银亮的大型裸颊鲷，脸部有蓝色纹路、鳍缘泛黄，常见于印度洋至太平洋的沙质礁区。",
  "species_crocodilefish_name": "鳄形牛尾鱼",
  "species_crocodilefish_desc": "头部扁平的伏击型掠食者，眼部有精致的流苏，在印度洋至太平洋的礁底伪装得天衣无缝。",
  "species_devil_scorpionfish_name": "魔鬼鲉",
  "species_devil_scorpionfish_desc": "体形粗壮、伪装极佳的鲉鱼，会张开色彩鲜艳的胸鳍内侧向掠食者示警。",
  "species_spiny_devilfish_name": "双指鬼鲉",
  "species_spiny_devilfish_desc": "有毒的底栖鱼类，用特化的鳍条在海底行走，受扰时会展开鲜艳的胸鳍。",
  "species_waspfish_name": "背带帆鳍鲉",
  "species_waspfish_desc": "体形侧扁的小型鲉鱼，在印度洋至太平洋的泥质海底随水流摆动，宛如一片枯叶。",
  "species_stargazer_name": "白缘瞻星鱼",
  "species_stargazer_desc": "伏击型掠食者，会埋入沙中只露出双眼，并能释放电击。见于印度洋至太平洋。",
  "species_striped_catfish_name": "线纹鳗鲇",
  "species_striped_catfish_desc": "鳍棘有毒的鲇鱼；幼鱼会结成密集的球状鱼群，在印度洋至太平洋的礁底翻滚移动。",
  "species_red_emperor_name": "川纹笛鲷",
  "species_red_emperor_desc": "大型笛鲷；成鱼体色粉红偏红，幼鱼有醒目的红白宽带。见于印度洋至太平洋的礁区。",
  "species_mangrove_snapper_name": "灰笛鲷",
  "species_mangrove_snapper_desc": "体色灰的笛鲷，见于加勒比海的红树林、海草床和礁区，常聚集在礁石结构附近。",
  "species_dottyback_orchid_name": "兰花拟雀鲷",
  "species_dottyback_orchid_desc": "体色亮紫的小型鱼类，为红海特有种，常在陡峭礁壁的缝隙间快速穿进穿出。",
  "species_dottyback_royal_name": "皇家拟雀鲷",
  "species_dottyback_royal_desc": "小型双色鱼类，前半身洋红、后半身亮黄，见于印度洋至太平洋的礁壁。",
  "species_coral_trout_name": "豹纹鳃棘鲈",
  "species_coral_trout_desc": "大堡礁备受推崇的掠食者，体色橙红并布满蓝色斑点。",
  "species_barramundi_cod_name": "驼背鲈",
  "species_barramundi_cod_desc": "特征鲜明的石斑鱼，头部小、背部隆起，浅色底上分布着深色圆斑。",
  "species_spadefish_atlantic_name": "大西洋铲鱼",
  "species_spadefish_atlantic_desc": "体形如银色圆盘并带深色竖带的鱼类，常在加勒比海的沉船周围成大群出现。",
  "species_fusilier_yellowback_name": "黄背梅鲷",
  "species_fusilier_yellowback_desc": "体形流线、以浮游生物为食的蓝色鱼类，背部黄色，在印度洋至太平洋的礁坡上方结成庞大鱼群。",
  "species_fusilier_bluestreak_name": "蓝纹梅鲷",
  "species_fusilier_bluestreak_desc": "带深色纵纹的小型蓝色梅鲷，常沿印度洋至太平洋的礁壁快速成群游动。",
  "species_porkfish_name": "黄纹石鲈",
  "species_porkfish_desc": "色彩鲜艳的加勒比石鲈，体侧有蓝黄相间的纵纹，头部有两道黑带，见于礁区和沉船附近。",
  "species_blue_striped_grunt_name": "蓝纹石鲈",
  "species_blue_striped_grunt_desc": "体色黄的加勒比石鲈，体侧有鲜蓝色纵纹，白天在岩檐下结成大群休息。",
  "species_french_grunt_name": "法国石鲈",
  "species_french_grunt_desc": "带黄色纵纹的小型石鲈，白天在加勒比礁区结成密集的休息鱼群。",
  "species_convict_tang_name": "横带刺尾鱼",
  "species_convict_tang_desc": "体色浅淡的刺尾鱼，体侧有六道黑色竖带，常成大群在印度洋至太平洋的礁坪上啃食藻类。",
  "species_great_hammerhead_name": "路氏双髻鲨",
  "species_great_hammerhead_desc": "头部呈扇贝状锤形的独特鲨鱼，会在海山和离岸岛屿附近结成大群。",
  "species_wobbegong_name": "斑纹须鲨",
  "species_wobbegong_desc": "体形扁平、伪装出色的须鲨，口部周围有流苏状皮瓣，见于澳大利亚的温带礁区。",
  "species_manta_ray_name": "珊瑚礁蝠鲼",
  "species_manta_ray_desc": "姿态优雅的巨型鳐类，翼展可达 5 米，会造访清洁站并在印度洋至太平洋的礁区滤食浮游生物。",
  "species_oceanic_manta_name": "大洋蝠鲼",
  "species_oceanic_manta_desc": "体型最大的鳐类，翼展超过 7 米，常在离岸海山和清洁站遇见。",
  "species_undulated_moray_name": "波纹裸胸鳝",
  "species_undulated_moray_desc": "体色黄绿并带深色波状斑纹的海鳝，常见其夜间在印度洋至太平洋的礁区捕猎。",
  "species_whitemouth_moray_name": "白口裸胸鳝",
  "species_whitemouth_moray_desc": "深褐色的海鳝，体表有细小白点，口腔内部呈醒目的白色，广布印度洋至太平洋。",
  "species_dragon_moray_name": "龙海鳝",
  "species_dragon_moray_desc": "外形夺目的海鳝，鼻孔上方有龙角般的突起，体表布满橙红色豹纹，见于印度洋至太平洋。",
  "species_lyretail_grouper_name": "侧牙鲈",
