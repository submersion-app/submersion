  "species_olive_ridley_sea_turtle_name": "Tartaruga-oliva",
  "species_olive_ridley_sea_turtle_desc": "A mais pequena das tartarugas marinhas, conhecida pelas desovas em massa sincronizadas a que se chama arribadas.",
  "species_kemps_ridley_sea_turtle_name": "Tartaruga-de-Kemp",
