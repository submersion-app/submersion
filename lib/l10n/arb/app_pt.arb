  "species_false_killer_whale_name": "Falsa-orca",
  "species_false_killer_whale_desc": "Grande golfinho oceânico que se aproxima ocasionalmente dos mergulhadores em mar aberto.",
  "species_dugong_name": "Dugongo",
  "species_dugong_desc": "Herbívoro pacífico que pasta nas pradarias marinhas do Indo-Pacífico, parente próximo dos peixes-boi.",
  "species_west_indian_manatee_name": "Peixe-boi-das-Caraíbas",
