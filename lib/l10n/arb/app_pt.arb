  "species_steller_sea_lion_name": "Leão-marinho-de-Steller",
  "species_steller_sea_lion_desc": "A maior espécie de leão-marinho, presente nas águas frias do Pacífico Norte junto a costas rochosas.",
  "species_harbor_seal_name": "Foca-comum",
  "species_harbor_seal_desc": "Foca curiosa, vista com frequência em águas costeiras temperadas, muitas vezes a repousar em rochas junto aos locais de mergulho.",
  "species_grey_seal_name": "Foca-cinzenta",
  "species_grey_seal_desc": "Foca grande e brincalhona do Atlântico Norte, conhecida por se aproximar dos mergulhadores debaixo de água.",
  "species_northern_elephant_seal_name": "Elefante-marinho-do-norte",
  "species_northern_elephant_seal_desc": "Foca enorme e de mergulho profundo; os machos têm uma grande probóscide. Presente ao longo da costa oriental do Pacífico.",
  "species_hawaiian_monk_seal_name": "Foca-monge-do-Havai",
  "species_hawaiian_monk_seal_desc": "Foca criticamente ameaçada e endémica do Havai, avistada ocasionalmente pelos mergulhadores nos recifes.",
  "species_leopard_seal_name": "Foca-leopardo",
  "species_leopard_seal_desc": "Predador poderoso da Antártida, de pelagem malhada, encontrado por mergulhadores de águas frias.",
  "species_narwhal_name": "Narval",
  "species_narwhal_desc": "Baleia do Ártico com uma longa presa em espiral, raramente vista mas icónica entre os mamíferos marinhos.",
  "species_green_sea_turtle_name": "Tartaruga-verde",
  "species_green_sea_turtle_desc": "Grande tartaruga marinha, vista com frequência a pastar nas pradarias marinhas de águas tropicais.",
  "species_hawksbill_sea_turtle_name": "Tartaruga-de-pente",
