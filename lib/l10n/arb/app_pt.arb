  "species_sperm_whale_name": "Cachalote",
  "species_sperm_whale_desc": "Baleia de mergulho profundo, de cabeça enorme, por vezes vista a repousar à superfície entre mergulhos.",
  "species_orca_name": "Orca",
  "species_orca_desc": "Predador de topo com marcas pretas e brancas inconfundíveis, presente em todas as bacias oceânicas.",
  "species_minke_whale_name": "Baleia-anã",
  "species_minke_whale_desc": "Baleia de barbas mais pequena e curiosa perante os mergulhadores, sobretudo na Grande Barreira de Coral.",
  "species_beluga_whale_name": "Beluga",
  "species_beluga_whale_desc": "Baleia branca do Ártico, conhecida pelas vocalizações e pelo comportamento sociável em águas frias.",
  "species_pilot_whale_name": "Baleia-piloto-de-barbatanas-curtas",
