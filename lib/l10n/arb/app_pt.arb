  "species_sea_otter_name": "Lontra-marinha",
  "species_sea_otter_desc": "Mamífero marinho carismático, presente nas florestas de kelp ao longo da costa do Pacífico Norte.",
  "species_california_sea_lion_name": "Leão-marinho-da-Califórnia",
