  "species_grey_whale_name": "Baleia-cinzenta",
  "species_grey_whale_desc": "Baleia de barbas que se alimenta no fundo e migra ao longo da costa do Pacífico, muitas vezes coberta de cracas.",
  "species_blue_whale_name": "Baleia-azul",
