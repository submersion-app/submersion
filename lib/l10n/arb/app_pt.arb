  "species_halimeda_desc": "Alga verde calcificada, de segmentos em forma de disco, grande responsável pela areia dos recifes.",
  "species_sea_lettuce_name": "Alface-do-mar",
  "species_sea_lettuce_desc": "Alga verde-viva em lâminas finas, encontrada em águas costeiras pouco profundas de todo o mundo.",
  "species_caulerpa_name": "Alga-uva-verde",
  "species_caulerpa_desc": "Alga verde rastejante, de frondes semelhantes a cachos de uvas, encontrada em cascalho e areia de recifes tropicais.",
  "species_mermaid_fan_name": "Leque-de-sereia",
  "species_mermaid_fan_desc": "Alga verde calcificada com a forma de um pequeno leque, comum nos fundos arenosos das Caraíbas.",
