# Fastfile for Submersion Google Play Store Automation
#
# Usage:
#   bundle exec fastlane upload           # Upload AAB to internal testing as a draft
#   bundle exec fastlane validate         # Validate AAB without uploading
#   bundle exec fastlane upload_internal  # beta.yml: every beta to internal testing
#   bundle exec fastlane promote_beta     # beta.yml: copy it to open testing
#   bundle exec fastlane mirror_beta      # beta.yml: copy that to closed testing
#   bundle exec fastlane promote_to_production version_code:N  # promote.yml
#
# Authentication:
#   Set GOOGLE_PLAY_JSON_KEY_PATH to the service account JSON key file path,
#   or place the key at fastlane/play-store-key.json.

default_platform(:android)

# Google Play rejects a release-notes body over 500 characters per locale.
PLAY_CHANGELOG_LIMIT = 500

# Where supply looks for release notes. fastlane runs lane bodies and helper
# methods in this `fastlane` directory but wraps every action in Dir.chdir(".."),
# and supply resolves its default metadata_path from there by globbing
# "./fastlane/metadata/android". Writing to that same path from a helper landed
# the notes one directory deeper than supply looked, so supply resolved
# metadata_path to nil, skipped its whole metadata phase, and reported a
# successful upload with no release notes attached - which is what Play beta
# testers saw while TestFlight testers got the full changelog.
#
# Anchored to this file rather than to the working directory. Keep it at the top
# level: fastlane evaluates the Fastfile with __FILE__ set to a bare "Fastfile",
# so __dir__ only resolves while fastlane's own chdir into this folder is still
# in effect.
PLAY_METADATA_ROOT = File.expand_path(File.join(__dir__, "metadata", "android"))

# The track every beta is uploaded to. Internal testing is published without a
# review wait (up to 100 testers, added by email in the Play Console), so it
# can take a build per merge; open testing gets a copy on a cooldown (#2887).
# release.yml's legacy `upload` lane also puts a draft here; the next beta
# replaces it, since supply sets a track's releases to the one it uploads.
INTERNAL_TRACK = "internal"

# Play rejections that no retry or rebuild can clear, each paired with what to
# do about it. The API messages name the symptom only: five beta runs in a row
# failed on the unregistered-package one (#2597) while the Console listed the
# package as Registered, because the missing key was one Google holds and the
# error never says which key it checked. Keep each hint on one line, so it
# survives as a single GitHub annotation.
PLAY_ERROR_HINTS = [
  [
    /registered to your verified developer identity/i,
    "Play checks three signing keys against Android developer verification, and " \
    "the error never says which one is unregistered: the app signing key (App " \
    "integrity), the upload key (android/upload-keystore.jks), and the internal " \
    "app sharing key (Test and release > Internal app sharing). Start a manual " \
    "release on Open testing in the Play Console; its dialog prints the missing " \
    "fingerprint. Register that key under Package names (Google-held keys verify " \
    "without an APK), then discard the draft release. Retrying or rebuilding " \
    "cannot clear this.",
  ],
  [
    /Version code \d+ has already been used/i,
    "Play already holds a bundle with this version code, from an earlier upload " \
    "that went through or one added by hand in the Play Console (for example " \
    "while diagnosing a rejection), and never takes a version code twice, so a " \
    "re-run of this build can never succeed. Let the next merge to main ship a " \
    "new build number.",
  ],
  [
    /Foreground Service permissions/i,
    "The Play Console's Foreground Service declaration needs answering. It is " \
    "reachable only from a release: attach a bundle to a track release, choose " \
    "Preview and confirm, then follow Go to declaration.",
  ],
  [
    /changesNotSentForReview to true/i,
    "Play would not send this release for review automatically, because the Play " \
    "Console already holds changes that must be sent by hand. Open Publishing " \
    "overview in the Play Console, check the pending changes (a release, " \
    "declaration or listing edit), and send them for review. Nothing in this " \
    "edit was committed: if the upload was refused, its version " \
    "code is still free and the job can be re-run once the changes are sent; if " \
    "a copy to open or closed testing was refused, do not re-run, since the " \
    "internal upload already used the version code and the next beta copies " \
    "its own build.",
  ],
].freeze

platform :android do
  desc "Upload AAB to internal testing track"
  lane :upload do
    aab_path = find_aab

    UI.message("Uploading to internal testing track...")
    upload_to_play_with_hint(
      aab: aab_path,
      track: "internal",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )

    UI.success("AAB uploaded to internal testing track!")
  end

  desc "Validate the AAB without uploading"
  lane :validate do
    aab_path = find_aab

    UI.message("Validating AAB...")
    upload_to_play_with_hint(
      aab: aab_path,
      track: "internal",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: true,
    )

    UI.success("AAB validation passed!")
  end

  desc "Upload AAB to the internal testing track, released (every beta)"
  # Every beta lands here first. Internal testing is published without a
  # review wait, so it can take a build per merge; open testing gets a copy
  # through promote_beta only when play_beta_cooldown.py says a review has had
  # time to finish (#2887).
  lane :upload_internal do
    aab_path = find_aab
    changelog_root = write_beta_changelog

    UI.message("Uploading to the '#{INTERNAL_TRACK}' testing track...")
    upload_to_play_with_hint(
      aab: aab_path,
      track: INTERNAL_TRACK,
      release_status: "completed",
      # Passed explicitly, and taken from the helper that just wrote the file, so
      # the directory supply reads is the directory the notes went into. supply's
      # own default is resolved from a different working directory than lane code
      # runs in, which silently cost every Play beta its release notes.
      metadata_path: changelog_root || PLAY_METADATA_ROOT,
      skip_upload_metadata: true,
      # Beta testers need to know what a build changed; the other lanes stay
      # silent because their notes are managed in the Play Console. The copies
      # made by promote_beta and mirror_beta carry these notes along.
      skip_upload_changelogs: changelog_root.nil?,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )

    UI.success("AAB released to the '#{INTERNAL_TRACK}' track!")
  end

  desc "Copy the internal beta onto the beta testing track (PLAY_BETA_TRACK, default beta)"
  # A copy, not a second upload: Play accepts each version code exactly once.
  # Its own lane and workflow step, like mirror_beta, so a retry repeats only
  # the copy, which is idempotent.
  #
  # Each copy is a new release on a reviewed track, and Google counts its
  # review turnaround from the last change submitted, so copying while a
  # review runs sends the app to the back of the queue. beta.yml runs this lane
  # only when play_beta_cooldown.py says the last copy is old enough (#2887).
  lane :promote_beta do |options|
    version_code = version_code_option(options)
    copy_release(INTERNAL_TRACK, beta_track, version_code)
  end

  desc "Copy the beta release onto the closed track too (PLAY_BETA_MIRROR_TRACK, default alpha)"
  # A separate lane, run as a separate workflow step, rather than a second call
  # inside promote_beta: a copy that succeeded followed by a mirror that failed
  # would make a retry of both copy the open release twice. Here, a retry only
  # repeats the mirror, which is idempotent.
  lane :mirror_beta do |options|
    target = mirror_track
    if target.nil?
      UI.message("No mirror track for the '#{beta_track}' beta; nothing to copy.")
      next
    end

    version_code = version_code_option(options)
    copy_release(beta_track, target, version_code)
  end

  desc "Promote a beta build to production, from open testing or else internal testing"
  # With open testing on a cooldown, the build chosen for production is either
  # on open testing, where it soaked, or only on internal testing, as the
  # newest build. It is taken from whichever track holds it, open testing
  # first.
  lane :promote_to_production do |options|
    version_code = options[:version_code] || UI.user_error!("version_code is required")
    rollout = options[:rollout] || "1.0"
    track = production_source_track(version_code)

    UI.message("Promoting build #{version_code} from '#{track}' to production (rollout #{rollout})...")
    upload_to_play_with_hint(
      track: track,
      track_promote_to: "production",
      version_code: version_code,
      rollout: rollout,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )

    UI.success("Build #{version_code} promoted to production!")
  end

  # ============================================================================
  # Helper Methods
  # ============================================================================

  # The Play track carrying beta builds. 'beta' (open testing) since Google
  # granted production access on 2026-09-22. It was 'alpha' (closed testing)
  # before that: open testing is gated behind production access, and running
  # a closed test (12+ testers, 14 days) is what earns it.
  #
  # PLAY_BETA_TRACK still overrides, so a one-off run can target either track
  # without a code change.
  def beta_track
    track = ENV["PLAY_BETA_TRACK"] || "beta"
    unless ["alpha", "beta"].include?(track)
      UI.user_error!(
        "PLAY_BETA_TRACK must be 'alpha' (closed testing) or 'beta' " \
        "(open testing); got '#{track}'."
      )
    end
    track
  end

  # The second track each beta is copied onto, or nil when there is none.
  #
  # Closed testers are eligible for production and their closed track only,
  # never open testing (Play Console help, answer 9845334). With betas on open
  # testing, closed testers would otherwise receive nothing until a stable
  # release reaches production. Mirroring the open beta onto the closed track
  # keeps them current.
  #
  # PLAY_BETA_MIRROR_TRACK overrides the default; an empty value switches the
  # mirror off. A mirror naming the primary track is a no-op rather than an
  # error, so pointing PLAY_BETA_TRACK back at 'alpha' for a one-off run needs
  # no second variable.
  def mirror_track
    configured = ENV["PLAY_BETA_MIRROR_TRACK"]
    track = configured.nil? ? default_mirror_track : configured.strip
    return nil if track.empty? || track == beta_track

    unless ["alpha", "beta"].include?(track)
      UI.user_error!(
        "PLAY_BETA_MIRROR_TRACK must be 'alpha', 'beta' or empty; got '#{track}'. " \
        "Mirroring to production would ship every beta."
      )
    end
    track
  end

  def default_mirror_track
    beta_track == "beta" ? "alpha" : ""
  end

  # The version code to copy, from the lane option or PLAY_VERSION_CODE.
  def version_code_option(options)
    version_code = (options[:version_code] || ENV["PLAY_VERSION_CODE"]).to_s.strip
    UI.user_error!("PLAY_VERSION_CODE is required to choose the build to copy.") if version_code.empty?
    unless version_code.match?(/\A\d+\z/)
      UI.user_error!("PLAY_VERSION_CODE must be digits only; got '#{version_code}'.")
    end
    version_code
  end

  # Copies one build's release from one testing track to another.
  # track_promote_to copies the release, notes included, without taking it off
  # the source track. No rollout: a fraction would stage the copied release.
  def copy_release(source, target, version_code)
    UI.message("Copying build #{version_code} from '#{source}' to '#{target}'...")
    upload_to_play_with_hint(
      track: source,
      track_promote_to: target,
      track_promote_release_status: "completed",
      version_code: version_code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("Build #{version_code} is on both the '#{source}' and '#{target}' tracks.")
  end

  # The testing track holding a build, open testing first, for promotion to
  # production. Fails when neither holds it: Play would refuse the promotion
  # with a less useful message.
  def production_source_track(version_code)
    [beta_track, INTERNAL_TRACK].uniq.each do |track|
      codes = google_play_track_version_codes(track: track).map(&:to_s)
      return track if codes.include?(version_code.to_s)
    end
    UI.user_error!(
      "Build #{version_code} is on neither the '#{beta_track}' nor the " \
      "'#{INTERNAL_TRACK}' track, so there is no release to promote. A newer " \
      "beta replaces the older one on each track; promote a build still on one."
    )
  end

  # Reads the notes the beta pipeline generated.
  #
  # PLAY_BETA_CHANGELOG_FILE (a path) is the pipeline's contract;
  # PLAY_BETA_CHANGELOG (the text) remains for local runs. Passing a path keeps
  # commit-derived text out of shell and environment assignments in a workflow
  # that holds the Play service account key.
  def read_beta_notes
    path = ENV["PLAY_BETA_CHANGELOG_FILE"].to_s.strip
    return ENV["PLAY_BETA_CHANGELOG"].to_s if path.empty?

    unless File.exist?(path)
      UI.important("PLAY_BETA_CHANGELOG_FILE points at #{path}, which does not exist.")
      return ENV["PLAY_BETA_CHANGELOG"].to_s
    end

    File.read(path)
  end

  # Writes the beta release notes where supply expects them:
  # <metadata_root>/<locale>/changelogs/<versionCode>.txt. The file is generated
  # per build rather than committed, so the notes always match the AAB being
  # uploaded. Returns the absolute metadata root so the caller can hand supply
  # the same path, or nil when there is nothing to write, which leaves the
  # existing Play notes untouched instead of blanking them.
  def write_beta_changelog(metadata_root = PLAY_METADATA_ROOT)
    notes = read_beta_notes.strip
    version_code = ENV["PLAY_VERSION_CODE"].to_s.strip

    if notes.empty? || version_code.empty?
      UI.important(
        "PLAY_BETA_CHANGELOG or PLAY_VERSION_CODE is unset; uploading without " \
        "release notes."
      )
      return nil
    end

    unless version_code.match?(/\A\d+\z/)
      UI.user_error!("PLAY_VERSION_CODE must be digits only; got '#{version_code}'.")
    end

    # Google rejects a release-notes body over 500 characters per locale, and
    # rejects the whole upload rather than truncating it.
    if notes.length > PLAY_CHANGELOG_LIMIT
      UI.important(
        "Release notes are #{notes.length} characters; truncating to " \
        "#{PLAY_CHANGELOG_LIMIT} for Play."
      )
    end

    dir = File.join(metadata_root, "en-US", "changelogs")
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "#{version_code}.txt"), notes[0, PLAY_CHANGELOG_LIMIT])
    UI.message("Wrote Play release notes for version code #{version_code} to #{dir}.")
    metadata_root
  end

  # The hint for a Play rejection message, or nil when it is not one we know.
  def play_error_hint(message)
    text = message.to_s
    PLAY_ERROR_HINTS.each { |pattern, hint| return hint if text.match?(pattern) }
    nil
  end

  # Every Play call goes through here. A known rejection adds its hint to the
  # log, and on GitHub Actions to the run summary as an error annotation, then
  # the original error is re-raised unchanged so beta.yml's retry loop and the
  # job's status behave exactly as before.
  #
  # The annotation goes to $stdout directly: a bare `puts` in a Fastfile is
  # fastlane's puts action, which prefixes a timestamp, and GitHub only reads a
  # workflow command at the very start of a line.
  #
  # supply's rescue_changes_not_sent_for_review is forced off for every call
  # that releases a build. Left at its default, a commit Play refuses to send
  # for review is retried with changesNotSentForReview=true and reported as a
  # success, so the release would wait unseen in the Console's Publishing
  # overview for a manual Send while the log read like a release that went
  # out. Off, the refusal fails the run and the hint above says what to send.
  # A draft keeps the rescue: it is never sent for review, and the stable
  # release that uploads one is finished by hand in the Console anyway.
  def upload_to_play_with_hint(params)
    unless params[:release_status] == "draft"
      params = params.merge(rescue_changes_not_sent_for_review: false)
    end
    upload_to_play_store(params)
  rescue StandardError => e
    hint = play_error_hint(e.message)
    if hint
      UI.error(hint)
      $stdout.puts("::error title=Google Play rejected the upload::#{hint}") if ENV["GITHUB_ACTIONS"] == "true"
    end
    raise
  end

  # Finds the AAB file. Checks for the renamed artifact first (CI),
  # then falls back to the default Flutter build output (local).
  def find_aab
    # CI renames artifacts to Submersion-vX.Y.Z-Android.aab in the workspace root
    ci_aab = Dir.glob("../../Submersion-*-Android.aab").first
    if ci_aab
      UI.message("Using CI artifact: #{ci_aab}")
      return File.absolute_path(ci_aab)
    end

    # Local build output
    local_aab = "../../build/app/outputs/bundle/release/app-release.aab"
    if File.exist?(local_aab)
      UI.message("Using local build: #{local_aab}")
      return File.absolute_path(local_aab)
    end

    UI.user_error!(
      "No AAB found. Build with 'flutter build appbundle --release' first, " \
      "or ensure CI has renamed the artifact to Submersion-*-Android.aab."
    )
  end
end
