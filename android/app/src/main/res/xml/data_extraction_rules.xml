<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer on Android 12 and later
  (android:dataExtractionRules). Everything is kept as before, except the
  marine life model pack (species_id/pack/ in the files directory): it is
  large and can be downloaded again. See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="species_id/pack/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="species_id/pack/" />
    </device-transfer>
</data-extraction-rules>
